# Copy to /etc/dcfs/dcfs.env and fill in. Consumed by dcfs.service's
# EnvironmentFile= directive.

# Directory dcfs caches.
SOURCE=/srv/export

# Path to the sqlite cache database (created on first start).
CACHE_DB=/var/lib/dcfs/cache.db

# Where to mount dcfs. May be the same path as SOURCE (mounting over the
# source directory is a supported configuration).
MOUNTPOINT=/mnt/dcfs

# Further dcfs flags, split at whitespace (optional). --allow_other is
# needed for users other than root, and for NFS export.
EXTRA_ARGS=--allow_other
