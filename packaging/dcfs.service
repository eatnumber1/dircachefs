[Unit]
Description=dcfs write-through FUSE metadata cache
After=local-fs.target

[Service]
Type=simple
EnvironmentFile=/etc/dcfs/dcfs.env
# Clears a dead FUSE mount left on MOUNTPOINT by a crash (accessing it then
# fails with ENOTCONN). Needed when mounting over the source directory:
# dcfs would otherwise try to open the dead mount as its source. Only a
# mount point that cannot be accessed is unmounted -- a plain `umount -l`
# would also unmount a healthy filesystem mounted there, such as the
# backing disk itself when MOUNTPOINT is SOURCE. The leading "-" ignores
# failure (nothing to unmount).
ExecStartPre=-/bin/sh -c '[ -e "$$MOUNTPOINT" ] || exec /bin/umount -l "$$MOUNTPOINT"'
# EXTRA_ARGS (optional, in the environment file) is split at whitespace
# into further flags, e.g. --allow_other.
ExecStart=/usr/local/bin/dcfs --source=${SOURCE} --cache_db=${CACHE_DB} --foreground=true $EXTRA_ARGS ${MOUNTPOINT}
Restart=on-failure
KillSignal=SIGTERM
TimeoutStopSec=30
# dcfs needs CAP_DAC_READ_SEARCH (open_by_handle_at, used to reopen cached
# inodes by handle) and CAP_SYS_ADMIN (mounting the FUSE filesystem, and
# FUSE passthrough on the backing files); running as root is the simplest
# way to hold both rather than assembling an equivalent capability set.
User=root

[Install]
WantedBy=multi-user.target
