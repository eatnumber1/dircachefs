# docs/style.md 1.6b: no intentional crashes in production code. A CHECK,
# QCHECK or DCHECK of any form and LOG(FATAL) all construct an
# absl::log_internal::LogMessageFatal (or LogMessageQuietlyFatal) and end the
# process; so do assert, abort, std::terminate, and exit or quick_exit (an
# exit standing in for an error return: a forked child leaves by _exit, which
# this does not match). So does a log line whose severity may be fatal:
# LOG(DFATAL) and DLOG(FATAL) without NDEBUG (kLogDebugFatal, the DebugFatal
# messages), LOG(LEVEL(s)) and ABSL_RAW_LOG with a severity that is not one of
# INFO, WARNING and ERROR (or a choice between them), and ABSL_RAW_CHECK
# (ABSL_RAW_LOG(FATAL)). Production code is every file that is not *_test.cc
# and not under testonly/ (bench/ is production, as in tools/repo_shape.py). A
# site is reported at the macro's expansion point.
let notTest unless(isExpansionInFileMatching("_test[.]cc$|(^|/)testonly/"))
let neverFatal ignoringParenImpCasts(declRefExpr(to(enumConstantDecl(hasAnyName("::absl::LogSeverity::kInfo", "::absl::LogSeverity::kWarning", "::absl::LogSeverity::kError")))))
let neverFatalChoice anyOf(neverFatal, ignoringParenImpCasts(conditionalOperator(hasTrueExpression(neverFatal), hasFalseExpression(neverFatal))))
match cxxConstructExpr(hasDeclaration(cxxConstructorDecl(ofClass(hasAnyName("::absl::log_internal::LogMessageFatal", "::absl::log_internal::LogMessageQuietlyFatal", "::absl::log_internal::LogMessageDebugFatal", "::absl::log_internal::LogMessageQuietlyDebugFatal")))), notTest, isExpansionInFileMatching("(^|/)(dcfs|tools|bench|test/qemu/guest)/")).bind("check_in_production")
match cxxConstructExpr(hasDeclaration(cxxConstructorDecl(ofClass(hasName("::absl::log_internal::LogMessage")))), hasAnyArgument(ignoringParenImpCasts(declRefExpr(to(varDecl(hasName("::absl::kLogDebugFatal")))))), notTest, isExpansionInFileMatching("(^|/)(dcfs|tools|bench|test/qemu/guest)/")).bind("check_in_production")
match varDecl(hasName("absl_log_internal_severity"), hasInitializer(ignoringParenImpCasts(callExpr(hasArgument(0, unless(neverFatalChoice))))), notTest, isExpansionInFileMatching("(^|/)(dcfs|tools|bench|test/qemu/guest)/")).bind("check_in_production")
match callExpr(callee(functionDecl(hasName("::absl::raw_log_internal::RawLog"))), unless(hasArgument(0, neverFatal)), notTest, isExpansionInFileMatching("(^|/)(dcfs|tools|bench|test/qemu/guest)/")).bind("check_in_production")
match stmt(isExpandedFromMacro("assert"), unless(hasParent(stmt(isExpandedFromMacro("assert")))), notTest, isExpansionInFileMatching("(^|/)(dcfs|tools|bench|test/qemu/guest)/")).bind("check_in_production")
match callExpr(callee(functionDecl(hasAnyName("::abort", "::std::abort", "::exit", "::std::exit", "::quick_exit", "::std::quick_exit", "::std::terminate"))), notTest, isExpansionInFileMatching("(^|/)(dcfs|tools|bench|test/qemu/guest)/")).bind("check_in_production")
