# Small guest-only helpers for the QEMU setattr/rename/write tests (see
# //test/qemu:setattr_test / test/qemu/guest/setattr.sh,
# //test/qemu:rename_test / test/qemu/guest/rename.sh, and
# //test/qemu:write_test / test/qemu/guest/write.sh): syscalls busybox's own
# applets can't drive precisely enough or don't expose at all (truncate(2)
# without an intervening open(); nanosecond-precision utimensat(2);
# fchmodat(2) with AT_SYMLINK_NOFOLLOW, which busybox's chmod has no
# equivalent for; renameat2(2) with RENAME_NOREPLACE/RENAME_EXCHANGE; and
# xattr syscalls/fallocate(2), which busybox has no applets for at all;
# forcing a real SQLITE_BUSY out of dcfs's own cache database, which no
# busybox applet can even see the shape of -- see testutil.c's
# "sqlite-lock" subcommand, used by //test/qemu:release_leak_test).
# Statically linked like //dcfs:main_static, for the same reason: the QEMU
# initramfs has no dynamic loader or shared libc. Same --config=asan/
# --config=ubsan select() as //dcfs:main_static and qemu_cc_test.bzl, and
# for the same reason (glibc cannot be fully statically linked with ASan).
cc_binary(
    name = "testutil",
    srcs = ["testutil.c"],
    features = select({
        "//test/qemu:asan_build": [],
        "//test/qemu:ubsan_build": [],
        "//conditions:default": ["fully_static_link"],
    }),
    linkstatic = True,
    visibility = ["//test/qemu:__pkg__"],
    deps = ["@sqlite//:sqlite3"],
)

