load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("//tools:first_party_objects.bzl", "linked_objects")

# File-handle test client (name_to_handle_at / open_by_handle_at /
# FS_IOC_GETVERSION). Used by the QEMU suite (see
# //test/qemu:handles_test / test/qemu/guest/handles.sh), which is where the
# NFS handle tests live -- there never ended up being a separate host-run
# tools/handle_tests.sh; it needs a real dcfs mount, same as smoke_readonly.sh
# below.
cc_binary(
    name = "fhtest",
    srcs = ["fhtest.c"],
    visibility = ["//visibility:public"],
)

# Small guest-only helpers for the QEMU setattr/rename/write tests (see
# //test/qemu:setattr_test / test/qemu/guest/setattr.sh,
# //test/qemu:rename_test / test/qemu/guest/rename.sh, and
# //test/qemu:write_test / test/qemu/guest/write.sh): syscalls busybox's own
# applets can't drive precisely enough or don't expose at all (truncate(2)
# without an intervening open(); nanosecond-precision utimensat(2);
# fchmodat(2) with AT_SYMLINK_NOFOLLOW, which busybox's chmod has no
# equivalent for; renameat2(2) with RENAME_NOREPLACE/RENAME_EXCHANGE; and
# xattr syscalls/fallocate(2), which busybox has no applets for at all;
# forcing a real SQLITE_BUSY out of dcfs's own cache database, which no
# busybox applet can even see the shape of -- see testutil.c's
# "sqlite-lock" subcommand, used by //test/qemu:release_leak_test).
# Statically linked like //dcfs:main_static, for the same reason: the QEMU
# initramfs has no dynamic loader or shared libc. Same --config=asan/
# --config=ubsan select() as //dcfs:main_static and qemu_cc_test.bzl, and
# for the same reason (glibc cannot be fully statically linked with ASan).
cc_binary(
    name = "testutil",
    srcs = ["testutil.c"],
    features = select({
        "//test/qemu:asan_build": [],
        "//test/qemu:ubsan_build": [],
        "//conditions:default": ["fully_static_link"],
    }),
    linkstatic = True,
    visibility = ["//test/qemu:__pkg__"],
    deps = ["@sqlite//:sqlite3"],
)

# Manual, host-run smoke test for the read-only ops added in step 3.2: mounts
# a small tree twice and checks that the second pass is served entirely from
# the cache (verified via strace, when available). Not wired into `bazel
# test` -- it mounts FUSE and needs /dev/fuse, which the sandbox doesn't
# give it; run directly (`bazel run //tools:smoke_readonly -- ...`) or via
# the script path in the worktree instead.
sh_binary(
    name = "smoke_readonly",
    srcs = ["smoke_readonly.sh"],
)

# ---- Step 26.8: banned symbols in the shipped binary --------------------

# Every compiled object linked into //dcfs:main_static, with its origin
# (tools/first_party_objects.bzl), so a banned symbol is attributed to the
# library or the first-party file that references it.
linked_objects(
    name = "main_static_objects",
    binaries = ["//dcfs:main_static"],
)

# Known-bad input for the self-check: references realpath(3).
cc_binary(
    name = "banned_symbols_fixture",
    srcs = ["banned_symbols_fixture.cc"],
)

linked_objects(
    name = "banned_symbols_fixture_objects",
    binaries = [":banned_symbols_fixture"],
)

py_library(
    name = "banned_symbols_lib",
    srcs = ["banned_symbols.py"],
    imports = ["."],
)

# The gate: fails when //dcfs:main_static, or a library it links, references
# a symbol in banned_symbols.txt that no `allow` line covers. $(NM) is the
# host's nm (the C++ toolchain is the host gcc until 7.1 pins llvm).
py_test(
    name = "banned_symbols_test",
    size = "small",
    srcs = ["banned_symbols_test.py"],
    args = [
        "nm=$(NM)",
        "deny_list=$(location banned_symbols.txt)",
        "objects=$(location :main_static_objects)",
        "binary=$(location //dcfs:main_static)",
    ],
    data = [
        "banned_symbols.txt",
        ":main_static_objects",
        "//dcfs:main_static",
    ],
    toolchains = ["@bazel_tools//tools/cpp:current_cc_toolchain"],
    deps = [":banned_symbols_lib"],
)

# Self-check of the gate (26.1): the same checker and the real deny list over
# a binary that calls realpath must fail and name the symbol and its rule,
# and an allow line must silence exactly its origin and symbol.
py_test(
    name = "banned_symbols_self_check_test",
    size = "small",
    srcs = ["banned_symbols_self_check_test.py"],
    args = [
        "nm=$(NM)",
        "deny_list=$(location banned_symbols.txt)",
        "objects=$(location :banned_symbols_fixture_objects)",
        "binary=$(location :banned_symbols_fixture)",
    ],
    data = [
        "banned_symbols.txt",
        ":banned_symbols_fixture",
        ":banned_symbols_fixture_objects",
    ],
    toolchains = ["@bazel_tools//tools/cpp:current_cc_toolchain"],
    deps = [":banned_symbols_lib"],
)
