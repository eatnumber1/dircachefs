load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("//tools:first_party_objects.bzl", "linked_objects")

# File-handle test client (name_to_handle_at / open_by_handle_at /
# FS_IOC_GETVERSION). Used by the QEMU suite (see
# //test/qemu:handles_test / test/qemu/guest/handles.sh), which is where the
# NFS handle tests live -- there never ended up being a separate host-run
# tools/handle_tests.sh; it needs a real dcfs mount, same as smoke_readonly.sh
# below.
cc_binary(
    name = "fhtest",
    srcs = ["fhtest.c"],
    visibility = ["//visibility:public"],
)

# Small guest-only helpers for the QEMU setattr/rename/write tests (see
# //test/qemu:setattr_test / test/qemu/guest/setattr.sh,
# //test/qemu:rename_test / test/qemu/guest/rename.sh, and
# //test/qemu:write_test / test/qemu/guest/write.sh): syscalls busybox's own
# applets can't drive precisely enough or don't expose at all (truncate(2)
# without an intervening open(); nanosecond-precision utimensat(2);
# fchmodat(2) with AT_SYMLINK_NOFOLLOW, which busybox's chmod has no
# equivalent for; renameat2(2) with RENAME_NOREPLACE/RENAME_EXCHANGE; and
# xattr syscalls/fallocate(2), which busybox has no applets for at all;
# forcing a real SQLITE_BUSY out of dcfs's own cache database, which no
# busybox applet can even see the shape of -- see testutil.c's
# "sqlite-lock" subcommand, used by //test/qemu:release_leak_test).
# Statically linked like //dcfs:main_static, for the same reason: the QEMU
# initramfs has no dynamic loader or shared libc. Same --config=asan/
# --config=ubsan select() as //dcfs:main_static and qemu_cc_test.bzl, and
# for the same reason (glibc cannot be fully statically linked with ASan).
cc_binary(
    name = "testutil",
    srcs = ["testutil.c"],
    features = select({
        "//test/qemu:asan_build": [],
        "//test/qemu:ubsan_build": [],
        "//conditions:default": ["fully_static_link"],
    }),
    linkstatic = True,
    visibility = ["//test/qemu:__pkg__"],
    deps = ["@sqlite//:sqlite3"],
)

# Manual, host-run smoke test for the read-only ops added in step 3.2: mounts
# a small tree twice and checks that the second pass is served entirely from
# the cache (verified via strace, when available). Not wired into `bazel
# test` -- it mounts FUSE and needs /dev/fuse, which the sandbox doesn't
# give it; run directly (`bazel run //tools:smoke_readonly -- ...`) or via
# the script path in the worktree instead.
sh_binary(
    name = "smoke_readonly",
    srcs = ["smoke_readonly.sh"],
)

# ---- Step 26.8: banned symbols in the shipped binary --------------------

BANNED_SYMBOLS_COMPATIBLE = select({
    "//test/qemu:asan_build": ["@platforms//:incompatible"],
    "//test/qemu:ubsan_build": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

# Every compiled object linked into //dcfs:main_static, with its origin
# (tools/first_party_objects.bzl), so a banned symbol is attributed to the
# library or the first-party file that references it.
linked_objects(
    name = "main_static_objects",
    binaries = ["//dcfs:main_static"],
)

# Known-bad input for the self-check: references realpath(3).
cc_binary(
    name = "banned_symbols_fixture",
    srcs = ["banned_symbols_fixture.cc"],
)

linked_objects(
    name = "banned_symbols_fixture_objects",
    binaries = [":banned_symbols_fixture"],
)

py_library(
    name = "banned_symbols_lib",
    srcs = ["banned_symbols.py"],
    imports = ["."],
)

# The gate: fails when //dcfs:main_static, or a library it links, references
# a symbol in banned_symbols.txt that no `allow` line covers. The
# pinned clang's llvm-nm (step 7.1), shipped as data.
#
# The allow lines in banned_symbols.txt describe the shipped binary in a
# fastbuild (-O0; a `-c opt` build folds calls differently, e.g. printf to
# puts, so some lines would match nothing). A sanitizer build cannot pass: its
# static runtime defines interceptors named like the banned symbols, -O1 folds
# calls, and the binary is dynamic. The gate is about the shipped unsanitized
# binary, so the two tests are incompatible with --config=asan/ubsan.
py_test(
    name = "banned_symbols_test",
    size = "small",
    srcs = ["banned_symbols_test.py"],
    args = [
        "nm=$(rootpath @llvm_toolchain_llvm//:nm)",
        "deny_list=$(location banned_symbols.txt)",
        "objects=$(location :main_static_objects)",
        "binary=$(location //dcfs:main_static)",
    ],
    data = [
        "banned_symbols.txt",
        ":main_static_objects",
        "//dcfs:main_static",
        "@llvm_toolchain_llvm//:nm",
    ],
    target_compatible_with = BANNED_SYMBOLS_COMPATIBLE,
    deps = [":banned_symbols_lib"],
)

# Self-check of the gate (26.1): the same checker and the real deny list over
# a binary that calls realpath must fail and name the symbol and its rule,
# and an allow line must silence exactly its origin and symbol.
py_test(
    name = "banned_symbols_self_check_test",
    size = "small",
    srcs = ["banned_symbols_self_check_test.py"],
    args = [
        "nm=$(rootpath @llvm_toolchain_llvm//:nm)",
        "deny_list=$(location banned_symbols.txt)",
        "objects=$(location :banned_symbols_fixture_objects)",
        "binary=$(location :banned_symbols_fixture)",
    ],
    data = [
        "banned_symbols.txt",
        ":banned_symbols_fixture",
        ":banned_symbols_fixture_objects",
        "@llvm_toolchain_llvm//:nm",
    ],
    target_compatible_with = BANNED_SYMBOLS_COMPATIBLE,
    deps = [":banned_symbols_lib"],
)

# ---- Step 26.9: the shipped dependency golden ---------------------------

# The external repositories of the shipped binaries, reduced from the same
# genquery the SBOM test reads (//dcfs:linked_deps; tools/sbom/README.md), as
# a list (dcfs/shipped_deps.txt) that only a deliberate edit changes.
py_library(
    name = "shipped_deps_lib",
    srcs = ["shipped_deps.py"],
    imports = ["."],
    deps = ["//tools/sbom:sbom_lib"],
)

py_test(
    name = "shipped_deps_test",
    size = "small",
    srcs = ["shipped_deps_test.py"],
    args = [
        "graph=$(location //dcfs:linked_deps)",
        "golden=$(location //dcfs:shipped_deps.txt)",
    ],
    data = [
        "//dcfs:linked_deps",
        "//dcfs:shipped_deps.txt",
    ],
    deps = [":shipped_deps_lib"],
)

# Self-check of the golden (26.1): a golden with one line removed must fail.
py_test(
    name = "shipped_deps_self_check_test",
    size = "small",
    srcs = ["shipped_deps_self_check_test.py"],
    args = [
        "graph=$(location //dcfs:linked_deps)",
        "golden=$(location //dcfs:shipped_deps.txt)",
    ],
    data = [
        "//dcfs:linked_deps",
        "//dcfs:shipped_deps.txt",
    ],
    deps = [":shipped_deps_lib"],
)

# ---- Step 26.13: repository-shape tests ---------------------------------

py_library(
    name = "repo_shape_lib",
    srcs = ["repo_shape.py"],
    imports = ["."],
)

# Every third_party/<name>/ has a README.md, every guest script is used by a
# qemu_test, every DISABLED_ check is named in README.md's Limitations. It
# walks the real source tree (found through MODULE.bazel's symlink): Bazel
# cannot declare "every directory of third_party" as inputs, so the target is
# `external` (never cached) and is cheap.
py_test(
    name = "repo_shape_test",
    size = "small",
    srcs = ["repo_shape_test.py"],
    args = ["anchor=$(location //:MODULE.bazel)"],
    data = ["//:MODULE.bazel"],
    tags = ["external"],
    deps = [":repo_shape_lib"],
)

# Self-check of the three rules over fixture trees (26.1).
py_test(
    name = "repo_shape_self_check_test",
    size = "small",
    srcs = ["repo_shape_self_check_test.py"],
    deps = [":repo_shape_lib"],
)

# Self-check of .github/ci/commit_subjects.sh (the fourth rule, which needs
# git and therefore runs in CI's fast job) over canned subject lists.
sh_test(
    name = "commit_subjects_test",
    size = "small",
    srcs = ["commit_subjects_test.sh"],
    args = ["$(location //:.github/ci/commit_subjects.sh)"],
    data = ["//:.github/ci/commit_subjects.sh"],
)

# Every syscall goes through dcfs/syscalls.h (docs/style.md 1.5): no raw libc
# call outside dcfs/syscalls.cc in any C++ file. The finder's own unit tests
# are one target; the scan of the tree (dcfs/, dcfs/testonly/, bench/) fails
# on any raw call.
# tools/*.c are C programs run in the guest and are not scanned; a C++ file
# added to tools/ needs a filegroup like the other packages' cxx_sources.
py_test(
    name = "raw_syscalls_finder_test",
    size = "small",
    timeout = "short",
    srcs = ["raw_syscalls_test.py"],
    main = "raw_syscalls_test.py",
)

py_test(
    name = "raw_syscalls_test",
    size = "small",
    timeout = "short",
    srcs = ["raw_syscalls_test.py"],
    args = [
        "--scan",
        "$(location raw_syscalls_names.txt)",
        "$(locations //dcfs:cxx_sources)",
        "$(locations //dcfs/testonly:cxx_sources)",
        "$(locations //bench:cxx_sources)",
    ],
    data = [
        "raw_syscalls_names.txt",
        "//bench:cxx_sources",
        "//dcfs:cxx_sources",
        "//dcfs/testonly:cxx_sources",
    ],
    main = "raw_syscalls_test.py",
)

# Step 7.1: the C++ toolchain is the pinned, hermetic clang (MODULE.bazel,
# third_party/llvm/README.md), not the host's GCC. The genrule records what
# the toolchain's $(CC) is and what it says about itself.
genrule(
    name = "cc_toolchain_info",
    outs = ["cc_toolchain_info.txt"],
    cmd = "echo \"CC=$(CC)\" > $@ && $(CC) --version >> $@ 2>&1",
    toolchains = ["@bazel_tools//tools/cpp:current_cc_toolchain"],
)

sh_test(
    name = "toolchain_test",
    size = "small",
    timeout = "short",
    srcs = ["toolchain_test.sh"],
    args = ["$(location :cc_toolchain_info)"],
    data = [":cc_toolchain_info"],
)

# Self-check of toolchain_test: it must reject a host gcc and a clang of
# another version (tools/toolchain_fixtures/; the version one moves with the pin).
sh_test(
    name = "toolchain_self_check_test",
    size = "small",
    timeout = "short",
    srcs = ["toolchain_self_check_test.sh"],
    args = [
        "$(location :toolchain_test.sh)",
        "tools/toolchain_fixtures",
    ],
    data = [
        "toolchain_test.sh",
    ] + glob(["toolchain_fixtures/*.txt"]),
)
