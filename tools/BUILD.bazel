BANNED_SYMBOLS_COMPATIBLE = select({
    "//test/qemu:asan_build": ["@platforms//:incompatible"],
    "//test/qemu:ubsan_build": ["@platforms//:incompatible"],
    # An instrumented main_static is not the shipped binary, and the profile
    # runtime may bring banned names of its own.
    "//test/qemu:coverage_build": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

# Every compiled object linked into //dcfs:main_static, with its origin
# (tools/first_party_objects.bzl), so a banned symbol is attributed to the
# library or the first-party file that references it.
linked_objects(
    name = "main_static_objects",
    binaries = ["//dcfs:main_static"],
)

# Known-bad input for the self-check: references realpath(3).
