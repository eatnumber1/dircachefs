# Step 7.1: the C++ toolchain is the pinned, hermetic clang (MODULE.bazel,
# third_party/llvm/README.md), not the host's GCC. The genrule records what
# the toolchain's $(CC) is and what it says about itself.
genrule(
    name = "cc_toolchain_info",
    outs = ["cc_toolchain_info.txt"],
    cmd = "echo \"CC=$(CC)\" > $@ && $(CC) --version >> $@ 2>&1",
    toolchains = ["@bazel_tools//tools/cpp:current_cc_toolchain"],
)

sh_test(
    name = "toolchain_test",
    size = "small",
    timeout = "short",
    srcs = ["toolchain_test.sh"],
    args = ["$(location :cc_toolchain_info)"],
    data = [":cc_toolchain_info"],
    target_compatible_with = HOST_ONLY_COMPATIBLE,
)

# Step 7.1b: what the toolchain finds outside the workspace. The genrule asks
# the toolchain's $(CC) where the C library files are, what its include search
# list is, which configuration file it reads, and which shared libraries the
# compiler and the linker load while linking a program (ld.so's
# LD_DEBUG=libs); toolchain_hermetic_test fails on anything of the host's but
# glibc (third_party/llvm/README.md). The probe program lives in a temporary
# directory: a genrule may write only its declared outputs.
genrule(
    name = "cc_toolchain_probe",
    outs = ["cc_toolchain_probe.txt"],
    cmd = """
set +e
tmp=$$(mktemp -d)
{
  echo '== include'
  $(CC) -E -v -x c++ /dev/null 2>&1 |
    sed -n '/#include <...> search starts here:/,/End of search list./p' |
    sed '1d;$$d'
  echo '== files'
  for name in libc.a libm.a crt1.o crti.o crtn.o; do
    echo "$$name=$$($(CC) -print-file-name=$$name || true)"
  done
  echo '== config'
  $(CC) -v -x c++ -fsyntax-only /dev/null 2>&1 |
    sed -n 's/^Configuration file: //p'
  echo '== loaded'
  printf 'int main(void) { return 0; }\\n' > $$tmp/probe.c
  LD_DEBUG=libs $(CC) -fuse-ld=lld -rtlib=compiler-rt $$tmp/probe.c \\
    -o $$tmp/probe.out 2>&1 || true
  echo '== link'
  if [ -x $$tmp/probe.out ]; then echo LINK-OK; fi
  echo '== end'
} > $@
rm -rf $$tmp
""",
    toolchains = ["@bazel_tools//tools/cpp:current_cc_toolchain"],
)

sh_test(
    name = "toolchain_hermetic_test",
    size = "small",
    timeout = "short",
    srcs = ["toolchain_hermetic_test.sh"],
    args = ["$(location :cc_toolchain_probe)"],
    data = [":cc_toolchain_probe"],
)

