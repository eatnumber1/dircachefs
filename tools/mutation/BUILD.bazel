load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

# Steps 26.5 and 26.5d: the mutation tester (README.md). `bazel run
# //tools/mutation:mutate -- generate --out mutants.json`, then `-- run
# --mutants mutants.json --result result.json [--sample N]`. Not a test: it
# starts Bazel on a copy of the tree for every mutant.
exports_files([
    "arid.txt",
    "equivalent.txt",
    "fixture.cc",
    "scope.txt",
])

py_binary(
    name = "mutate",
    srcs = ["mutate.py"],
    data = [
        "arid.txt",
        "equivalent.txt",
        "scope.txt",
    ],
    main = "mutate.py",
    deps = [":mutate_lib"],
)

py_library(
    name = "mutate_lib",
    srcs = [
        "arid.py",
        "mutate.py",
        "operators.py",
    ],
    imports = ["."],
)

py_test(
    name = "mutate_test",
    size = "small",
    timeout = "short",
    srcs = ["mutate_test.py"],
    args = [
        "arid=$(rootpath arid.txt)",
        "equivalent=$(rootpath equivalent.txt)",
    ],
    data = [
        "arid.txt",
        "equivalent.txt",
        "scope.txt",
    ],
    deps = [":mutate_lib"],
)

# The operators and the arid nodes, on the AST of a committed C++ fixture:
# the test runs the pinned clang (the same command line mutate.py builds for
# dcfs/, with no sysroot: the fixture includes nothing) on fixture.cc, so
# the AST is the real thing and nothing is checked in but the source.
py_test(
    name = "operators_test",
    size = "small",
    timeout = "short",
    srcs = ["operators_test.py"],
    args = [
        "clang_files=$(rootpaths @dcfs_llvm//:clang)",
        "fixture=$(rootpath fixture.cc)",
        "arid=$(rootpath arid.txt)",
    ],
    data = [
        "arid.txt",
        "fixture.cc",
        "@dcfs_llvm//:clang",
    ],
    deps = [":mutate_lib"],
)
