load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("//third_party/tlaplus:tlc.bzl", "tlc_test")

# Steps 26.5 and 26.5d: the mutation tester (README.md). `bazel run
# //tools/mutation:mutate -- generate --out mutants.json`, then `-- run
# --mutants mutants.json --result result.json [--sample N]`. Not a test: it
# starts Bazel on a copy of the tree for every mutant.
exports_files([
    "arid.txt",
    "equivalent.txt",
    "fixture.cc",
    "fixture_macros.h",
    "scope.txt",
    "tla_arid.txt",
    "tla_scope.txt",
    "tla_sets.txt",
    "testdata/tiny.cfg",
    "testdata/tiny.tla",
])

py_binary(
    name = "mutate",
    srcs = ["mutate.py"],
    data = [
        "arid.txt",
        "equivalent.txt",
        "scope.txt",
        "tla_arid.txt",
        "tla_scope.txt",
        "tla_sets.txt",
    ],
    main = "mutate.py",
    deps = [":mutate_lib"],
)

py_library(
    name = "mutate_lib",
    srcs = [
        "arid.py",
        "mutate.py",
        "operators.py",
        "tla_operators.py",
    ],
    imports = ["."],
)

py_test(
    name = "mutate_test",
    size = "small",
    timeout = "short",
    srcs = ["mutate_test.py"],
    args = [
        "arid=$(rootpath arid.txt)",
        "equivalent=$(rootpath equivalent.txt)",
    ],
    data = [
        "arid.txt",
        "equivalent.txt",
        "scope.txt",
    ],
    deps = [":mutate_lib"],
)

# The operators and the arid nodes, on the AST of a committed C++ fixture:
# the test runs the pinned clang (the same command line mutate.py builds for
# dcfs/, with no sysroot: the fixture includes nothing) on fixture.cc, so
# the AST is the real thing and nothing is checked in but the source.
# The fixture is test-only input of operators_test: C++ that is never built
# or linked, only parsed.
filegroup(
    name = "operators_fixture",
    testonly = True,
    srcs = [
        "fixture.cc",
        "fixture_macros.h",
    ],
)

py_test(
    name = "operators_test",
    size = "small",
    timeout = "short",
    srcs = ["operators_test.py"],
    args = [
        "clang_files=$(rootpaths @dcfs_llvm//:clang)",
        "fixture=$(rootpath fixture.cc)",
        "arid=$(rootpath arid.txt)",
    ],
    data = [
        "arid.txt",
        "fixture.cc",
        ":operators_fixture",
        "@dcfs_llvm//:clang",
    ],
    deps = [":mutate_lib"],
)

# Step 12.13: the TLA+ operators, on constructs copied from formal/dcfs.tla
# (testdata/snippets.tla) and on the real model.
py_test(
    name = "tla_operators_test",
    size = "small",
    timeout = "short",
    srcs = ["tla_operators_test.py"],
    args = [
        "snippets=$(rootpath testdata/snippets.tla)",
        "dcfs=$(rootpath //formal:dcfs.tla)",
        "arid=$(rootpath tla_arid.txt)",
        "sets=$(rootpath tla_sets.txt)",
    ],
    data = [
        "tla_arid.txt",
        "tla_sets.txt",
        "testdata/snippets.tla",
        "//formal:dcfs.tla",
    ],
    deps = [":mutate_lib"],
)

# The tiny module of the end-to-end test of the TLA+ mode: a counter whose
# invariant bounds it. Checked here on its own (it must pass unmutated: the
# fake bazel of mutate_tla_test runs the same TLC on mutated copies).
tlc_test(
    name = "tiny_test",
    size = "small",
    timeout = "short",
    config = "testdata/tiny.cfg",
    spec = "testdata/tiny.tla",
)

py_test(
    name = "mutate_tla_test",
    size = "small",
    timeout = "short",
    srcs = ["mutate_tla_test.py"],
    args = [
        "scope=$(rootpath tla_scope.txt)",
        "arid=$(rootpath tla_arid.txt)",
        "sets=$(rootpath tla_sets.txt)",
        "tiny=$(rootpath testdata/tiny.tla)",
        "tiny_cfg=$(rootpath testdata/tiny.cfg)",
        "java_files=$(rootpaths @remotejdk21_linux//:jdk)",
        "jar=$(rootpath @tla2tools//file)",
        "e2e=none",
    ],
    data = [
        "tla_arid.txt",
        "tla_scope.txt",
        "tla_sets.txt",
        "testdata/tiny.cfg",
        "testdata/tiny.tla",
        "@remotejdk21_linux//:jdk",
        "@tla2tools//file",
    ],
    deps = [":mutate_lib"],
)

# The same file's real-TLC end-to-end class: a killed, a surviving and an
# invalid mutant of testdata/tiny.tla, one JVM and TLC run each.
py_test(
    name = "mutate_tla_e2e_test",
    size = "medium",
    timeout = "moderate",
    srcs = ["mutate_tla_test.py"],
    main = "mutate_tla_test.py",
    args = [
        "scope=$(rootpath tla_scope.txt)",
        "arid=$(rootpath tla_arid.txt)",
        "sets=$(rootpath tla_sets.txt)",
        "tiny=$(rootpath testdata/tiny.tla)",
        "tiny_cfg=$(rootpath testdata/tiny.cfg)",
        "java_files=$(rootpaths @remotejdk21_linux//:jdk)",
        "jar=$(rootpath @tla2tools//file)",
        "e2e=only",
    ],
    data = [
        "tla_arid.txt",
        "tla_scope.txt",
        "tla_sets.txt",
        "testdata/tiny.cfg",
        "testdata/tiny.tla",
        "@remotejdk21_linux//:jdk",
        "@tla2tools//file",
    ],
    deps = [":mutate_lib"],
)
