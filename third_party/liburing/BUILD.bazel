cc_library(
    name = "arch_headers",
    hdrs = (
      select({
          "@platforms//cpu:aarch64": glob(["src/src/arch/aarch64/**/*.h"]),
          "@platforms//cpu:x86_64": glob(["src/src/arch/x86/**/*.h"]),
          "//conditions:default": glob(["src/src/arch/generic/**/*.h"]),
      }) +
      ["src/src/arch/syscall-defs.h"]
    ),
    strip_include_prefix = "src/src",
)

cc_library(
  name = "uring",
  hdrs = glob([
    "src/src/include/**/*.h",
  ]),
  srcs = glob(
    include = [
      "src/src/*.c",
      "src/src/*.h",
    ],
    exclude = ["src/src/nolibc.c"],
  ),
  strip_include_prefix = "src/src/include",
  deps = [
    ":arch_headers",
    ":compat_header",
  ],
  local_defines = [
    "LIBURING_INTERNAL",
  ],
  defines = [
    "_GNU_SOURCE",
  ],
  visibility = ["//visibility:public"],
)

cc_library(
  name = "compat_header",
  hdrs = [":gen_compat_header"],
  strip_include_prefix = "src/include",
)

genrule(
  name = "gen_compat_header",
  srcs = [],
  tools = ["src/configure"],
  outs = ["src/include/liburing/compat.h"],
  cmd = "mkdir -p src/include/liburing && ./$(location src/configure) && mv src/include/liburing/compat.h $(OUTS)",
)
