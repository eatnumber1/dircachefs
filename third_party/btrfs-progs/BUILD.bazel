load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//third_party:exec_file.bzl", "exec_file")

# Pinned, Bazel-built, static mkfs.btrfs and btrfs (docs/plan/review-fixes.md,
# R3/L5). See README.md; BUILD.btrfs_progs is the configure_make overlay
# placed into the fetched source tree (MODULE.bazel).
exports_files(["BUILD.btrfs_progs"])

# See third_party/e2fsprogs/BUILD.bazel for why these are filegroups over an
# output group.
filegroup(
    name = "_mkfs_btrfs_raw",
    srcs = ["@btrfs_progs_src//:btrfs_progs"],
    output_group = "mkfs.btrfs",
)

exec_file(
    name = "mkfs_btrfs",
    src = ":_mkfs_btrfs_raw",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "_btrfs_raw",
    srcs = ["@btrfs_progs_src//:btrfs_progs"],
    output_group = "btrfs",
)

exec_file(
    name = "btrfs",
    src = ":_btrfs_raw",
    visibility = ["//visibility:public"],
)

# Test first: before the targets above existed this failed with "missing
# input file '//third_party/btrfs-progs:mkfs_btrfs'". Checks: static, no
# sanitizer runtime (also under --config=asan/ubsan), the pinned version,
# and that mkfs.btrfs makes a filesystem.
sh_test(
    name = "smoke_test",
    size = "small",
    srcs = ["smoke_test.sh"],
    args = [
        "$(location :mkfs_btrfs)",
        "$(location :btrfs)",
        "7.1",
    ],
    data = [
        ":btrfs",
        ":mkfs_btrfs",
    ],
)
