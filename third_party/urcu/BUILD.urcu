# BUILD file for @userspace_rcu_src (see MODULE.bazel and third_party/
# xfsprogs/README.md): a private, static liburcu, used only to link
# xfsprogs (libxfs uses RCU for its buffer and AG caches; configure
# requires <urcu.h> and links -lurcu).

load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")

filegroup(
    name = "all_srcs",
    srcs = glob(["**"], exclude = ["bazel-*"]),
)

configure_make(
    name = "urcu",
    lib_source = ":all_srcs",
    configure_command = "configure",
    configure_options = [
        "--disable-shared",
        "--enable-static",
    ],
    # Everything liburcu's static build produces that -lurcu or its
    # pkg-config closure can name (liburcu.a is the "memb" flavour xfsprogs
    # uses; it needs -lurcu-common).
    out_static_libs = [
        "liburcu.a",
        "liburcu-common.a",
    ],
    # See third_party/util_linux/BUILD.util_linux for why these three.
    env = {
        "PKG_CONFIG_LIBDIR": "/nonexistent",
        "CFLAGS": "-Wno-error -g -O2 -fno-sanitize=address,undefined",
        # configure insists on a C++11 compiler (AX_CXX_COMPILE_STDCXX is
        # mandatory, for liburcu's own C++ tests) though nothing built here
        # is C++. Its probe program warns, and the project-wide
        # `build --cxxopt`s leak a -Werror into CXXFLAGS the same way
        # --copt -Werror leaks into CFLAGS: the probe "does not support
        # C++11" until -Wno-error follows it.
        "CXXFLAGS": "-Wno-error -fno-sanitize=address,undefined",
        "LDFLAGS": "-fno-sanitize=address,undefined",
    },
    visibility = ["//visibility:public"],
)
