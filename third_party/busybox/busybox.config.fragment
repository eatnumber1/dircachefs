# Checked-in Kconfig fragment for the pinned busybox build (see README.md).
# Applied on top of `make allnoconfig` (every applet/feature off), then
# resolved with `make silentoldconfig` (third_party/busybox/BUILD.bazel's
# genrule does both). This is the busybox-recommended way to build a
# custom minimal config (see busybox's own scripts/kconfig/Makefile
# header comment: "make allnoconfig; sed -i ... .config; make") --
# KCONFIG_ALLCONFIG does *not* work for this purpose in this busybox
# version: `conf -n` (allnoconfig) unconditionally forces every symbol to
# "no" in a second pass regardless of what KCONFIG_ALLCONFIG preloaded
# (confirmed experimentally while building this: a KCONFIG_ALLCONFIG file
# setting CONFIG_MOUNTPOINT=y had no effect on the resulting .config).
#
# One applet (or applet feature) per line, one blank-line-separated group
# per guest script that uses it; grep test/qemu/guest/*.sh and guest/init
# for exactly these commands before adding or removing anything here.

# Multi-call driver itself, and `busybox --install -s` (guest/init uses
# this to populate /bin with a symlink per applet).
CONFIG_BUSYBOX=y
CONFIG_FEATURE_INSTALLER=y
CONFIG_INSTALL_APPLET_SYMLINKS=y

# The one shell every guest script (including guest/init) runs under.
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y

# guest/init: mkdir, mount, mount -t tmpfs/proc/sysfs/devtmpfs, --install,
# mdev -s (populates remaining /dev nodes), echo, uname, sleep, reboot -f,
# sync, cd, export (ash builtins), sed (dcfs_test=/dcfs_rootfs= kernel
# cmdline parsing), chroot + bind-mount dance for the Debian NFS-test
# rootfs, cp -a, mv, find (ld.so/library closure copy for ASan/UBSan
# builds), ip link set lo up, cat (ld.so wrapper script generation via a
# heredoc).
CONFIG_MKDIR=y
CONFIG_MOUNT=y
CONFIG_FEATURE_MOUNT_HELPERS=y
CONFIG_MDEV=y
CONFIG_ECHO=y
CONFIG_UNAME=y
CONFIG_SLEEP=y
CONFIG_REBOOT=y
CONFIG_SYNC=y
CONFIG_SED=y
CONFIG_CHROOT=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_FIND=y
CONFIG_FEATURE_FIND_EXEC=y
CONFIG_IP=y
CONFIG_FEATURE_IP_LINK=y
CONFIG_CAT=y

# guest/lib.sh and the guest/*.sh test scripts: mountpoint (also
# explicitly called out by the plan -- not provided reliably/at all by
# every host busybox package); find -exec (used as find's -ls
# replacement -- busybox's find has never implemented -ls at all, in any
# released version; see README.md's "find -ls" section -- this is not a
# missing-config gap); stat, chmod, chown, truncate, sort, rm, ln, wc,
# mknod, dd, readlink, awk, tr, head, tail, cut, date, kill, umount,
# test, grep, basename, dirname, printf, which, id, free, uniq, timeout,
# fallocate, more, ls, touch, true, false, dmesg (guest/nfs.sh's failure
# diagnostics only).
CONFIG_MOUNTPOINT=y
CONFIG_DMESG=y
CONFIG_STAT=y
CONFIG_CHMOD=y
CONFIG_CHOWN=y
CONFIG_TRUNCATE=y
CONFIG_SORT=y
CONFIG_RM=y
CONFIG_LN=y
CONFIG_WC=y
CONFIG_MKNOD=y
CONFIG_DD=y
CONFIG_READLINK=y
CONFIG_AWK=y
CONFIG_TR=y
CONFIG_HEAD=y
CONFIG_TAIL=y
CONFIG_CUT=y
CONFIG_DATE=y
CONFIG_KILL=y
CONFIG_UMOUNT=y
CONFIG_TEST=y
CONFIG_GREP=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_PRINTF=y
CONFIG_WHICH=y
CONFIG_ID=y
CONFIG_FREE=y
CONFIG_UNIQ=y
CONFIG_TIMEOUT=y
CONFIG_FALLOCATE=y
CONFIG_MORE=y
CONFIG_LS=y
CONFIG_TOUCH=y
CONFIG_TRUE=y
CONFIG_FALSE=y

# ash's own interactive-shell "pwd" when a script calls it as a plain
# command rather than relying on the builtin.
CONFIG_PWD=y

# Build-time: fully static (no dynamic loader needed in the initramfs;
# same reasoning as dcfs's own binaries -- see dcfs/BUILD.bazel's
# fully_static_link feature).
CONFIG_STATIC=y

# Also turned off explicitly (rather than just relying on allnoconfig's
# baseline), because they are exactly the kind of "big beyond that"
# functionality the plan calls out to avoid: no init system (CONFIG_INIT
# and friends -- guest/init is dcfs's own /init script, not busybox's),
# no network servers (httpd/tftpd/udhcpd/telnetd/ftpd), no login/getty,
# no editors (vi), no package-manager-style tools, no syslog daemons.
# allnoconfig already turns every one of these off; nothing here
# re-enables any of them.
