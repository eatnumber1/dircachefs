# Checked-in Kconfig fragment for the pinned busybox build (see README.md).
# Applied on top of `make allnoconfig` (every applet/feature off), then
# resolved with `make silentoldconfig` (third_party/busybox/BUILD.bazel's
# genrule does both). This is the busybox-recommended way to build a
# custom minimal config (see busybox's own scripts/kconfig/Makefile
# header comment: "make allnoconfig; sed -i ... .config; make") --
# KCONFIG_ALLCONFIG does *not* work for this purpose in this busybox
# version: `conf -n` (allnoconfig) unconditionally forces every symbol to
# "no" in a second pass regardless of what KCONFIG_ALLCONFIG preloaded
# (confirmed experimentally while building this: a KCONFIG_ALLCONFIG file
# setting CONFIG_MOUNTPOINT=y had no effect on the resulting .config).
#
# One applet (or applet feature) per line, one blank-line-separated group
# per guest script that uses it; grep test/qemu/guest/*.sh and guest/init
# for exactly these commands before adding or removing anything here.

# Multi-call driver itself, and `busybox --install -s` (guest/init uses
# this to populate /bin with a symlink per applet).
CONFIG_BUSYBOX=y
CONFIG_FEATURE_INSTALLER=y
CONFIG_INSTALL_APPLET_SYMLINKS=y

# The one shell every guest script (including guest/init) runs under.
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
# Step 4.4 (wiring this busybox into test/qemu/): ash's own $((...))
# arithmetic expansion -- used throughout guest/lib.sh and guest/*.sh
# (e.g. "$((i + 1))") -- is a separate feature (shell/Config.src's
# "FEATURE_SH_MATH", default y but, like every other "default y" symbol,
# off under allnoconfig unless named here); without it every "$((...))"
# fails with "syntax error: support for $((arith)) is disabled" (confirmed:
# this is what every qemu test did before this line was added).
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_MATH_64=y
# setattr.sh's verify_tree_cached() runs "command diff ..." (the `command`
# builtin, to bypass any shell function of the same name) -- a regular
# builtin gated by its own ASH_CMDCMD symbol, default y but, like every
# other ash option above, off under allnoconfig unless named here; without
# it, "command: not found".
CONFIG_ASH_CMDCMD=y

# guest/init: mkdir, mount, mount -t tmpfs/proc/sysfs/devtmpfs, --install,
# mdev -s (populates remaining /dev nodes), echo, uname, sleep, reboot -f,
# sync, cd, export (ash builtins), sed (dcfs_test=/dcfs_rootfs= kernel
# cmdline parsing), chroot + bind-mount dance for the Debian NFS-test
# rootfs, cp -a, mv, find (ld.so/library closure copy for ASan/UBSan
# builds), ip link set lo up, cat (ld.so wrapper script generation via a
# heredoc).
CONFIG_MKDIR=y
CONFIG_MOUNT=y
CONFIG_FEATURE_MOUNT_HELPERS=y
# mount -o bind/rbind/remount/noatime/ro/--make-private style flags (init's
# bind mounts for the Debian chroot, tests' remounts): without
# FEATURE_MOUNT_FLAGS the option table holds only ro/rw/remount and
# `mount -o bind` works only because busybox autodetects a directory source
# as a bind mount (review L2); rbind, noatime and friends silently fail.
CONFIG_FEATURE_MOUNT_FLAGS=y
CONFIG_MDEV=y
CONFIG_ECHO=y
CONFIG_UNAME=y
CONFIG_SLEEP=y
# guest/init's finish() calls "sleep 0.2" (drains the serial console before
# the reboot -f that follows yanks it away -- see finish()'s comment);
# plain CONFIG_SLEEP only accepts one integer argument, so a fractional
# argument fails with "invalid number" unless FEATURE_FANCY_SLEEP is also
# on -- and even with that, a fractional argument specifically (as opposed
# to multiple-argument/suffix forms like "1d 2h") needs the further,
# separate CONFIG_FLOAT_DURATION (libbb/duration.c's "config
# FLOAT_DURATION" / "Enable fractional duration arguments"). Confirmed:
# this is what it did before these two lines were added.
CONFIG_FEATURE_FANCY_SLEEP=y
CONFIG_FLOAT_DURATION=y
CONFIG_REBOOT=y
CONFIG_SYNC=y
CONFIG_SED=y
CONFIG_CHROOT=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_FIND=y
CONFIG_FEATURE_FIND_EXEC=y
# find -path (create.sh/rename.sh/write.sh's find+stat tree normalization),
# -type (readdir_boundary.sh), -mindepth/-maxdepth (readdir_boundary.sh),
# \( ... \) grouping and -prune (create.sh/rename.sh's "\( -path d -o
# -path d2 \) -prune -o -exec ..." boundary-fixture exclusion) are each
# their own feature, off by default for the same
# depends-on-FIND-at-allnoconfig-time reason as every other "default y"
# gap in this file; without them, "find: unrecognized: -path"/"-type"/
# "-mindepth"/")".
CONFIG_FEATURE_FIND_PATH=y
CONFIG_FEATURE_FIND_TYPE=y
CONFIG_FEATURE_FIND_MAXDEPTH=y
CONFIG_FEATURE_FIND_PAREN=y
CONFIG_FEATURE_FIND_PRUNE=y
CONFIG_IP=y
CONFIG_FEATURE_IP_LINK=y
CONFIG_CAT=y

# guest/lib.sh and the guest/*.sh test scripts: mountpoint (also
# explicitly called out by the plan -- not provided reliably/at all by
# every host busybox package); find -exec (used as find's -ls
# replacement -- busybox's find has never implemented -ls at all, in any
# released version; see README.md's "find -ls" section -- this is not a
# missing-config gap); stat, chmod, chown, truncate, sort, rm, ln, wc,
# mknod, dd, readlink, awk, tr, head, tail, cut, date, kill, umount,
# test, grep, basename, dirname, printf, which, id, free, uniq, timeout,
# fallocate, more, ls, touch, true, false, dmesg (guest/nfs.sh's failure
# diagnostics only), md5sum (content-comparison checks in passthrough.sh,
# write.sh, nfs.sh, create.sh, readonly.sh, lifecycle.sh,
# cache_permissions.sh -- step 4.4 found this one the hard way too: with
# md5sum missing, "$(md5sum a)" = "$(md5sum b)" compares two empty
# strings and silently passes regardless of actual content, rather than
# failing with "not found" the way a test harness bug usually announces
# itself).
CONFIG_MOUNTPOINT=y
CONFIG_MD5SUM=y
CONFIG_DMESG=y
# stat's own -c (custom format, e.g. "stat -c %u:%g") and -f (filesystem
# status, used by guest/lib.sh's backing_fstype: "stat -f -c %t") are each
# a separate feature from plain CONFIG_STAT -- the same "default y under
# a depends-on that's off at allnoconfig time" gap as FEATURE_FANCY_SLEEP/
# FLOAT_DURATION above. Without them: "stat: invalid option -- 'c'" /
# "-- 'f'" (confirmed: this is what every "stat -c"/"stat -f" in
# guest/*.sh did before these two lines were added).
CONFIG_STAT=y
CONFIG_FEATURE_STAT_FORMAT=y
CONFIG_FEATURE_STAT_FILESYSTEM=y
CONFIG_CHMOD=y
CONFIG_CHOWN=y
# chgrp (credentials.sh), rmdir (plain rmdir, not rm -r: removed.sh,
# rename.sh, crash.sh), cmp and diff (byte-for-byte/tree-diff checks in
# rename.sh, write.sh, readdir_boundary.sh) are applets of their own, not
# enabled by any of the above; without them, "chgrp: not found" / "rmdir:
# not found" / "cmp: not found" / "diff: not found".
CONFIG_CHGRP=y
CONFIG_RMDIR=y
CONFIG_CMP=y
CONFIG_DIFF=y
CONFIG_MKFIFO=y
CONFIG_TRUNCATE=y
CONFIG_SORT=y
CONFIG_RM=y
CONFIG_LN=y
CONFIG_WC=y
CONFIG_MKNOD=y
CONFIG_DD=y
# dd's ibs/obs/iflag/oflag/conv= options (write.sh's "conv=notrunc" and
# "conv=fsync") are the single FEATURE_DD_IBS_OBS feature; without it,
# plain dd accepts only if/of/bs/count and any conv= makes it exit 1 with
# no message at all (confirmed: this is what it did before this line was
# added -- no "unrecognized option" text to grep for, just rc=1).
CONFIG_FEATURE_DD_IBS_OBS=y
CONFIG_READLINK=y
CONFIG_AWK=y
CONFIG_TR=y
CONFIG_HEAD=y
# head -c (write.sh's byte-limited reads) and -n (every other "head -n 1"
# use) are both under FEATURE_FANCY_HEAD; without it, only bare "head"
# with no options works and "head: invalid option -- 'c'"/"-- 'n'".
CONFIG_FEATURE_FANCY_HEAD=y
CONFIG_TAIL=y
# tail -1 (pjdfstest's misc.sh pipes every expect() through it; without this
# only bare "tail" works: "tail: invalid option -- '1'", the pjdfstest suite
# then fails ~97% of its checks identically on the raw filesystem and
# through dcfs, and passes) and tail -n/-c/-f are under FEATURE_FANCY_TAIL.
CONFIG_FEATURE_FANCY_TAIL=y
CONFIG_CUT=y
CONFIG_DATE=y
CONFIG_KILL=y
CONFIG_UMOUNT=y
CONFIG_TEST=y
# Step 4.4 (wiring this busybox into test/qemu/): CONFIG_TEST only builds
# the "test" applet itself. "[" (as in "if [ -f /test/run ]; then", used
# throughout guest/init and every guest/*.sh script) is a *separate*
# Kconfig symbol (coreutils/test.c: "config TEST1 / bool \"test as [\""),
# off by default under allnoconfig; without it every "[" in a guest script
# fails with "[: not found" (confirmed: this is what every qemu test did
# before this line was added).
CONFIG_TEST1=y
CONFIG_GREP=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_PRINTF=y
CONFIG_WHICH=y
CONFIG_ID=y
CONFIG_FREE=y
CONFIG_UNIQ=y
CONFIG_TIMEOUT=y
CONFIG_FALLOCATE=y
CONFIG_MORE=y
CONFIG_LS=y
# ls -R (removed.sh's recursive listing check). FEATURE_LS_SORTFILES is
# more fundamental than its name suggests: without it, busybox's ls.c
# never calls qsort() at all (sort_and_display_files()/dnsort() become
# no-ops -- see ls.c), so plain "ls" lists entries in raw directory
# order, not alphabetical -- every "$(ls "$dir" | tr '\n' ' ')" = "a b c "
# equality check across guest/*.sh (power.sh's warm_check, among others)
# depends on this.
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_FEATURE_LS_RECURSIVE=y
CONFIG_TOUCH=y
# touch -d (crash.sh/write.sh set an explicit mtime) needs the SUSv3
# feature set (-a/-d/-m/-t/-r); without it, plain touch only takes a
# filename and "touch: invalid option -- 'd'".
CONFIG_FEATURE_TOUCH_SUSV3=y
CONFIG_TRUE=y
CONFIG_FALSE=y

# ash's own interactive-shell "pwd" when a script calls it as a plain
# command rather than relying on the builtin.
CONFIG_PWD=y

# Build-time: fully static (no dynamic loader needed in the initramfs;
# same reasoning as dcfs's own binaries -- see dcfs/BUILD.bazel's
# fully_static_link feature).
CONFIG_STATIC=y

# Also turned off explicitly (rather than just relying on allnoconfig's
# baseline), because they are exactly the kind of "big beyond that"
# functionality the plan calls out to avoid: no init system (CONFIG_INIT
# and friends -- guest/init is dcfs's own /init script, not busybox's),
# no network servers (httpd/tftpd/udhcpd/telnetd/ftpd), no login/getty,
# no editors (vi), no package-manager-style tools, no syslog daemons.
# allnoconfig already turns every one of these off; nothing here
# re-enables any of them.
