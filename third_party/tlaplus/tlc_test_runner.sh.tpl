#!/bin/bash
# Generated by //third_party/tlaplus:tlc.bzl (tlc_test). Runs TLC on one
# specification and checks its outcome against the expected one.
set -euo pipefail

java="$PWD/@@JAVA@@"
jar="$PWD/@@JAR@@"
spec="@@SPEC@@"
config="@@CONFIG@@"
expect="@@EXPECT@@"

# TLC reads every module from one directory and writes its state files and
# trace-explorer specs next to them: work in a scratch copy.
work="${TEST_TMPDIR:?}/tlc"
rm -rf "$work"
mkdir -p "$work"
for f in "$spec" "$config" @@SRCS@@; do
  base="$(basename "$f")"
  if [[ -e "$work/$base" ]]; then
    echo "tlc_test: two inputs share the basename $base" >&2
    exit 1
  fi
  cp "$f" "$work/$base"
done
cd "$work"

# TLC writes temporary files (TLC.tla, ...) under java.io.tmpdir: keep them
# in the test's own directory, since tests run concurrently and /tmp is shared.
mkdir -p "$TEST_TMPDIR/tmp"
export TMPDIR="$TEST_TMPDIR/tmp"

module="$(basename "$spec" .tla)"
log="$work/tlc.log"
status=0
# -workers: the test's `workers` attribute (auto: as many workers as
# cores). -cleanup: drop state files of earlier runs. -metadir: keep state
# files out of the inputs' directory.
"$java" -XX:+UseParallelGC -Xss4m \
  -Djava.io.tmpdir="$TEST_TMPDIR/tmp" -jar "$jar" \
  -workers @@WORKERS@@ -cleanup -metadir "$work/states" \
  -config "$(basename "$config")" @@TLC_ARGS@@ "$module" \
  >"$log" 2>&1 || status=$?
cat "$log"
echo "tlc_test: TLC exited with status $status"

if [[ -z "$expect" ]]; then
  if [[ "$status" -ne 0 ]] || ! grep -q "Model checking completed. No error has been found." "$log"; then
    echo "tlc_test: FAIL: expected TLC to find no error" >&2
    exit 1
  fi
  echo "tlc_test: PASS: no error found"
  exit 0
fi

# Expected violation. TLC's exit status distinguishes a violation of a
# safety property (12: an invariant or an action property) or of a
# liveness property (13) from errors in the specification or the
# configuration (75 and up), which must never count as the expected
# outcome.
if [[ "$status" -ne 12 && "$status" -ne 13 ]]; then
  echo "tlc_test: FAIL: expected TLC to report a violation (exit status 12 or 13), got $status" >&2
  exit 1
fi
if ! grep -qF -- "$expect" "$log"; then
  echo "tlc_test: FAIL: TLC reported a violation, but not the expected one: $expect" >&2
  exit 1
fi
echo "tlc_test: PASS: found the expected violation: $expect"
