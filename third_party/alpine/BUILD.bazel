load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

# The Alpine keys (alpine-keys 2.6-r0, cross-checked against aports; see
# README.md), the verifier and the repository rules' script.
exports_files(
    ["apk.py"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "keys",
    srcs = glob(["keys/*.rsa.pub"]),
    visibility = ["//visibility:public"],
)

py_library(
    name = "apk",
    srcs = ["apk.py"],
    imports = ["."],
)

# A tampered index and a tampered apk are refused, a package missing from the
# branch fails with a clear message, and a real signed package verifies
# against the checked-in keys. Host-side: it needs neither root nor a kernel.
py_test(
    name = "signature_test",
    size = "small",
    srcs = ["signature_test.py"],
    args = [
        "$(location testdata/busybox-binsh-1.37.0-r31.apk)",
        "$(locations :keys)",
    ],
    data = [
        "testdata/busybox-binsh-1.37.0-r31.apk",
        ":keys",
    ],
    main = "signature_test.py",
    deps = [":apk"],
)

# The Alpine host tools run on this glibc host through musl's loader: QEMU
# (with KVM), mke2fs and debugfs, mkfs.xfs, mkfs.btrfs and busybox.
sh_test(
    name = "tools_test",
    size = "small",
    srcs = ["tools_test.sh"],
    args = [
        "$(location @alpine_qemu//:qemu_system_x86_64)",
        "$(location @alpine_fstools//:mke2fs)",
        "$(location @alpine_fstools//:debugfs)",
        "$(location @alpine_fstools//:mkfs_xfs)",
        "$(location @alpine_fstools//:mkfs_btrfs)",
        "$(location @alpine_busybox//:root/bin/busybox.static)",
        "$(location //third_party/e2fsprogs:mke2fs.conf)",
    ],
    data = [
        "//third_party/e2fsprogs:mke2fs.conf",
        "@alpine_busybox//:root/bin/busybox.static",
        "@alpine_fstools//:debugfs",
        "@alpine_fstools//:mke2fs",
        "@alpine_fstools//:mkfs_btrfs",
        "@alpine_fstools//:mkfs_xfs",
        "@alpine_qemu//:qemu_system_x86_64",
    ],
    tags = [
        "no-sandbox",
        "requires-kvm",
    ],
)

# The guest's busybox is Alpine's busybox-static: statically linked, every
# applet the guest scripts use, and the features they rely on.
sh_test(
    name = "busybox_test",
    size = "small",
    srcs = ["busybox_test.sh"],
    args = ["$(location @alpine_busybox//:root/bin/busybox.static)"],
    data = ["@alpine_busybox//:root/bin/busybox.static"],
)

# apk.py's download step against a fake mirror: a build the mirror dropped
# says to refetch the index.
py_test(
    name = "fetch_test",
    size = "small",
    srcs = ["fetch_test.py"],
    main = "fetch_test.py",
    deps = [":apk"],
)
