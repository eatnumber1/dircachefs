load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Pinned, Bazel-built, static mkfs.xfs and xfs_io (docs/plan/review-fixes.md,
# R3/L5). See README.md; BUILD.xfsprogs is the configure_make overlay placed
# into the fetched source tree (MODULE.bazel).
exports_files(["BUILD.xfsprogs"])

# configure_make's declared outputs are not addressable as labels; the
# out_binaries each get an OutputGroupInfo group (see
# third_party/e2fsprogs/BUILD.bazel).
filegroup(
    name = "mkfs_xfs",
    srcs = ["@xfsprogs_src//:xfsprogs"],
    output_group = "mkfs.xfs",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "xfs_io",
    srcs = ["@xfsprogs_src//:xfsprogs"],
    output_group = "xfs_io",
    visibility = ["//visibility:public"],
)

# Test first: before the targets above existed this failed with "missing
# input file '//third_party/xfsprogs:mkfs_xfs'". Checks: static, no sanitizer
# runtime (also under --config=asan/ubsan), the pinned version, and that
# mkfs.xfs makes a filesystem.
sh_test(
    name = "smoke_test",
    size = "small",
    srcs = ["smoke_test.sh"],
    args = [
        "$(location :mkfs_xfs)",
        "$(location :xfs_io)",
        "7.2.0",
    ],
    data = [
        ":mkfs_xfs",
        ":xfs_io",
    ],
)
