# BUILD file for @xfsprogs_src (see MODULE.bazel, README.md). xfsprogs is
# autoconf + a recursive, libtool-using make tree, so configure_make fits,
# the same way third_party/e2fsprogs/BUILD.e2fsprogs does. Builds two static
# binaries: mkfs.xfs (the filesystems under test) and xfs_io (later phases'
# tests drive xfs-specific ioctls with it).

load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")

filegroup(
    name = "all_srcs",
    srcs = glob(["**"], exclude = ["bazel-*"]),
)

XFSPROGS_CONFIGURE_OPTIONS = [
    # --enable-shared=no (sic: xfsprogs's own spelling) makes libxfs and
    # friends static-only libtool archives. The binaries are made fully
    # static by `LLDFLAGS=-all-static` in `targets` below.
    "--enable-shared=no",

    # xfs_scrub and xfs_healer are online-repair daemons: they need libicu,
    # systemd and fanotify plumbing, and nothing here mounts xfs for them.
    "--disable-scrub",
    "--enable-libicu=no",
    "--disable-healer",

    # No translated message catalogs (and no gettext tools needed).
    "--disable-gettext",

    # No libedit/termcap line editing in xfs_io (defaults to no; explicit so
    # a host that happens to have libedit cannot change the result).
    "--enable-editline=no",
    "--enable-termcap=no",

    # lib64 and librt are probes of the host's multilib layout and of -lrt;
    # glibc 2.34+ has no separate librt, and the install tree is never used.
    "--enable-lib64=no",
    "--enable-librt=no",

    # Install-path probes for systemd/cron/udev integration: this build
    # never installs (postfix_script copies the two binaries out), so make
    # the result independent of what the sandbox happens to contain.
    "--without-systemd-unit-dir",
    "--without-crond-dir",
    "--without-udev-rule-dir",
]

configure_make(
    name = "xfsprogs",
    lib_source = ":all_srcs",
    configure_command = "configure",
    # xfsprogs builds in its source tree and writes generated headers and
    # libtool objects into it: build in a copy.
    configure_in_place = True,
    configure_options = XFSPROGS_CONFIGURE_OPTIONS,
    # `headers` populates include/xfs, which everything else includes; the
    # top-level Makefile makes each tool directory depend on the libraries it
    # links (libfrog, libxfs, libxcmd, libhandle), so naming the two tool
    # directories builds exactly what they need. LLDFLAGS=-all-static (a
    # make variable on the command line, overriding the per-directory
    # `LLDFLAGS = -static-libtool-libs`) is what makes libtool pass -static
    # to the compiler: a plain -static in LDFLAGS is only libtool's "prefer
    # static libtool archives" and leaves a dynamic PIE executable (checked
    # by hand: `file` said "dynamically linked").
    targets = [
        "headers",
        "LLDFLAGS=-all-static mkfs io",
    ],
    out_binaries = [
        "mkfs.xfs",
        "xfs_io",
    ],
    # See third_party/e2fsprogs/BUILD.e2fsprogs for $$INSTALLDIR/
    # $$BUILD_TMPDIR (no closing "$$"). strip: debug info is megabytes and
    # nobody debugs these in place.
    postfix_script = "mkdir -p $$INSTALLDIR/bin && " +
                     "cp $$BUILD_TMPDIR/mkfs/mkfs.xfs $$INSTALLDIR/bin/mkfs.xfs && " +
                     "cp $$BUILD_TMPDIR/io/xfs_io $$INSTALLDIR/bin/xfs_io && " +
                     "strip $$INSTALLDIR/bin/mkfs.xfs $$INSTALLDIR/bin/xfs_io",
    # libuuid/libblkid (util-linux), liburcu and libinih: all private,
    # static, Bazel-built; rules_foreign_cc turns each dep's CcInfo into
    # CPPFLAGS=-I/LDFLAGS=-L for configure. The generated makefiles ignore
    # CPPFLAGS (builddefs.in only forwards CFLAGS and LDFLAGS), so the -I
    # for <urcu.h> etc. is repeated in CFLAGS.
    deps = [
        "@inih_src//:inih",
        "@userspace_rcu_src//:urcu",
        "@util_linux_src//:uuid_blkid",
    ],
    env = {
        # No host pkg-config lookups (configure only uses it for optional
        # udev/systemd/icu probes, all disabled above).
        "PKG_CONFIG_LIBDIR": "/nonexistent",
        # -Wno-error: the project-wide `build --copt -Werror` leaks into
        # rules_foreign_cc's CFLAGS and would turn warnings in xfsprogs's
        # own code (and configure's probes) into failures.
        # -fno-sanitize=address,undefined (ONE word): cancels the
        # --config=asan/ubsan flags that leak the same way; a sanitized
        # mkfs.xfs would link a libasan runtime into a host-side image tool.
        "CFLAGS": "-Wno-error -g -O2 -fno-sanitize=address,undefined " +
                  "-I$$EXT_BUILD_DEPS$$/uuid_blkid/include " +
                  "-I$$EXT_BUILD_DEPS$$/urcu/include " +
                  "-I$$EXT_BUILD_ROOT$$/external/+http_archive+inih_src",
        "LDFLAGS": "-fno-sanitize=address,undefined",
    },
    visibility = ["//visibility:public"],
)
