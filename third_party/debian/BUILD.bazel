load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//test/qemu:host_only.bzl", "HOST_ONLY_COMPATIBLE")

# Phase 4, part c (docs/plan/phases/04-pinned-host-tools.md): the Debian
# NFS-test rootfs image, built by Bazel from packages rules_distroless
# resolved and fetched from a pinned snapshot.debian.org timestamp --
# replacing test/qemu/scripts/mkrootfs-debian.sh's mmdebstrap run. See
# README.md for the package list (with each package's reason), the pin,
# and the update procedure.

# @debian is the apt.install dependency_set (MODULE.bazel); :flat is
# rules_distroless's own `flatten` rule merging every resolved package's
# data.tar (our 14 explicitly requested packages plus everything they pull
# in transitively -- 136 packages total as of this pin) into one tar.
#
# The image is made without privilege by scripts/mkrootfs.py: it unpacks
# @debian//:flat into a directory (following the tar's own symlinks only
# inside it), makes the filesystem with Alpine's mke2fs -d (Alpine's mke2fs
# cannot read a tar) and sets ownership and modes with debugfs. mke2fs and
# debugfs are the wrappers that run Alpine's musl binaries on this host
# (third_party/alpine/README.md); `@alpine_fstools//:root` is their tree.
# The profile is third_party/e2fsprogs/mke2fs.conf. See README.md's
# "Ownership" section.
py_binary(
    name = "mkrootfs",
    srcs = ["scripts/mkrootfs.py"],
    main = "scripts/mkrootfs.py",
)

py_library(
    name = "mkrootfs_lib",
    srcs = ["scripts/mkrootfs.py"],
    imports = ["scripts"],
)

genrule(
    name = "rootfs",
    srcs = ["@debian//:flat"],
    outs = ["rootfs-debian.ext4"],
    cmd = "$(location :mkrootfs) --flat $(location @debian//:flat) " +
          "--out $@ --size 768M " +
          "--mke2fs $(location @alpine_fstools//:mke2fs) " +
          "--debugfs $(location @alpine_fstools//:debugfs) " +
          "--mke2fs-conf $(location //third_party/e2fsprogs:mke2fs.conf) " +
          # e2fsprogs's clock: the snapshot's timestamp (MODULE.bazel,
          # apt.sources_list: 20261006T082722Z), later than every package's
          # mtime. mkrootfs.py fails if a package is newer, so move this
          # with the snapshot pin.
          "--source-date-epoch 1791275242",
    tools = [
        ":mkrootfs",
        "//third_party/e2fsprogs:mke2fs.conf",
        "@alpine_fstools//:debugfs",
        "@alpine_fstools//:mke2fs",
        "@alpine_fstools//:root",
    ],
    visibility = ["//test/qemu:__pkg__"],
)

# Test first: before scripts/mkrootfs.py existed the image was made by
# `mke2fs -d <tarball>` of a source-built e2fsprogs; this checks the new
# builder on a small tar with the real tools (ownership, modes, hard links,
# symlinked parents, fixed-up paths, reproducibility).
py_test(
    name = "mkrootfs_test",
    size = "small",
    srcs = ["scripts/mkrootfs_test.py"],
    args = [
        "$(location @alpine_fstools//:mke2fs)",
        "$(location @alpine_fstools//:debugfs)",
        "$(location //third_party/e2fsprogs:mke2fs.conf)",
    ],
    data = [
        "//third_party/e2fsprogs:mke2fs.conf",
        "@alpine_fstools//:debugfs",
        "@alpine_fstools//:mke2fs",
    ],
    main = "scripts/mkrootfs_test.py",
    deps = [":mkrootfs_lib"],
    target_compatible_with = HOST_ONLY_COMPATIBLE,
)

# Test first: fails the moment the resolved packages' versions drift from
# packages.lock (a new snapshot pin, a package-list edit, or -- without
# either -- rules_distroless resolving something unexpected), or the fetched
# .deb files (all of them, transitive packages included) drift from debs.lock.
# See scripts/version_check.sh; @debian//:dpkg_status is rules_distroless's
# own synthesized /var/lib/dpkg/status, scoped to just the packages named in
# MODULE.bazel's apt.install (not their transitive dependencies), so the full
# list comes from MODULE.bazel.lock via scripts/lock_debs.sh. The lock itself
# is made authoritative by `common --lockfile_mode=error` (.bazelrc).
sh_test(
    name = "version_check_test",
    size = "small",
    srcs = ["scripts/version_check.sh"],
    args = [
        "$(location @debian//:dpkg_status)",
        "$(location packages.lock)",
        "$(location scripts/lock_debs.sh)",
        "$(location //:MODULE.bazel.lock)",
        "$(location debs.lock)",
    ],
    data = [
        "debs.lock",
        "packages.lock",
        "scripts/lock_debs.sh",
        "//:MODULE.bazel.lock",
        "@debian//:dpkg_status",
    ],
    target_compatible_with = HOST_ONLY_COMPATIBLE,
)

# The image has real ownership: before Phase 4's e2fsprogs follow-up every
# file in :rootfs was owned by whatever uid/gid ran the genrule, and this
# test failed with /etc/os-release reporting "User: 1000 Group: 120". It
# spot-checks root:root on a few paths, /bin/mount's setuid bit and the ext4
# features the checked-in mke2fs.conf asks for; rootfs_invariant_test (below)
# checks every path against the tar.
sh_test(
    name = "ownership_test",
    size = "small",
    srcs = ["scripts/ownership_test.sh"],
    args = [
        "$(location @alpine_fstools//:debugfs)",
        "$(location :rootfs)",
    ],
    data = [
        ":rootfs",
        "@alpine_fstools//:debugfs",
    ],
    target_compatible_with = HOST_ONLY_COMPATIBLE,
)

# The pinned package list, read by //tools/sbom:sbom_test.
exports_files(["debs.lock"])

# The real image against the tar it was made from: for every member of
# @debian//:flat (resolved through the tar's own symlinks), one batched
# debugfs stat gives type, mode, owner, group, size and hard-link grouping,
# compared with the header. (ownership_test keeps its spot checks and the
# ext4 features.)
py_test(
    name = "rootfs_invariant_test",
    size = "medium",
    srcs = ["scripts/rootfs_invariant_test.py"],
    args = [
        "$(location @debian//:flat)",
        "$(location :rootfs)",
        "$(location @alpine_fstools//:debugfs)",
    ],
    data = [
        ":rootfs",
        "@alpine_fstools//:debugfs",
        "@debian//:flat",
    ],
    main = "scripts/rootfs_invariant_test.py",
    target_compatible_with = HOST_ONLY_COMPATIBLE,
)

py_library(
    name = "rootfs_invariant_lib",
    testonly = 1,
    srcs = ["scripts/rootfs_invariant_test.py"],
    imports = ["scripts"],
)

# Step 26.1: self-check of rootfs_invariant_test: a synthetic tar and image
# made with the real mkrootfs.py, then the test's own header comparison
# (header_problems) over a tar whose mode or owner was altered.
py_test(
    name = "rootfs_invariant_self_check",
    size = "small",
    srcs = ["scripts/rootfs_invariant_self_check.py"],
    args = [
        "$(location @alpine_fstools//:mke2fs)",
        "$(location @alpine_fstools//:debugfs)",
        "$(location //third_party/e2fsprogs:mke2fs.conf)",
    ],
    data = [
        "//third_party/e2fsprogs:mke2fs.conf",
        "@alpine_fstools//:debugfs",
        "@alpine_fstools//:mke2fs",
    ],
    main = "scripts/rootfs_invariant_self_check.py",
    deps = [
        ":mkrootfs_lib",
        ":rootfs_invariant_lib",
    ],
    target_compatible_with = HOST_ONLY_COMPATIBLE,
)
