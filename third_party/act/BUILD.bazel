load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

# `bazel run //third_party/act -- <act arguments>`: nektos/act with this
# repository's pins (runner image digest, KVM device, container label); see
# README.md. The wrapper script is the only place those settings live. It
# is generated so that it can name the act binary's runfiles path (a
# binary's `env` attribute does not apply when the script is run directly
# from bazel-bin, which is how `sg docker -c` callers run it).
genrule(
    name = "act_sh",
    srcs = [
        "act.sh.tpl",
        "@act//:act",
    ],
    outs = ["act_wrapper.sh"],
    cmd = "sed 's|@ACT_RLOCATION@|$(rlocationpath @act//:act)|' $(location act.sh.tpl) > $@",
)

sh_binary(
    name = "act",
    srcs = [":act_sh"],
    data = [
        "runner_image.txt",
        "@act//:act",
    ],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)
