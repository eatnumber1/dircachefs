exports_files([
    "BUILD.linux_source",
    "kernel.config",
    "build_kernel.sh",
])

# Step 3.1a: the pinned, stock upstream test kernel -- a second kernel the
# QEMU tests can select (see //test/qemu:kernel, test/qemu/kernel.bzl) next
# to the patched kernel that stays the default for now (test/qemu/README.md,
# docs/plan/phases/03-drop-kernel-patch-and-build-test-kernel.md). Built as
# an ordinary Bazel action: no writes outside this genrule's declared
# outputs, no network access. See README.md for the pin, the config
# fragment's rationale, and which host tools this build still depends on.
genrule(
    name = "kernel_build",
    srcs = [
        "@linux_source//:all",
        "@linux_source//:Makefile",
        "kernel.config",
    ],
    outs = [
        "bzImage",
        "kernel-build.log",
    ],
    cmd = """
        $(location build_kernel.sh) \
            "$$(dirname '$(location @linux_source//:Makefile)')" \
            '$(location kernel.config)' \
            '$(location //third_party/bc:bc)' \
            '$(location bzImage)' \
            '$(location kernel-build.log)' \
            4
    """,
    tools = [
        "build_kernel.sh",
        "//third_party/bc:bc",
    ],
    visibility = ["//visibility:public"],
)
