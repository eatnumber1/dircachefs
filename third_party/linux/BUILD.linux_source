# BUILD file for @linux_source (the pinned upstream kernel release tarball,
# see MODULE.bazel's http_archive and third_party/linux/README.md for the
# pin and update procedure). Bazel doesn't need to understand kernel
# Kbuild's own build graph -- third_party/linux:bzImage (BUILD.bazel) just
# needs the whole extracted source tree as an input and a stable way to
# find its root directory inside the sandbox (the "Makefile" exports_file
# below; see build_kernel.sh's use of its location and dirname).
exports_files(["Makefile"])

filegroup(
    name = "all",
    srcs = glob(
        ["**"],
        # .git* doesn't exist in a release tarball, but excluding it (and
        # anything else VCS-ish) is cheap insurance if a future pin is
        # fetched from git archive instead.
        exclude = [".git/**", ".gitignore"],
    ),
    visibility = ["//visibility:public"],
)
