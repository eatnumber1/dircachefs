     # Fix the filesystem type up here so that the callers don't
     # have to bother with this quirk.
     #
+    #
+    # dcfs (step 17.1): a FUSE file system mounted with a subtype
+    # (FSTYP=fuse, FUSE_SUBTYP=.dcfs, so mount -t fuse.dcfs) shows up in df as
+    # fuse.dcfs, and init_rc compares that with FSTYP, which is fuse.
     _df_device $1 | $AWK_PROG '{ print $2 }' | \
         sed -e 's/nfs4/nfs/' -e 's/fuse.glusterfs/glusterfs/' \
-            -e 's/fuse.ceph-fuse/ceph-fuse/'
+            -e 's/fuse.ceph-fuse/ceph-fuse/' -e 's/^fuse\.[^.]*$/fuse/'
 }
 
