diff -u -r a/check b/check
--- a/check
+++ b/check
@@ -682,7 +682,10 @@
 # Make the check script unattractive to the OOM killer...
 OOM_SCORE_ADJ="/proc/self/oom_score_adj"
 function _adjust_oom_score() {
-	test -w "${OOM_SCORE_ADJ}" && echo "$1" > "${OOM_SCORE_ADJ}"
+	# dcfs (step 17.1): the guest's bash is musl's, whose echo writes the
+	# number and the newline separately; the kernel parses the newline of the
+	# second write as an empty number and answers EINVAL, which bash reports.
+	test -w "${OOM_SCORE_ADJ}" && printf '%s' "$1" > "${OOM_SCORE_ADJ}"
 }
 _adjust_oom_score -500
 
