# BUILD file for @qemu (see MODULE.bazel's qemu_repo call, qemu_repo.bzl,
# and third_party/qemu/README.md). Placed at the root of the fetched QEMU
# source tree by qemu_repo's build_file= attribute (same
# repository_ctx.symlink mechanism http_archive's own build_file=
# attribute uses, the same pattern as third_party/pjdfstest/BUILD.pjdfstest
# elsewhere in this tree -- qemu_repo just also needs to place dtc's
# source into subprojects/dtc first, which http_archive alone can't do;
# see qemu_repo.bzl).
#
# QEMU's own `configure` script is not plain Meson: it is a wrapper that
# sets up its own Python venv from vendored wheels (python/wheels/*.whl,
# shipped inside the release tarball -- no network access needed) and
# invokes Meson from there itself, then emits a Makefile that forwards
# `make`/`make install` to `ninja`/`ninja install`. That fits
# rules_foreign_cc's `configure_make` (configure-then-make) pattern
# directly: the "configure" step is QEMU's own script, and the "make"
# step is the generated Makefile shim. There's no need for
# rules_foreign_cc's `meson` rule (which would run `meson setup` itself)
# or a hand-rolled rule.

load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")

filegroup(
    name = "all_srcs",
    # (Note for anyone tempted to glob a dotfile into this: Bazel's
    # glob() cannot match a path with any dot-prefixed segment at all,
    # under any pattern -- see qemu_repo.bzl's docstring and
    # MODULE.bazel's qemu_repo call for the one place in this build that
    # actually mattered, subprojects/dtc, and how it's handled instead.)
    srcs = glob(["**"], exclude = ["bazel-*"]),
)

# The full `--without-default-features --without-default-devices` QEMU
# configure line: see README.md for why each flag/dependency/device is
# here (or, for things NOT here, why they're off). Kept in one place so
# the configure line in README.md and the one actually run can be diffed
# by eye.
QEMU_CONFIGURE_OPTIONS = [
    # Start from nothing, then enable only what's needed (plan decision,
    # russ 2026-10-05).
    "--without-default-features",
    "--without-default-devices",

    # One target: x86_64 system emulation only. No user-mode emulation,
    # no other guest architectures.
    "--target-list=x86_64-softmmu",

    # Accelerators: KVM, and TCG for the no-KVM fallback (phase 5.1).
    "--enable-kvm",
    "--enable-tcg",

    # The microvm machine's Kconfig (hw/i386/Kconfig) depends on FDT,
    # even though nothing in this build ever emits or loads a real
    # device tree blob on x86_64 (CONFIG_MICROVM selects
    # CONFIG_DEVICE_TREE for internal reasons unrelated to dcfs's use of
    # it). "internal" builds libfdt from the dtc subproject instead of
    # requiring a system libfdt -- the BCR has no libfdt module, and one
    # more pinned dependency is simpler than adding one. subprojects/dtc
    # is placed there by qemu_repo.bzl, not by this tarball (see
    # MODULE.bazel's qemu_repo call and README.md's "The dtc subproject").
    "--enable-fdt=internal",

    # The checked-in device config (0001-add-dcfs-device-config.patch
    # adds configs/devices/x86_64-softmmu/dcfs.mak): microvm plus
    # virtio-blk, nothing else explicitly selected.
    "--with-devices-x86_64=dcfs",

    # Block layer: raw images only. (This release renamed
    # --block-drv-whitelist to separate ro/rw whitelists; raw supports
    # both directions, so both get the same list.) This needs *two*
    # driver names, not just "raw": QEMU's block layer is two stacked
    # layers, a format driver ("raw", "qcow2", ...) wrapping a protocol
    # driver ("file" for a local disk image, "host_device" for a raw
    # block device, "nbd" for network, ...) -- confirmed the hard way,
    # with a real guest boot: `-drive file=vdb.img,format=raw` (exactly
    # what run-qemu.sh uses) failed outright with "Driver 'file' is not
    # whitelisted" when only "raw" was listed. "host_device" (a real
    # /dev/vd* or /dev/sd* passed straight through) is not added:
    # run-qemu.sh only ever gives QEMU a plain regular-file disk image,
    # never a host block device.
    "--block-drv-ro-whitelist=raw,file",
    "--block-drv-rw-whitelist=raw,file",

    # No tools (qemu-img etc.), no docs, no guest agent: all three
    # already default to disabled under --without-default-features, but
    # are listed explicitly here (the plan calls them out by name) so a
    # future QEMU release that changes a default doesn't silently
    # re-enable one.
    "--disable-tools",
    "--disable-docs",
    "--disable-guest-agent",

    # Keymaps/icons/device-tree-blob-for-other-architectures data files
    # still get installed regardless (they're meson install() targets
    # independent of the "blobs" concept below -- see README.md) but are
    # inert, tiny, and never read by run-qemu.sh. --disable-install-blobs
    # covers the BIOS/EFI/option-ROM firmware blobs other QEMU machine
    # types need (bios.bin, efi-virtio.rom, etc); qboot.rom (the one
    # firmware this build uses) ships as a prebuilt binary at
    # pc-bios/qboot.rom in the release tarball and is read directly from
    # there (see the exports_files call at the bottom of this file), not
    # installed by this flag.
    "--disable-install-blobs",

    # Not a QEMU feature flag -- cancels this *build's* own -Werror.
    # rules_foreign_cc's configure_make reads the current Bazel C++
    # toolchain's configured copts to build CFLAGS for the underlying
    # ./configure invocation (that's how CPPFLAGS/LDFLAGS correctly pick
    # up @glib//glib and @zlib too -- see the "Dependencies" comment
    # above), which also means *this repository's own* global
    # `build --copt -Werror` (.bazelrc) leaks into a third-party
    # project's build. That's exactly the same problem the top-level
    # .bazelrc's `--per_file_copt=external/.*@-Wno-error` already solves
    # for ordinary Bazel-native cc_library/cc_binary compilation (its
    # comment: "scope -Werror back off for code under external/ only;
    # our own sources are unaffected") -- per_file_copt just has no
    # effect here, since this whole build runs as one opaque shell
    # action invoking QEMU's own ./configure and ninja, not Bazel's own
    # compile actions. --extra-cflags is QEMU's own supported mechanism
    # for the same end result: confirmed blocker was GCC 13 flagging an
    # upstream `-Wimplicit-fallthrough` case in qapi/opts-visitor.c that
    # upstream's own, much older default toolchain apparently never
    # warned on -- not a real bug worth patching around, just this
    # project's own stricter warning policy being applied somewhere it
    # was never meant to reach.
    "--extra-cflags=-Wno-error",

    # Phase 6.3: the same leak as -Werror above, for --config=asan/ubsan's
    # global `build:asan --copt -fsanitize=address` / `build:ubsan --copt
    # -fsanitize=undefined` (.bazelrc): confirmed by reading the generated
    # build_script.sh, whose CFLAGS/CXXFLAGS/ASFLAGS end in
    # "... -fsanitize=address -DADDRESS_SANITIZER -O1 -g" under
    # --config=asan, and whose resulting qemu-system-x86_64 links
    # libasan.so.8 (`readelf -d`) -- QEMU is not under test; sanitizing it
    # only adds rebuild time and makes every guest's emulator run slower.
    # -fno-sanitize=address/undefined (later flags, so overriding -- same
    # left-to-right cumulative rule as -Wno-error above) cancel the
    # instrumentation regardless of which sanitizer config (if any) is
    # active; harmless, a no-op, when neither is. --extra-ldflags is the
    # matching mechanism for the link-time `build:asan/ubsan --linkopt
    # -fsanitize=...` (.bazelrc), which otherwise leaks into this build's
    # LDFLAGS the same way --extra-cflags's own comment explains for
    # CFLAGS, and is what actually pulls libasan.so into the linked
    # qemu-system-x86_64.
    #
    # ONE word per option (review M2): rules_foreign_cc joins
    # configure_options with plain spaces, unquoted, so the two-word value
    # this used to hold ("--extra-cflags=-fno-sanitize=address
    # -fno-sanitize=undefined") reached configure as the option plus a bare
    # "-fno-sanitize=undefined" word, which configure silently ignored:
    # --config=ubsan still built an instrumented QEMU. A comma list is a
    # single word. smoke_test.sh checks the built binary for sanitizer
    # runtimes.
    "--extra-cflags=-fno-sanitize=address,undefined",
    "--extra-ldflags=-fno-sanitize=address,undefined",
]

configure_make(
    name = "qemu",
    lib_source = ":all_srcs",
    configure_command = "configure",
    configure_in_place = True,
    configure_options = QEMU_CONFIGURE_OPTIONS,
    # Default targets attr is ["", "install"], i.e. plain `make` (ninja's
    # *default* target) then `make install`. Neither half of that default
    # is what we want: plain `make`/ninja-default builds QEMU's own ~250
    # qtest/unit test binaries too (confirmed: building just
    # "qemu-system-x86_64" is ~1075 ninja steps; the bare default is
    # ~1400+, and does things like compiling tests/audio/test-audio,
    # which pulls in gio/gobject headers this build doesn't otherwise
    # need at all) -- useless weight here. And "install" turned out not
    # to be the lightweight copy-only step it looks like: meson's
    # generated `ninja install` target itself depends on the *default*
    # ninja target first (confirmed by watching it happen: requesting
    # only targets=["qemu-system-x86_64", "install"] still built the
    # whole test suite, because "install" pulled "all" in regardless of
    # what was already built). So: build only the one binary we want,
    # then place it into $INSTALLDIR ourselves via postfix_script,
    # bypassing meson's "install" graph entirely instead of trying to
    # make it smaller.
    targets = ["qemu-system-x86_64"],
    # BUILD_TMPDIR/INSTALLDIR are plain shell environment variables by
    # this point in the generated script (both appear in its own printed
    # "Environment:" block) -- not registered Bazel Make variables, so
    # $(INSTALLDIR) doesn't work ("not defined"), and a bare, unescaped
    # "$INSTALLDIR" is rejected outright by Bazel's attribute validator
    # ("use '$(INSTALLDIR)' ... or escape the '$' as '$$' if you intended
    # this for the shell"). The one spelling that is both accepted and
    # correct: a single escaped "$$" immediately before the name and
    # nothing after it -- "$$" collapses to one literal "$" during
    # attribute expansion, giving plain "$BUILD_TMPDIR" as the actual
    # shell text, and bash's own variable-name parsing naturally stops at
    # the following "/" with no explicit terminator needed. (A *closing*
    # "$$" too, i.e. "$$BUILD_TMPDIR$$", was tried first and is wrong:
    # that collapses to the literal text "$BUILD_TMPDIR$" -- bash still
    # reads "$BUILD_TMPDIR" correctly, but a stray extra "$" then
    # survives right after it, which is exactly why the very first
    # attempt's `cp` source argument ended in
    # ".../qemu.build_tmpdir$/build/qemu-system-x86_64".)
    postfix_script = "mkdir -p $$INSTALLDIR/bin && " +
                      "cp $$BUILD_TMPDIR/build/qemu-system-x86_64 $$INSTALLDIR/bin/qemu-system-x86_64",
    # deps provide glib and zlib (QEMU's only two hard dependencies even
    # in this configuration; see README.md's "Dependencies") so
    # rules_foreign_cc can turn them into correct CPPFLAGS/-I and
    # LDFLAGS/-L entries for ./configure (confirmed in the build log) --
    # but deliberately goes no further than that: it does not also guess
    # a `-l<name>` or synthesize a .pc file, since picking the right one
    # is exactly what the downstream project's own dependency discovery
    # is supposed to do. Both glib and zlib need an actual .pc on
    # PKG_CONFIG_LIBDIR as a result (:glib_pc/:zlib_pc, pkgconfig_shim.bzl)
    # -- glib because QEMU's meson.build hard-codes `dependency('glib-2.0',
    # method: 'pkg-config', required: true)`, no fallback; zlib for a
    # subtler reason documented in pkgconfig_shim.bzl ("zlib *also* needs
    # one of these"): with no shim, meson's `dependency('zlib', ...)`
    # "worked" by finding the *host's* zlib.pc (version mismatch and a
    # `NEEDED` entry on the host's libz.so.1 both confirmed it), since
    # nothing was stopping pkg-config from also searching its own default
    # paths.
    #
    # @glib//gmodule is here for a related but distinct reason: it is
    # *only* read by :glib_pc (merged into the same .pc -- see
    # pkgconfig_shim.bzl for why), never by this rule's own CPPFLAGS/
    # LDFLAGS directly, but a target's CcInfo only describes *where its
    # outputs would be*, it does not make Bazel build them -- something
    # has to actually depend on the files for that. Without gmodule listed
    # here too, nothing in the whole build graph ever caused
    # @glib//gmodule to actually be compiled, so :glib_pc's embedded
    # `-I .../gmodule/include_glib-2.0` pointed at a directory that
    # genuinely did not exist on disk (confirmed: `#include <gmodule.h>`
    # failed with that exact path in the error, and the directory was
    # simply absent from bazel-bin). Listing it here is what makes Bazel
    # build it in the first place, in the same (target) configuration
    # :glib_pc's paths already assume.
    deps = [
        "@glib//glib",
        "@glib//gmodule",
        "@zlib",
    ],
    # `data` (not `build_data`): build_data transitions to the *exec*
    # configuration, which would make :glib_pc/:zlib_pc embed paths to a
    # second, separately-built exec-config copy of glib/zlib that nothing
    # else in this build graph forces to actually exist on disk (their
    # own actions only read File.path strings out of CcInfo to embed as
    # text -- that doesn't create a dependency edge on the files
    # themselves, so Bazel has no reason to build that copy). `data`
    # keeps them in the *target* configuration, i.e. the exact same one
    # `deps` above already uses -- the files their embedded paths point
    # to are therefore already guaranteed present in this same action's
    # sandbox via `deps`, with no second glib/zlib build needed
    # (confirmed: the first attempt, with build_data, failed because
    # `bazel-out/k8-opt-exec/bin/external/glib+/...` never got built).
    data = [
        "@dircachefs//third_party/qemu:glib_pc",
        "@dircachefs//third_party/qemu:zlib_pc",
    ],
    env = {
        # PKG_CONFIG_LIBDIR, not PKG_CONFIG_PATH: *replaces* pkg-config's
        # default search path instead of adding to it. PKG_CONFIG_PATH
        # alone is exactly how the host's zlib got found in the first
        # place (see :zlib_pc's comment above) -- pkg-config still checks
        # its own compiled-in default directories (every system
        # *-dev package's .pc files) regardless of what's prepended via
        # PKG_CONFIG_PATH. With PKG_CONFIG_LIBDIR set, the *only* .pc
        # files pkg-config can find at all are these two.
        "PKG_CONFIG_LIBDIR": "$(execpath @dircachefs//third_party/qemu:glib_pc):" +
                              "$(execpath @dircachefs//third_party/qemu:zlib_pc)",
    },
    out_binaries = ["qemu-system-x86_64"],
    visibility = ["//visibility:public"],
)

# qboot.rom ships prebuilt inside the release tarball (pc-bios/qboot.rom)
# -- QEMU does not build it from source as part of a normal build (its
# own source lives in a separate roms/qboot/ subtree with its own
# toolchain requirements: a 16-bit real-mode-capable cross compiler this
# project has no other use for). Building it from source was considered
# per the plan ("if that is simple") and rejected: see README.md's
# "Firmware" section. Taking the prebuilt ROM out of the pinned,
# sha256-verified tarball is exactly as reproducible as building it would
# be, for far less complexity.
exports_files(["pc-bios/qboot.rom"])
