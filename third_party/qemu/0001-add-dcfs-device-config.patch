--- a/configs/devices/x86_64-softmmu/dcfs.mak
+++ b/configs/devices/x86_64-softmmu/dcfs.mak
@@ -0,0 +1,26 @@
+# Minimal x86_64-softmmu device config for dcfs's QEMU test harness
+# (third_party/qemu/README.md has the full rationale). Passed to
+# ./configure as --with-devices-x86_64=dcfs, combined with
+# --without-default-devices so *only* what is select-ed from here (plus
+# whatever CONFIG_MICROVM's own Kconfig unconditionally pulls in) gets
+# built.
+#
+# CONFIG_MICROVM: the "microvm" machine type run-qemu.sh boots
+#   (-M microvm,...). Its own hw/i386/Kconfig entry unconditionally
+#   selects a number of other Kconfig symbols (ACPI variants, PCI/
+#   PCI_EXPRESS, USB_XHCI_SYSBUS, DEVICE_TREE, ISA_BUS, APIC/IOAPIC/
+#   I8259/I8254, MC146818RTC, VIRTIO/VIRTIO_MMIO, MSI_NONBROKEN,
+#   MEM_DEVICE) -- these are compiled in because MICROVM's Kconfig
+#   depends on/selects them, not because dcfs asked for PCI, USB or ACPI
+#   support; none of them register an instantiable `-device` type beyond
+#   the four listed in the README (verified: `-device help` lists only
+#   virtio-blk-device, isa-serial, virtio-serial-device and
+#   mc146818rtc, plus the CPU model list, with this exact config).
+CONFIG_MICROVM=y
+
+# CONFIG_VIRTIO_BLK: virtio-blk-device, run-qemu.sh's only disk device
+# (-device virtio-blk-device). Not selected by CONFIG_MICROVM or
+# CONFIG_VIRTIO_MMIO themselves (those only pull in the generic virtio
+# transport, not any particular device model), so it needs to be listed
+# here explicitly.
+CONFIG_VIRTIO_BLK=y
