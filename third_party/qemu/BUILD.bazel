exports_files([
    "BUILD.qemu",
    "0001-add-dcfs-device-config.patch",
])

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//third_party:exec_file.bzl", "exec_file")
load(":pkgconfig_shim.bzl", "pkgconfig_shim")

# See pkgconfig_shim.bzl's docstring: QEMU's meson.build looks up glib
# exclusively via `dependency('glib-2.0', method: 'pkg-config')`, but
# @glib//glib (a BCR cc_library overlay, not a foreign_cc target with its
# own install tree) has no .pc file of its own. This generates one from
# @glib//glib's (and @glib//gmodule's -- see pkgconfig_shim.bzl for why)
# CcInfo, referenced by BUILD.qemu's configure_make rule via its `env`'s
# PKG_CONFIG_PATH.
pkgconfig_shim(
    name = "glib_pc",
    pkg_name = "glib-2.0",
    version = "2.82.2",
    deps = [
        "@glib//glib",
        "@glib//gmodule",
    ],
    visibility = ["//visibility:public"],
)

# Same mechanism, for zlib -- see pkgconfig_shim.bzl's "zlib *also* needs
# one of these" paragraph for why this one is less obvious than it looks
# (meson's zlib probe "worked" without it, just against the *host's*
# zlib, found via pkg-config's default search path that PKG_CONFIG_PATH
# alone doesn't suppress -- BUILD.qemu's PKG_CONFIG_LIBDIR is the other
# half of this fix).
pkgconfig_shim(
    name = "zlib_pc",
    pkg_name = "zlib",
    version = "1.3.2",
    deps = ["@zlib"],
    visibility = ["//visibility:public"],
)

# configure_make's declared outputs (the binary, the installed headers
# tree, etc.) are not individually addressable by their on-disk path as a
# label -- confirmed: `@qemu//:qemu/bin/qemu-system-x86_64` fails with
# "not declared in package ''" even once that exact file exists and is
# built. What *is* addressable is the rule's own `OutputGroupInfo`, which
# `out_binaries = ["qemu-system-x86_64"]` (BUILD.qemu) gives a matching
# group for (`bazel cquery @qemu//:qemu --output=starlark
# --starlark:expr='dir(providers(target)["OutputGroupInfo"])'` lists it
# alongside "include", "gen_dir" and "Configure_logs"); this filegroup is
# the normal way to pull one specific output group out as a plain,
# single-file target other rules (like :smoke_test, below) can depend on.
filegroup(
    name = "_qemu_system_x86_64_raw",
    srcs = ["@qemu//:qemu"],
    output_group = "qemu-system-x86_64",
)

exec_file(
    name = "qemu_system_x86_64",
    src = ":_qemu_system_x86_64_raw",
    visibility = ["//visibility:public"],
)

# Host-side smoke test (AGENTS.md allows this: it needs neither root nor
# kernel control). Test first (docs/plan/log.md and this step's commit
# history have the failing-first output): before @qemu existed in
# MODULE.bazel, this target failed with "no such package '@qemu//'"; it
# now builds the pinned, minimal QEMU and checks:
#   - `qemu-system-x86_64 --version` runs and prints a version string;
#   - `-device help` lists only the devices documented in README.md
#     (plus the CPU model list, which is excluded from the comparison --
#     see smoke_test.sh);
#   - `-machine help` lists only "microvm" and "none".
# If QEMU ever starts compiling in an extra device or machine (a
# configure flag regression, an upstream default change, a Kconfig
# select chain growing), this test fails until README.md is updated to
# list and justify it -- which is the point: the device/machine list
# here is meant to be a deliberate, auditable set, not whatever the
# build happens to produce.
sh_test(
    name = "smoke_test",
    size = "small",
    srcs = ["smoke_test.sh"],
    data = [
        "README.md",
        ":qemu_system_x86_64",
    ],
    args = [
        "$(location :qemu_system_x86_64)",
        "$(location README.md)",
    ],
)
