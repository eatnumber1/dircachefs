load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//test/qemu:host_only.bzl", "HOST_ONLY_COMPATIBLE")

# e2fsprogs itself is Alpine's (@alpine_fstools, third_party/alpine); what
# lives here is the checked-in mke2fs profile every test image is made with
# (MKE2FS_CONFIG), so a filesystem never depends on a host or built-in
# default. See README.md.
exports_files(["mke2fs.conf"])

# The profile gives the ext4 feature set it names, 4 KiB blocks at every
# size, and MKE2FS_CONFIG alone decides (docs/plan/audits/
# review-2026-10-06-waves-1-2.md, L5/L10).
sh_test(
    name = "mke2fs_conf_test",
    size = "small",
    srcs = ["mke2fs_conf_test.sh"],
    args = [
        "$(location @alpine_fstools//:mke2fs)",
        "$(location @alpine_fstools//:debugfs)",
        "$(location mke2fs.conf)",
    ],
    data = [
        "mke2fs.conf",
        "@alpine_fstools//:debugfs",
        "@alpine_fstools//:mke2fs",
    ],
    target_compatible_with = HOST_ONLY_COMPATIBLE,
)
