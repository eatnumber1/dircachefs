# Overlay for the abseil/abseil.github.io archive (README.md).
exports_files(["LICENSE"])

# The Tips of the Week; the Performance Tips (`*-fast-*.md`) and the blog
# posts are not read.
filegroup(
    name = "tips",
    srcs = glob(["_posts/*-totw-*.md"]),
    visibility = ["//visibility:public"],
)
