From 0aa1acc6f6cb7c8ff2f8f28297b40d4bac4039af Mon Sep 17 00:00:00 2001
From: Russell Harmon <russ@har.mn>
Date: Tue, 11 Aug 2026 22:52:12 -0700
Subject: [PATCH] Add FUSE_CAP_ATTR_GENERATION for reliable NFS export
 (protocol 7.47)

Sync fuse_kernel.h with protocol 7.47: the unused dummy field of
struct fuse_attr_out becomes generation, and the FUSE_ATTR_GENERATION
INIT flag lets a filesystem announce that it fills it in GETATTR and
SETATTR replies. With the flag negotiated, the kernel keeps
inode->i_generation up to date outside of lookup and detects inode
number reuse (marking the stale inode bad instead of merging the new
file's attributes into it), which makes NFS file handles reliable.

- Add FUSE_CAP_ATTR_GENERATION and negotiate it in fuse_lowlevel.c.
- Add fuse_reply_attr_with_generation() so lowlevel filesystems can
  attach the generation to attr replies; exported as FUSE_3.19.
- Teach passthrough_ll to report real backing-filesystem generation
  numbers (FS_IOC_GETVERSION), include the generation in its inode
  cache identity, resolve "." and ".." lookups (rejecting stale node
  IDs with ESTALE instead of dereferencing dangling pointers), and opt
  into FUSE_CAP_EXPORT_SUPPORT + FUSE_CAP_ATTR_GENERATION when the
  kernel offers them.

Verified with the QEMU harness in fuse-generation-qemu: generation
numbers propagate into NFS file handles and match the backing ext4's
FS_IOC_GETVERSION; open_by_handle_at() round-trips; handles with a
recycled backing inode fail with ESTALE; a generation change reported
via GETATTR makes fstat() on the stale inode fail with EIO while a
fresh lookup recovers.

Rebased for dircachefs onto libfuse 3.18.2 and the kernel patch at
protocol 7.47, where FUSE_ATTR_GENERATION is bit 44.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 include/fuse_common.h   | 17 +++++++++++++++++
 include/fuse_kernel.h   | 20 ++++++++++++++++++--
 include/fuse_lowlevel.h | 26 ++++++++++++++++++++++++++
 lib/fuse_lowlevel.c     | 26 ++++++++++++++++++++++++--
 lib/fuse_versionscript  |  2 ++
 5 files changed, 87 insertions(+), 4 deletions(-)

diff --git a/include/fuse_common.h b/include/fuse_common.h
index 041188e..58764ff 100644
--- a/include/fuse_common.h
+++ b/include/fuse_common.h
@@ -512,6 +512,23 @@ struct fuse_loop_config_v1 {
  */
 #define FUSE_CAP_OVER_IO_URING (1UL << 31)
 
+/**
+ * Indicates that the filesystem provides the inode generation number in
+ * GETATTR and SETATTR replies (via fuse_reply_attr_with_generation()), in
+ * addition to the one in fuse_entry_param.
+ *
+ * A reliable generation number lets the kernel detect that an inode
+ * number was reused by the filesystem and reject stale NFS file handles
+ * with ESTALE instead of operating on the wrong file. Filesystems that
+ * want dependable NFS export support should enable this together with
+ * FUSE_CAP_EXPORT_SUPPORT and then report a consistent, non-reusable
+ * (ino, generation) pair for every inode from all of lookup, getattr and
+ * setattr.
+ *
+ * This feature is disabled by default.
+ */
+#define FUSE_CAP_ATTR_GENERATION (1ULL << 34)
+
 /**
  * Ioctl flags
  *
diff --git a/include/fuse_kernel.h b/include/fuse_kernel.h
index 94621f6..2b606e0 100644
--- a/include/fuse_kernel.h
+++ b/include/fuse_kernel.h
@@ -239,6 +239,19 @@
  *  7.45
  *  - add FUSE_COPY_FILE_RANGE_64
  *  - add struct fuse_copy_file_range_out
+ *  - add FUSE_NOTIFY_PRUNE
+ *
+ *  7.46
+ *  - add FUSE_IO_URING_CMD_ADD_QUEUE
+ *  - add FUSE_HAS_IO_URING_BUFPOOL
+ *  - add fuse_uring_cmd_req bufpool struct
+ *  - add bufpool offset field to fuse_uring_ent_in_out struct
+ *  - add FUSE_URING_ZERO_COPY, FUSE_URING_ENT_ZERO_COPY, and
+ *    FOPEN_IO_URING_ZERO_COPY flag
+ *
+ *  7.47
+ *  - add generation to fuse_attr_out
+ *  - add FUSE_ATTR_GENERATION
  */
 
 #ifndef _LINUX_FUSE_H
@@ -274,7 +287,7 @@
 #define FUSE_KERNEL_VERSION 7
 
 /** Minor version number of this interface */
-#define FUSE_KERNEL_MINOR_VERSION 45
+#define FUSE_KERNEL_MINOR_VERSION 47
 
 /** The node ID of the root inode */
 #define FUSE_ROOT_ID 1
@@ -447,6 +460,8 @@ struct fuse_file_lock {
  * FUSE_OVER_IO_URING: Indicate that client supports io-uring
  * FUSE_REQUEST_TIMEOUT: kernel supports timing out requests.
  *			 init_out.request_timeout contains the timeout (in secs)
+ * FUSE_ATTR_GENERATION: filesystem fills the generation field of
+ *			 fuse_attr_out in GETATTR and SETATTR replies
  */
 #define FUSE_ASYNC_READ		(1 << 0)
 #define FUSE_POSIX_LOCKS	(1 << 1)
@@ -494,6 +509,7 @@ struct fuse_file_lock {
 #define FUSE_ALLOW_IDMAP	(1ULL << 40)
 #define FUSE_OVER_IO_URING	(1ULL << 41)
 #define FUSE_REQUEST_TIMEOUT	(1ULL << 42)
+#define FUSE_ATTR_GENERATION	(1ULL << 44)
 
 /**
  * CUSE INIT request/reply flags
@@ -724,7 +740,7 @@ struct fuse_getattr_in {
 struct fuse_attr_out {
 	uint64_t	attr_valid;	/* Cache timeout for the attributes */
 	uint32_t	attr_valid_nsec;
-	uint32_t	dummy;
+	uint32_t	generation;
 	struct fuse_attr attr;
 };
 
diff --git a/include/fuse_lowlevel.h b/include/fuse_lowlevel.h
index 6be0295..fac43fe 100644
--- a/include/fuse_lowlevel.h
+++ b/include/fuse_lowlevel.h
@@ -1428,6 +1428,32 @@ int fuse_reply_create(fuse_req_t req, const struct fuse_entry_param *e,
 int fuse_reply_attr(fuse_req_t req, const struct stat *attr,
 		    double attr_timeout);
 
+/**
+ * Reply with attributes and the inode generation number
+ *
+ * Same as fuse_reply_attr(), but additionally reports the inode
+ * generation number to the kernel, keeping it up to date outside of
+ * lookup. The generation number must follow the same rules as the
+ * generation field in struct fuse_entry_param, and for any given inode
+ * the value reported here must be consistent with the one reported by
+ * lookup.
+ *
+ * The generation is only transmitted if the FUSE_CAP_ATTR_GENERATION
+ * capability was negotiated; otherwise this behaves exactly like
+ * fuse_reply_attr(). Note that only the lower 32 bits are transmitted.
+ *
+ * Possible requests:
+ *   getattr, setattr
+ *
+ * @param req request handle
+ * @param attr the attributes
+ * @param attr_timeout	validity timeout (in seconds) for the attributes
+ * @param generation the inode generation number
+ * @return zero for success, -errno for failure to send reply
+ */
+int fuse_reply_attr_with_generation(fuse_req_t req, const struct stat *attr,
+				    double attr_timeout, uint64_t generation);
+
 /**
  * Reply with the contents of a symbolic link
  *
diff --git a/lib/fuse_lowlevel.c b/lib/fuse_lowlevel.c
index d420b25..2a540b6 100644
--- a/lib/fuse_lowlevel.c
+++ b/lib/fuse_lowlevel.c
@@ -535,8 +535,8 @@ int fuse_reply_create(fuse_req_t req, const struct fuse_entry_param *e,
 			     entrysize + sizeof(struct fuse_open_out));
 }
 
-int fuse_reply_attr(fuse_req_t req, const struct stat *attr,
-		    double attr_timeout)
+static int do_reply_attr(fuse_req_t req, const struct stat *attr,
+			 double attr_timeout, uint32_t generation)
 {
 	struct fuse_attr_out arg;
 	size_t size = req->se->conn.proto_minor < 9 ?
@@ -545,11 +545,29 @@ int fuse_reply_attr(fuse_req_t req, const struct stat *attr,
 	memset(&arg, 0, sizeof(arg));
 	arg.attr_valid = calc_timeout_sec(attr_timeout);
 	arg.attr_valid_nsec = calc_timeout_nsec(attr_timeout);
+	arg.generation = generation;
 	convert_stat(attr, &arg.attr);
 
 	return send_reply_ok(req, &arg, size);
 }
 
+int fuse_reply_attr(fuse_req_t req, const struct stat *attr,
+		    double attr_timeout)
+{
+	return do_reply_attr(req, attr, attr_timeout, 0);
+}
+
+int fuse_reply_attr_with_generation(fuse_req_t req, const struct stat *attr,
+				    double attr_timeout, uint64_t generation)
+{
+	/* The kernel ignores the field unless FUSE_ATTR_GENERATION was
+	   negotiated; don't put surprises in what is then a dummy field. */
+	if (!(req->se->conn.capable_ext & FUSE_CAP_ATTR_GENERATION))
+		generation = 0;
+
+	return do_reply_attr(req, attr, attr_timeout, (uint32_t) generation);
+}
+
 int fuse_reply_readlink(fuse_req_t req, const char *linkname)
 {
 	return send_reply_ok(req, linkname, strlen(linkname));
@@ -2746,6 +2764,8 @@ _do_init(fuse_req_t req, const fuse_ino_t nodeid, const void *op_in,
 			se->conn.capable_ext |= FUSE_CAP_NO_EXPORT_SUPPORT;
 		if (inargflags & FUSE_OVER_IO_URING)
 			se->conn.capable_ext |= FUSE_CAP_OVER_IO_URING;
+		if (inargflags & FUSE_ATTR_GENERATION)
+			se->conn.capable_ext |= FUSE_CAP_ATTR_GENERATION;
 
 	} else {
 		se->conn.max_readahead = 0;
@@ -2904,6 +2924,8 @@ _do_init(fuse_req_t req, const fuse_ino_t nodeid, const void *op_in,
 		outargflags |= FUSE_OVER_IO_URING;
 		enable_io_uring = true;
 	}
+	if (se->conn.want_ext & FUSE_CAP_ATTR_GENERATION)
+		outargflags |= FUSE_ATTR_GENERATION;
 
 	if ((inargflags & FUSE_REQUEST_TIMEOUT) && se->conn.request_timeout) {
 		outargflags |= FUSE_REQUEST_TIMEOUT;
diff --git a/lib/fuse_versionscript b/lib/fuse_versionscript
index b58360f..a9373bb 100644
--- a/lib/fuse_versionscript
+++ b/lib/fuse_versionscript
@@ -220,6 +220,8 @@ FUSE_3.18 {
 
 		fuse_reply_statx;
 		fuse_fs_statx;
+
+		fuse_reply_attr_with_generation;
 } FUSE_3.17;
 
 # Local Variables:
