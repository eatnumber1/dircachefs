common --enable_bzlmod
# MODULE.bazel.lock pins the Debian packages (rules_distroless's apt extension
# records the resolved package list and sha256s there): never rewrite it
# silently. Change a pin with `bazel mod deps --lockfile_mode=update`.
common --lockfile_mode=error

build --cxxopt -std=c++20
build --copt -Wno-sign-compare
build --copt -Werror
build --copt -Wimplicit-fallthrough
build --copt -D_FILE_OFFSET_BITS=64
build --disk_cache=~/.cache/bazel-disk-cache
# Keep the shared disk cache bounded: Bazel garbage-collects it down to
# this size while the server is idle.
build --experimental_disk_cache_gc_max_size=50G

# --copt -Werror above also applies to external repositories' own compiles.
# The libfuse module (BCR overlay) pulls in liburing, which has -Wunused-
# parameter warnings that are not errors upstream; without this, building
# anything that depends on @libfuse//:libfuse fails. Scope -Werror back off
# for code under external/ only; our own sources are unaffected.
build --per_file_copt=external/.*@-Wno-error
# Same for the -Wimplicit-fallthrough above (sqlite3 and libfuse still warn
# under clang): not ours.
build --per_file_copt=external/.*@-Wno-implicit-fallthrough

# PROJECT DECISION: dcfs requires root, so there is no host-side test
# execution -- every test (unit tests included) boots the project's own
# kernel under QEMU as root (see test/qemu/qemu_cc_test.bzl and
# test/qemu/README.md). `bazel test //...` therefore runs everything with
# no tag filter; the e2e tests (tagged "e2e") are just bigger/slower, not
# excluded by default.
test --test_output=errors

# Test tiers (phase 6.1): a test's Bazel `size` is its tier. Plain
# `bazel test //...` runs every tier; these select the cheaper ones.
test:fast --test_size_filters=small
test:presubmit --test_size_filters=small,medium

build:asan --strip=never
build:asan --copt -fsanitize=address
build:asan --copt -DADDRESS_SANITIZER
build:asan --copt -O1
build:asan --copt -g
build:asan --copt -fno-omit-frame-pointer
build:asan --linkopt -fsanitize=address
# Read by test/qemu:asan_build (see test/qemu/qemu_cc_test.bzl): glibc
# cannot be fully statically linked with ASan, so qemu_cc_test links
# dynamically under this config instead and ships the ldd(1) closure in
# the initramfs.
build:asan --define=dcfs_sanitizer=asan

build:ubsan --strip=never
build:ubsan --copt -fsanitize=undefined
build:ubsan --copt -fno-sanitize-recover=all
build:ubsan --copt -O1
build:ubsan --copt -g
build:ubsan --copt -fno-omit-frame-pointer
build:ubsan --linkopt -fsanitize=undefined
build:ubsan --linkopt -fno-sanitize-recover=all
# See test:asan's --define above; UBSan's runtime has the same problem in
# practice.
build:ubsan --define=dcfs_sanitizer=ubsan

# Per-checkout settings that are not committed (e.g. the agent lane
# clones' `startup --max_idle_secs=...`). See docs/plan/process.md.
try-import %workspace%/user.bazelrc
