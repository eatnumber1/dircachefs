common --enable_bzlmod
# MODULE.bazel.lock pins the Debian packages (rules_distroless's apt extension
# records the resolved package list and sha256s there): never rewrite it
# silently. Change a pin with `bazel mod deps --lockfile_mode=update`.
common --lockfile_mode=error

# Never fall back to a host compiler: the toolchain is the pinned clang
# (MODULE.bazel; -std=c++20 is set there).
build --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
build --copt -D_FILE_OFFSET_BITS=64
build --disk_cache=~/.cache/bazel-disk-cache
# Keep the shared disk cache bounded: Bazel garbage-collects it down to
# this size while the server is idle.
build --experimental_disk_cache_gc_max_size=50G

# Warnings: every warning in our code is an error, compile and link, and
# external repositories (abseil, libfuse, liburing, numactl, SQLite, ...)
# build with their own flags only. --per_file_copt takes `regex,-regex@flags`
# (include, exclude); Bazel applies it to a source when its label OR its
# path is included, so an external source (label `@@abseil-cpp+//...`, path
# `external/...`) must be excluded by both, and everything else is ours. The
# regexes cannot contain `@` (the filter ends at the first one): `\\x40` is it
# (the rc file parser takes one backslash away). -Wno-sign-compare goes away
# with phase 7.3's -Weverything.
build --per_file_copt=.*,-external/.*,-\\x40.*@-Werror,-Wimplicit-fallthrough,-Wno-sign-compare
# The linker has no such scope: --linkopt reaches every link in the graph,
# which are ours and the pjdfstest binaries (third-party code built by our
# overlay), and all of them link without a warning. tools/warnings/ and
# //dcfs:warning_flags_*_test check these flags on the command lines.
build --linkopt -Wl,--fatal-warnings

# Warnings clang still prints for external code that builds with its own
# flags (they are not errors there, and not ours to fix):
# - liburing: its BCR overlay builds with -Wall -Wextra, where upstream's
#   Makefile adds -Wno-unused-parameter; the stub io_uring_register_wait_reg()
#   warns on every build.
# - google_benchmark: mutex.h's annotated Lock/Unlock wrapper trips
#   -Wthread-safety-analysis (clang only; upstream builds with it).
build --per_file_copt=liburing[+]/@-Wno-unused-parameter
build --per_file_copt=google_benchmark[+]/@-Wno-thread-safety-analysis

# Link statically everywhere: the daemon ships fully static in an initramfs.
# This also keeps Bazel from building a useless .so for every cc_binary's
# first-party libraries under `//...`. The BCR libfuse shared library does not
# link anyway (it never did, under ld.gold or lld 22): the overlay omits
# -Wl,--version-script, and lld rejects the .symver-versioned symbols of
# lib/fuse_versionscript in a -shared link ("symbol foo@FUSE_3.0 has undefined
# version"); no libfuse .so is ever built with this flag.
build --dynamic_mode=off

# PROJECT DECISION: dcfs requires root, so there is no host-side test
# execution -- every test (unit tests included) boots the project's own
# kernel under QEMU as root (see test/qemu/qemu_cc_test.bzl and
# test/qemu/README.md). `bazel test //...` therefore runs everything with
# no tag filter; the e2e tests (tagged "e2e") are just bigger/slower, not
# excluded by default.
test --test_output=errors

# Test tiers (phase 6.1): a test's Bazel `size` is its tier. Plain
# `bazel test //...` runs every tier; these select the cheaper ones.
test:fast --test_size_filters=small
test:presubmit --test_size_filters=small,medium

build:asan --strip=never
build:asan --copt -fsanitize=address
build:asan --copt -DADDRESS_SANITIZER
build:asan --copt -O1
build:asan --copt -g
build:asan --copt -fno-omit-frame-pointer
build:asan --linkopt -fsanitize=address
# cc_wrapper.sh runs the C driver (bin/clang), which links only the C part of
# the runtime; the C++ part (alloc-dealloc-mismatch, new-delete-type-mismatch)
# needs this (//dcfs:asan_runtime_test).
build:asan --linkopt -fsanitize-link-c++-runtime
# Read by test/qemu:asan_build (see test/qemu/qemu_cc_test.bzl): glibc
# cannot be fully statically linked with ASan, so qemu_cc_test links
# dynamically under this config instead and ships the ldd(1) closure in
# the initramfs.
build:asan --define=dcfs_sanitizer=asan

build:ubsan --strip=never
build:ubsan --copt -fsanitize=undefined
# clang 22's -fsanitize=undefined does not include vptr (the compile line
# shows fsanitize=alignment,array-bounds,...,vla-bound only): name it
# (//dcfs:ubsan_runtime_test).
build:ubsan --copt -fsanitize=vptr
build:ubsan --copt -fno-sanitize-recover=all
build:ubsan --copt -O1
build:ubsan --copt -g
build:ubsan --copt -fno-omit-frame-pointer
build:ubsan --linkopt -fsanitize=undefined
build:ubsan --linkopt -fsanitize=vptr
# The vptr check lives in ubsan_standalone_cxx (see build:asan).
build:ubsan --linkopt -fsanitize-link-c++-runtime
build:ubsan --linkopt -fno-sanitize-recover=all
# See test:asan's --define above; UBSan's runtime has the same problem in
# practice.
build:ubsan --define=dcfs_sanitizer=ubsan

# Step 7.2: `bazel coverage //...` measures our code (dcfs, bench, tools; not
# tests and not external repositories) with clang's source-based coverage
# (the toolchain's `coverage` feature: -fprofile-instr-generate
# -fcoverage-mapping). Why Bazel's native coverage and not a --config: the
# toolchain already provides the feature, Bazel computes which sources are
# instrumented, and its lcov merger and combined report (the one file CI
# publishes, bazel-out/_coverage/_coverage_report.dat) are free. The QEMU test
# macros ship the guest's profiles out and add their lcov to COVERAGE_DIR
# (test/qemu/coverage.bzl, scripts/run-qemu.sh, README.md "Coverage").
# (-^//dcfs:modules_: the kernel-module archives are genrules over Alpine's
# kernel files, 911 baseline records of code that is not ours.)
coverage --instrumentation_filter=^//(dcfs|bench|tools)[/:],-^//dcfs:modules_
coverage --combined_report=lcov

# Per-checkout settings that are not committed (e.g. the agent lane
# clones' `startup --max_idle_secs=...`). See docs/plan/process.md.
try-import %workspace%/user.bazelrc
