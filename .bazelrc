common --enable_bzlmod

build --cxxopt -std=c++20
build --copt -Wno-sign-compare
build --copt -Werror
build --copt -Wimplicit-fallthrough
build --copt -D_FILE_OFFSET_BITS=64
build --disk_cache=~/.cache/bazel-disk-cache
# Keep the shared disk cache bounded: Bazel garbage-collects it down to
# this size while the server is idle.
build --experimental_disk_cache_gc_max_size=50G

# --copt -Werror above also applies to external repositories' own compiles.
# The libfuse module (BCR overlay) pulls in liburing, which has -Wunused-
# parameter warnings that are not errors upstream; without this, building
# anything that depends on @libfuse//:libfuse fails. Scope -Werror back off
# for code under external/ only; our own sources are unaffected.
build --per_file_copt=external/.*@-Wno-error

# The BCR libfuse overlay's shared-library output doesn't link with ld.gold
# (the overlay omits -Wl,--version-script, so the .symver-tagged symbols in
# lib/fuse_versionscript have no version nodes to bind to); link statically
# everywhere, which we want anyway since the daemon ships fully static in an
# initramfs.
build --dynamic_mode=off

# PROJECT DECISION: dcfs requires root, so there is no host-side test
# execution -- every test (unit tests included) boots the project's own
# kernel under QEMU as root (see test/qemu/qemu_cc_test.bzl and
# test/qemu/README.md). `bazel test //...` therefore runs everything with
# no tag filter; the e2e tests (tagged "e2e") are just bigger/slower, not
# excluded by default.
test --test_output=errors

build:asan --strip=never
build:asan --copt -fsanitize=address
build:asan --copt -DADDRESS_SANITIZER
build:asan --copt -O1
build:asan --copt -g
build:asan --copt -fno-omit-frame-pointer
build:asan --linkopt -fsanitize=address
# Read by test/qemu:asan_build (see test/qemu/qemu_cc_test.bzl): glibc
# cannot be fully statically linked with ASan, so qemu_cc_test links
# dynamically under this config instead and ships the ldd(1) closure in
# the initramfs.
build:asan --define=dcfs_sanitizer=asan

# Phase 6.3: the --copt flags above apply to every C/C++ compile, external
# repositories included -- same leak the "external/.*@-Wno-error" rule
# above this block already documents and fixes for -Werror. Confirmed by
# reading the generated build_script.sh/compile lines: without this,
# --config=asan also recompiles glib/zlib (and glib's own pcre2 dependency)
# with ASan instrumentation purely to feed third_party/qemu's
# rules_foreign_cc build (which separately leaks the same flags into
# QEMU's own CFLAGS/LDFLAGS -- see that BUILD file's own fix) -- confirmed
# with `bazel query 'somepath(//dcfs:main_static, @glib//glib)'` and
# '...@zlib)': both empty, i.e. dcfs never links either, so there is no
# ABI reason to instrument them, and doing so only adds rebuild time and
# makes the *separate* qemu-system-x86_64 process slower, which is what
# actually runs every guest.
#
# This is deliberately narrow -- NOT "external/.*" -- and must stay that
# way: a first attempt did scope it to every external repo and broke
# //dcfs:metadata_cache_test with a real SEGV inside
# absl::container_internal::raw_hash_set (abseil's SwissTable
# "generation" iterator-debugging feature gives hash tables a different
# in-memory layout depending on the same ASan detection -- see
# absl/container/internal/raw_hash_set.h's
# ABSL_SWISSTABLE_ENABLE_GENERATIONS). dcfs's own translation units are
# compiled *with* ASan (seeing the layout with generations);
# de-sanitizing abseil-cpp's precompiled .cc files made their shared,
# non-template helpers (raw_hash_set.cc) disagree about that same layout
# -- an ABI mismatch, not a flag-scoping bug. The same risk applies to
# every other external repo dcfs/tools/qemu_cc_test binaries actually
# link (libfuse, sqlite3, numactl, liburing, googletest): they must keep
# matching dcfs's own sanitizer settings, so only glib/zlib/pcre2 (used
# exclusively by the separate-process qemu-system-x86_64, confirmed above
# to be unreachable from dcfs) are safe to exclude this way. pjdfstest --
# also third-party and also never linked into dcfs (its own separate
# guest binary, no ABI coupling) -- gets the same treatment directly in
# its own BUILD file instead, a cleaner, more obviously-correct place for
# it than stretching this regex to match its external repo too.
build:asan --per_file_copt=external/(glib|zlib|pcre2)\+.*@-fno-sanitize=address,-UADDRESS_SANITIZER

build:ubsan --strip=never
build:ubsan --copt -fsanitize=undefined
build:ubsan --copt -fno-sanitize-recover=all
build:ubsan --copt -O1
build:ubsan --copt -g
build:ubsan --copt -fno-omit-frame-pointer
build:ubsan --linkopt -fsanitize=undefined
build:ubsan --linkopt -fno-sanitize-recover=all
# See test:asan's --define above; UBSan's runtime has the same problem in
# practice.
build:ubsan --define=dcfs_sanitizer=ubsan

# See build:asan's identical fix (and the abseil-cpp SwissTable ABI
# mismatch it documents) above for the full explanation.
build:ubsan --per_file_copt=external/(glib|zlib|pcre2)\+.*@-fno-sanitize=undefined

# Per-checkout settings that are not committed (e.g. the agent lane
# clones' `startup --max_idle_secs=...`). See docs/plan/process.md.
try-import %workspace%/user.bazelrc
