# SPDX-License-Identifier: MIT
# clang-tidy configuration (plan step 25.21; step 7.5's check set, russ,
# 2026-10-10). //tools:style_checks_test runs the pinned LLVM's clang-tidy
# with this file over our C++ (dcfs/, bench/, tools/) with the build's own
# flags, as Bazel actions (tools/style_checks.bzl). A finding is an error;
# the findings that existed when a check was switched on are listed in
# tools/style_checks_allow.txt (file, function, check), a list that only
# shrinks. 7.5's remaining piece is a per-target aspect that fails the build
# itself; 25.21 lands the aspect with the verdict in the test.
#
# Enabled: the groups that enforce the Google style guide (google-*), the
# Abseil rules of docs/style.md 1.2 (abseil-*), and the correctness and
# readability groups of step 7.5. Not enabled: cppcoreguidelines-* (not our
# guide) except cppcoreguidelines-macro-usage (docs/style.md
# rule-macros-discouraged), llvm-*, fuchsia-*, hicpp-*, altera-*, android-*, boost-*, mpi-*,
# objc-*, openmp-*, zircon-*, linuxkernel-* (other projects' rules), and
# clang-analyzer-*: the path-sensitive analyzer takes minutes per test file
# (fsck_test.cc: 120 s of 140 s, dir_cache_fs_test.cc over 20 min), which does
# not belong in a test of tier small.
#
# Denied, each with its reason (tools/style_checks.py checks that every
# denied check has a line here, `#   check: reason`):
#   abseil-unchecked-statusor-access: crashes clang-tidy 22.1.8 in its dataflow analysis of absl::StatusOr (statusor_internal.h), in any file that includes it.
#   modernize-use-trailing-return-type: Google style writes the return type first.
#   readability-identifier-length: short names (i, fd, n) are idiomatic in small scopes; Google style asks for descriptive names, not a minimum length.
#   misc-const-correctness: Google style does not require const locals; the check wants every local const.
#   bugprone-throwing-static-initialization: dcfs uses no exceptions; the findings are gtest's TEST() registrations.
#   cert-err58-cpp: the same finding as bugprone-throwing-static-initialization.
#   readability-braces-around-statements: Google style allows a short if or loop body on one line without braces; google-readability-braces-around-statements enforces the Google form.
#   readability-magic-numbers: syscall flags, errno values, sizes and mode bits are the content of a syscall layer; the check wants a named constant for each.
#   readability-uppercase-literal-suffix: Google style has no rule on the case of a literal suffix.
#   misc-non-private-member-variables-in-classes: Google style allows structs with public data and classes with protected data in tests.
#   modernize-use-auto: Google style allows auto only where it helps the reader; the check wants it wherever a type is spelled twice.
#   modernize-use-nodiscard: style 1.2 puts [[nodiscard]] on results the caller must handle, not on every const getter.
#   bugprone-easily-swappable-parameters: no rule of ours; the fix (strong types) is out of proportion for pairs like (fd, flags).
#   bugprone-reserved-identifier: the link-time fakes (-Wl,--wrap) are named __wrap_open and __real_open by the linker.
#   cert-dcl37-c: the same finding as bugprone-reserved-identifier.
#   cert-dcl51-cpp: the same finding as bugprone-reserved-identifier.
#   readability-named-parameter: Google style allows leaving an unused parameter unnamed.
#   modernize-use-ranges: style 1.2 uses absl::c_* container algorithms, not std::ranges.
#   performance-enum-size: no rule of ours; shrinking an enum's underlying type changes layout for no measured gain.
#   modernize-use-std-format: style 1.2 formats with absl::StrFormat, StrCat and PrintF, not std::format.
#   modernize-avoid-c-arrays: the arrays are the shapes of kernel and libfuse structures (uuid[16], name[256]) and buffers handed to syscalls; style 1.2 asks for absl::FixedArray only where the size is known when the buffer is made.
Checks: >
  -*,
  google-*,
  abseil-*,
  bugprone-*,
  cert-*,
  concurrency-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  cppcoreguidelines-macro-usage,
  -abseil-unchecked-statusor-access,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -misc-const-correctness,
  -bugprone-throwing-static-initialization,
  -cert-err58-cpp,
  -readability-braces-around-statements,
  -readability-magic-numbers,
  -readability-uppercase-literal-suffix,
  -misc-non-private-member-variables-in-classes,
  -modernize-use-auto,
  -modernize-use-nodiscard,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,
  -cert-dcl37-c,
  -cert-dcl51-cpp,
  -readability-named-parameter,
  -modernize-use-ranges,
  -performance-enum-size,
  -modernize-use-std-format,
  -modernize-avoid-c-arrays
WarningsAsErrors: '*'
HeaderFilterRegex: '^(\./)?(dcfs|tools|bench|test/qemu/guest)/'
CheckOptions:
  readability-function-cognitive-complexity.Threshold: 15
  # The complexity of what is written, not of what a macro expands to: an
  # EXPECT_EQ or a RETURN_IF_ERROR is one line to its reader.
  readability-function-cognitive-complexity.IgnoreMacros: true
  readability-implicit-bool-conversion.AllowPointerConditions: true
  # docs/style.md 1.2, Google's naming (step 25.58). Functions and methods are
  # not here: clang-tidy can only exempt a lower-case name everywhere
  # (FunctionIgnoredRegexp), not in one namespace, so the CamelCase rule and
  # its syscall-wrapper exception are the clang-query matcher
  # tools/style_matchers/function_names.query.
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.TypeTemplateParameterCase: CamelCase
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.VariableCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.PublicMemberCase: lower_case
  readability-identifier-naming.PrivateMemberCase: lower_case
  readability-identifier-naming.PrivateMemberSuffix: _
  readability-identifier-naming.ProtectedMemberCase: lower_case
  readability-identifier-naming.ProtectedMemberSuffix: _
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.EnumConstantPrefix: k
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantPrefix: k
  # Google makes kName optional for automatic constants: lower_case, or kName.
  readability-identifier-naming.LocalConstantCase: lower_case
  readability-identifier-naming.LocalConstantIgnoredRegexp: '^k[A-Z][A-Za-z0-9]*$'
  readability-identifier-naming.StaticConstantCase: CamelCase
  readability-identifier-naming.StaticConstantPrefix: k
  # Static data members of a class take the name_ form, as the other members
  # do. Google gives a struct's statics no underscore; none exist here.
  readability-identifier-naming.ClassMemberCase: lower_case
  readability-identifier-naming.ClassMemberSuffix: _
  readability-identifier-naming.ClassConstantCase: CamelCase
  readability-identifier-naming.ClassConstantPrefix: k
  # Macros take the DCFS_ prefix and UPPER_CASE. The ignore regex below holds
  # the header-guard pattern (a real guard ends in _H_; the scan of
  # //tools:approved_macros_test checks that a name ending in _H_ is a guard
  # in structure, so no other macro hides behind the pattern) and, generated
  # from tools/approved_macros.txt, every exempt and third_party name (the
  # Google-internal mirrors, the private helpers that end in an underscore,
  # libraries' names).
  readability-identifier-naming.MacroDefinitionPrefix: DCFS_
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  readability-identifier-naming.MacroDefinitionIgnoredRegexp: '^(ASSERT_OK_AND_ASSIGN|CHECK|DCFS_RET_CHECK_ELSE_BLOCKER_|DCFS_RET_CHECK_OP_|E|EXPECT_HELPER|F|FUSE_USE_VERSION|LOG|RETURN_IF_ERROR|RET_CHECK|RET_CHECK_EQ|RET_CHECK_GE|RET_CHECK_GT|RET_CHECK_LE|RET_CHECK_LT|RET_CHECK_NE|RET_CHECK_OK|[A-Z][A-Z0-9_]*_H_)$'
  # Macros are discouraged (docs/style.md 1.2, rule-macros-discouraged). The
  # approved ones are tools/approved_macros.txt; the ignore regex above and the
  # AllowedRegexp below are generated from it (bazel run
  # //tools:approved_macros -- --write). The approval of every macro is
  # enforced by the source scan of //tools:approved_macros_test, because this
  # check reports only function-like, variadic and all-literal macros. It is
  # kept for its constexpr and inline-function advice; a finding of it also
  # means: a new macro needs russ's approval; report it instead of adding it
  # to tools/approved_macros.txt. CheckCapsOnly is false, without which
  # AllowedRegexp is not consulted at all.
  cppcoreguidelines-macro-usage.CheckCapsOnly: false
  cppcoreguidelines-macro-usage.AllowedRegexp: '^(ASSERT_OK_AND_ASSIGN|CHECK|DCFS_ASSERT_OK_AND_ASSIGN_IMPL|DCFS_BACKSTOP|DCFS_INJECT|DCFS_RET_CHECK_ELSE_BLOCKER_|DCFS_RET_CHECK_OP_|DCFS_TEST_CONCAT|DCFS_TEST_CONCAT_INNER|E|EXPECT_HELPER|F|FUSE_USE_VERSION|LOG|RETURN_IF_ERROR|RET_CHECK|RET_CHECK_EQ|RET_CHECK_GE|RET_CHECK_GT|RET_CHECK_LE|RET_CHECK_LT|RET_CHECK_NE|RET_CHECK_OK)$'
