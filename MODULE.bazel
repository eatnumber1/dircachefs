# QEMU 11.1.2 (pinned latest stable release as of 2026-10-05; see
# third_party/qemu/README.md for the update procedure and the full
# configure/device/dependency rationale). build_file replaces QEMU's
# (nonexistent) root BUILD file with the configure_make overlay;
# 0001-add-dcfs-device-config.patch adds the checked-in minimal device
# config (--with-devices-x86_64=dcfs needs it present in the source tree
# at configure time; it cannot be passed as a bare flag value).
#
# A plain http_archive is not enough here: --enable-fdt=internal needs
# the subprojects/dtc subproject, which the release tarball ships as a
# real git checkout -- but Bazel's own repository-fetching tar extraction
# drops that whole directory (confirmed empirically: unlike BUILD-file
# glob(), which merely skips dotfiles/dotdirs and leaves a directory's
# other files alone, extracting past a path containing a real ".git"
# apparently drops the *entire* containing directory; every other
# subprojects/* entry survives extraction fine). qemu_repo.bzl's
# custom repository rule fetches dtc separately (from the exact commit
# subprojects/dtc.wrap already names) directly into subprojects/dtc via
# download_and_extract's own output= placement, which is a
# repository-rule-level operation not subject to either kind of dotfile
# dropping. See qemu_repo.bzl's docstring for the full story.
qemu_repo = use_repo_rule("//third_party/qemu:qemu_repo.bzl", "qemu_repo")

qemu_repo(
    name = "qemu",
    build_file = "//third_party/qemu:BUILD.qemu",
    dtc_sha256 = "e115f987eec23a1ba25150a46ced1675de3716072d3b4905afb3a9cda0f007c7",
    dtc_strip_prefix = "dtc-b6910bec11614980a21e46fbccc35934b671bd81",
    dtc_url = "https://gitlab.com/qemu-project/dtc/-/archive/b6910bec11614980a21e46fbccc35934b671bd81/dtc-b6910bec11614980a21e46fbccc35934b671bd81.tar.gz",
    patch_strip = 1,
    patches = ["//third_party/qemu:0001-add-dcfs-device-config.patch"],
    sha256 = "731b5681e4bb18be313231579b8efd0296c5b015fa36dc533874b639ba838016",
    strip_prefix = "qemu-11.1.2",
    url = "https://download.qemu.org/qemu-11.1.2.tar.xz",
)

# Phase 4, part c (third_party/debian/): the Debian NFS-test rootfs image,
# replacing test/qemu/scripts/mkrootfs-debian.sh's mmdebstrap run.
# rules_distroless's apt extension resolves and fetches a pinned package
# list from a fixed snapshot.debian.org timestamp; third_party/debian/
# assembles the result into an ext4 image. See third_party/debian/README.md
# for the package list (with each package's reason), the snapshot pin and
# its update procedure.
bazel_dep(name = "rules_distroless", version = "0.9.4")

apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = ["bookworm"],
    types = ["deb"],
    uris = ["https://snapshot.debian.org/archive/debian/20261004T203145Z"],
)
apt.install(
    dependency_set = "debian",
    packages = [
        "attr",
        "bash",
        "btrfs-progs",
        "coreutils",
        "diffutils",
        "e2fsprogs",
        "findutils",
        "grep",
        "iproute2",
        "mawk",
        "mount",
        "nfs-common",
        "nfs-kernel-server",
        "procps",
        "quota",
        "strace",
        "systemd",
        "systemd-sysv",
        "util-linux",
        "xfsprogs",
    ],
    suites = ["bookworm"],
)
use_repo(apt, "debian")

# busybox 1.38.0 (pinned latest stable release as of 2026-10-05; see
# third_party/busybox/README.md). build_file_content just exposes the
# pristine source tree -- the actual build (Kconfig fragment -> allnoconfig
# -> silentoldconfig -> make) is a genrule in third_party/busybox/BUILD.bazel,
# not a configure_make: busybox's own build system is a Kconfig/make tree,
# not configure+make or meson.
http_archive(
    name = "busybox",
    build_file_content = """\
filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)

exports_files(["Makefile"])
""",
    sha256 = "34f9ea6ff8636f2c9241153b9114eefa9e65674a45318ae1ef95bb5f31c53bb2",
    strip_prefix = "busybox-1.38.0",
    url = "https://busybox.net/downloads/busybox-1.38.0.tar.bz2",
)
