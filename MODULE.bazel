# pjdfstest (step 4.5): github.com/pjd/pjdfstest, pinned to the current
# master commit as of 2026-09-27. See third_party/pjdfstest/BUILD.pjdfstest
# for how it's built (no autoconf; config.h is hand-written for Linux/
# glibc) and 0001-linux-portability.patch for the two guest-shell fixes
# (tests/conf's filesystem-type detection, tests/misc.sh's use of
# `openssl md5` where this project's busybox-only guest has no openssl).
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "pjdfstest",
    build_file = "//third_party/pjdfstest:BUILD.pjdfstest",
    integrity = "sha256-IAXN2Dt2IEF3zxNnkrHyBYp0GLT8WyA/USdKaYVH11Q=",
    patch_args = ["-p1"],
    patches = ["//third_party/pjdfstest:0001-linux-portability.patch"],
    strip_prefix = "pjdfstest-85a8aea9e685999ef0540392fd80535f873d7ff7",
    url = "https://github.com/pjd/pjdfstest/archive/85a8aea9e685999ef0540392fd80535f873d7ff7.tar.gz",
)



# Phase 4, part c (third_party/debian/): the Debian NFS-test rootfs image,
# replacing test/qemu/scripts/mkrootfs-debian.sh's mmdebstrap run.
# rules_distroless's apt extension resolves and fetches a pinned package
# list from a fixed snapshot.debian.org timestamp; third_party/debian/
# assembles the result into an ext4 image. See third_party/debian/README.md
# for the package list (with each package's reason), the snapshot pin and
# its update procedure.
bazel_dep(name = "rules_distroless", version = "0.9.4")

apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = ["bookworm"],
    types = ["deb"],
    uris = ["https://snapshot.debian.org/archive/debian/20261006T082722Z"],
)
# Step 5.3b: security fixes. bookworm-updates is in the same archive as
# bookworm; bookworm-security is the separate debian-security archive, at
# a snapshot of the same day (timestamps differ: each archive has its own snapshot runs).
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = ["bookworm-updates"],
    types = ["deb"],
    uris = ["https://snapshot.debian.org/archive/debian/20261006T082722Z"],
)
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = ["bookworm-security"],
    types = ["deb"],
    uris = ["https://snapshot.debian.org/archive/debian-security/20261006T081244Z"],
)
apt.install(
    dependency_set = "debian",
    packages = [
        "attr",
        "bash",
        "btrfs-progs",
        "coreutils",
        "diffutils",
        "e2fsprogs",
        "findutils",
        "grep",
        "iproute2",
        "mawk",
        "mount",
        "nfs-common",
        "nfs-kernel-server",
        "procps",
        "quota",
        "strace",
        "systemd",
        "systemd-sysv",
        "util-linux",
        "xfsprogs",
    ],
    suites = ["bookworm", "bookworm-updates", "bookworm-security"],
)
use_repo(apt, "debian")

# Phase 12.1: the TLA+ model checker (third_party/tlaplus/). TLC ships as
# one jar (tla2tools.jar, the v1.7.4 stable release; v1.8.0 is a rolling
# pre-release whose asset changes, so it cannot be pinned) and runs on a
# hermetic JDK: rules_java's remote JDK 21, used directly (not through
# --java_runtime_version, whose default is the host's local_jdk). See
# third_party/tlaplus/README.md for the pin and update procedure.
bazel_dep(name = "rules_java", version = "9.3.0")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "tla2tools",
    downloaded_file_path = "tla2tools.jar",
    sha256 = "936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88",
    urls = ["https://github.com/tlaplus/tlaplus/releases/download/v1.7.4/tla2tools.jar"],
)

# Phase 12.2: the TLA+ CommunityModules (Json, IOUtils), which trace
# validation (formal/Trace.tla) uses to read a recorded trace. The -deps jar
# bundles the libraries its Java overrides need. A dated release asset, so
# the hash stays valid; see third_party/tlaplus/README.md.
http_file(
    name = "tla_community_modules",
    downloaded_file_path = "CommunityModules-deps.jar",
    sha256 = "dddb19c3d7596913d92c43073b60d1408ac8f6d86716af4d19dd6861a95bfb7d",
    urls = ["https://github.com/tlaplus/CommunityModules/releases/download/202610040242/CommunityModules-deps-202610040242.jar"],
)

java_toolchains = use_extension("@rules_java//java:extensions.bzl", "toolchains")
use_repo(java_toolchains, "remotejdk21_linux")

# Phase 5.2: nektos/act, which runs .github/workflows/ci.yml locally in
# containers resembling GitHub's hosted runners (also the detector for host
# dependencies the build or tests acquired by accident). A release binary,
# pinned by sha256; see third_party/act/README.md for the pin, the runner
# image digest and the update procedure.
http_archive(
    name = "act",
    build_file = "//third_party/act:BUILD.act",
    sha256 = "0191d6f1f3b716b5c55820032605d05fc3c1cdbf581ebeff655019e5dd1524c0",
    urls = ["https://github.com/nektos/act/releases/download/v0.2.89/act_Linux_x86_64.tar.gz"],
)

# Step 15.0: pandoc, which renders the dcfs(8) man page from README.md in a
# Bazel genrule (//man:dcfs.8). The static Linux release binary, pinned by
# sha256; see third_party/pandoc/README.md for the update procedure.
http_archive(
    name = "pandoc",
    build_file = "//third_party/pandoc:BUILD.pandoc",
    sha256 = "67d7d011fed8c8543306022b985b9b2499ab9b74818df91d8727c7e9ebc5ba06",
    strip_prefix = "pandoc-3.12",
    urls = ["https://github.com/jgm/pandoc/releases/download/3.12/pandoc-3.12-linux-amd64.tar.gz"],
)

# Phase 5.3: Python for tools/sbom/ (the SBOM generator and its test), a
# hermetic interpreter from rules_python so that no host python is needed
# by `bazel test`. See tools/sbom/README.md.
bazel_dep(name = "rules_python", version = "1.9.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

# Phase 24: the test kernel and the host-side test tools are Alpine's
# packages of one release branch, verified against Alpine's signing keys
# (third_party/alpine/README.md). The pin is the branch: change `branch` to
# move to a new Alpine release.
use_repo(python, "python_3_12_x86_64-unknown-linux-gnu")

alpine_index = use_repo_rule("//third_party/alpine:alpine.bzl", "alpine_index")

alpine_package = use_repo_rule("//third_party/alpine:alpine.bzl", "alpine_package")

alpine_index(
    name = "alpine_index",
    branch = "v3.24",
)

alpine_package(
    name = "alpine_linux_virt",
    index = "@alpine_index//:index.json",
    packages = ["linux-virt"],
)

# QEMU and the filesystem tools run on the glibc host through musl's loader
# (third_party/alpine/README.md, "Programs"); each `tools` entry is a wrapper
# target `@alpine_<name>//:<tool>`.
alpine_package(
    name = "alpine_qemu",
    # QEMU finds its data directory from /proc/self/exe, which under the
    # loader is the loader: -L names it.
    args = [
        "-L",
        "{root}/usr/share/qemu",
    ],
    closure = True,
    env = {"QEMU_MODULE_DIR": "{root}/usr/lib/qemu"},
    index = "@alpine_index//:index.json",
    packages = ["qemu-system-x86_64"],
    tools = {"qemu_system_x86_64": "usr/bin/qemu-system-x86_64"},
)

alpine_package(
    name = "alpine_fstools",
    closure = True,
    index = "@alpine_index//:index.json",
    packages = [
        "btrfs-progs",
        "e2fsprogs",
        "e2fsprogs-extra",
        "xfsprogs",
    ],
    tools = {
        "debugfs": "usr/sbin/debugfs",
        "mke2fs": "sbin/mke2fs",
        "mkfs_btrfs": "sbin/mkfs.btrfs",
        "mkfs_xfs": "sbin/mkfs.xfs",
    },
)

alpine_package(
    name = "alpine_busybox",
    index = "@alpine_index//:index.json",
    packages = ["busybox-static"],
)

# strace for the syscall-trace goldens (step 26.3): a musl-linked dynamic
# program, run in the guest with its closure (musl, and what strace needs)
# installed at its Alpine paths by mkinitramfs.sh.
alpine_package(
    name = "alpine_strace",
    closure = True,
    index = "@alpine_index//:index.json",
    packages = ["strace"],
)
