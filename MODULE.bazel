# Phase 4, part c (third_party/debian/): the Debian NFS-test rootfs image,
# replacing test/qemu/scripts/mkrootfs-debian.sh's mmdebstrap run.
# rules_distroless's apt extension resolves and fetches a pinned package
# list from a fixed snapshot.debian.org timestamp; third_party/debian/
# assembles the result into an ext4 image. See third_party/debian/README.md
# for the package list (with each package's reason), the snapshot pin and
# its update procedure.
bazel_dep(name = "rules_distroless", version = "0.9.4")

apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = ["bookworm"],
    types = ["deb"],
    uris = ["https://snapshot.debian.org/archive/debian/20261006T082722Z"],
)
# Step 5.3b: security fixes. bookworm-updates is in the same archive as
# bookworm; bookworm-security is the separate debian-security archive, at
# a snapshot of the same day (timestamps differ: each archive has its own snapshot runs).
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = ["bookworm-updates"],
    types = ["deb"],
    uris = ["https://snapshot.debian.org/archive/debian/20261006T082722Z"],
)
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = ["bookworm-security"],
    types = ["deb"],
    uris = ["https://snapshot.debian.org/archive/debian-security/20261006T081244Z"],
)
apt.install(
    dependency_set = "debian",
    packages = [
        "attr",
        "bash",
        "btrfs-progs",
        "coreutils",
        "diffutils",
        "e2fsprogs",
        "findutils",
        "grep",
        "iproute2",
        "mawk",
        "mount",
        "nfs-common",
        "nfs-kernel-server",
        "procps",
        "quota",
        "strace",
        "systemd",
        "systemd-sysv",
        "util-linux",
        "xfsprogs",
    ],
    suites = ["bookworm", "bookworm-updates", "bookworm-security"],
)
use_repo(apt, "debian")

# busybox 1.38.0 (pinned latest stable release as of 2026-10-05; see
# third_party/busybox/README.md). build_file_content just exposes the
# pristine source tree -- the actual build (Kconfig fragment -> allnoconfig
# -> silentoldconfig -> make) is a genrule in third_party/busybox/BUILD.bazel,
# not a configure_make: busybox's own build system is a Kconfig/make tree,
# not configure+make or meson.
http_archive(
    name = "busybox",
    build_file_content = """\
filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)

exports_files(["Makefile"])
""",
    sha256 = "34f9ea6ff8636f2c9241153b9114eefa9e65674a45318ae1ef95bb5f31c53bb2",
    strip_prefix = "busybox-1.38.0",
    url = "https://busybox.net/downloads/busybox-1.38.0.tar.bz2",
)

