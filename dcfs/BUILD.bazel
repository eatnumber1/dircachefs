    hdrs = ["file_handle.h"],
    deps = [
      ":memory",
      ":device_uuid",
      ":mount_fd_cache",
      ":ret_check",
      ":status",
      ":syscalls",
      "@absl//absl/cleanup",
      "@absl//absl/functional:function_ref",
      "@absl//absl/log:die_if_null",
      "@absl//absl/status",
      "@absl//absl/status:statusor",
