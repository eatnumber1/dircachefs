# //tools:syscalls_backing_users_test (step 26.7): which targets may reach the
# backing filesystem through syscalls is a golden list
# (syscalls_backing_users.txt), so the layering rule of docs/style.md 1.8 is
# enforced by the build graph. (A genquery's scope takes labels only, so the
# universe is every test of the packages, the daemon variants and the
# benchmark library (not its binary: google_benchmark pulls a download):
# anything that links the wrappers is under one of them.)
test_suite(name = "every_test")

genquery(
    name = "syscalls_backing_users",
    expression = "rdeps(set(//dcfs:every_test //dcfs/testonly:every_test //dcfs:main //dcfs:main_static //dcfs:main_static_traced //bench:bench_lib), //dcfs:syscalls_backing, 1) - //dcfs:syscalls_backing",
    opts = [
        "--output=label",
        "--noimplicit_deps",
    ],
    scope = [
        ":every_test",
        ":main",
        ":main_static",
        ":main_static_traced",
        "//bench:bench_lib",
        "//dcfs/testonly:every_test",
    ],
    visibility = ["//tools:__pkg__"],
)

exports_files(["syscalls_backing_users.txt"])

# Our code builds with every warning an error (.bazelrc): a compile of one of
# our libraries, a link of the production binary and a link of a QEMU test
# binary. tools/warnings/BUILD.bazel has the same check for external code.
flags_test(
    name = "warning_flags_compile_test",
    size = "small",
    timeout = "short",
    mnemonic = "CppCompile",
    present = [
        "-Werror",
        "-Wimplicit-fallthrough",
    ],
    target_under_test = ":status",
)

flags_test(
    name = "warning_flags_link_test",
    size = "small",
    timeout = "short",
    mnemonic = "CppLink",
    present = ["-Wl,--fatal-warnings"],
    target_under_test = ":main",
)

flags_test(
    name = "warning_flags_test_link_test",
    size = "small",
    timeout = "short",
    mnemonic = "CppLink",
    present = ["-Wl,--fatal-warnings"],
    target_under_test = ":status_test_bin",
)
