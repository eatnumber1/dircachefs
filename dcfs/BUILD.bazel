# DirCacheFS through forged FUSE requests on a real libfuse session (no
# kernel, no mount), with link-time --wraps of name_to_handle_at,
# open_by_handle_at and syncfs that let a test run another request, or
# begin a mutation, at a backing syscall of the request (or sync point)
# under test: the interleavings coroutines will produce (see
# dir_cache_fs_test.cc); and of statx, to report inode numbers no tested
# filesystem hands out. A target of its own, so the wraps affect nothing
# else.
DIR_CACHE_FS_TEST_DEPS = [
    ":backing",
    ":context",
    ":dir_cache_fs",
    ":fuse_ops",
    ":metadata_cache",
    ":migrate",
    ":mount_fds",
    ":protocol_events",
    ":sqlite",
    ":status",
    ":syscalls",
    "//dcfs/testonly:trace_recorder",
    "@absl//absl/base:log_severity",
    "@absl//absl/log:log_entry",
    "@absl//absl/log:log_sink",
    "@absl//absl/log:log_sink_registry",
    "@absl//absl/random",
    "@absl//absl/status",
    "@absl//absl/status:status_matchers",
    "@absl//absl/status:statusor",
    "@absl//absl/strings",
    "@absl//absl/time",
    "@googletest//:gtest_main",
    "@libfuse//:libfuse",
]

DIR_CACHE_FS_TEST_WRAPS = [
    "-Wl,--wrap=name_to_handle_at",
    "-Wl,--wrap=open_by_handle_at",
    "-Wl,--wrap=statx",
    "-Wl,--wrap=syncfs",
