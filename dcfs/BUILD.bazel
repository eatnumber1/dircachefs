# Shared by :main, :main_static (the QEMU-initramfs copy, see below),
# :main_static_traced and :main_static_checked so their dependency lists
# can't drift apart. Every binary adds exactly one definition of
# MainProtocolEvents() (see protocol_events.h): :protocol_events_main in
# production, the recorder in the testonly recording build; and exactly one
# of MainInvariantChecks() (see invariant_checks.h): :invariant_checks_main
# in production, the checker in the testonly checking build.
MAIN_DEPS = [
    ":version",
    ":backing",
    ":invariant_checks",
    ":protocol_events",
    ":interrupts",
    ":session_loop",
    ":context",
    ":dir_cache_fs",
    ":file_handle",
    ":fuse_ops",
    ":metadata_cache",
    ":migrate",
    ":mount_fds",
    ":mounts_below",
    ":sqlite",
    ":status",
    ":syscalls",
    ":syscalls_backing",
    "@absl//absl/base:log_severity",
    "@absl//absl/cleanup",
    "@absl//absl/flags:flag",
    "@absl//absl/flags:parse",
    "@absl//absl/flags:usage",
    "@absl//absl/log",
    "@absl//absl/log:flags",
    "@absl//absl/log:globals",
    "@absl//absl/log:initialize",
    "@absl//absl/random",
    "@absl//absl/status",
    "@absl//absl/status:status_builder",
    "@absl//absl/status:status_macros",
    "@absl//absl/status:statusor",
    "@absl//absl/strings",
    "@absl//absl/strings:str_format",
    "@absl//absl/time",
    "@libfuse//:libfuse",
]

cc_binary(
    name = "main",
    srcs = ["main.cc"],
    deps = MAIN_DEPS + [
        ":invariant_checks_main",
        ":protocol_events_main",
