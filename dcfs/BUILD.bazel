      "@util_linux//:libmount",
    ],
)

cc_library(
    name = "ret_check",
    hdrs = ["ret_check.h"],
    deps = [
      "@absl//absl/status",
    ],
)

cc_library(
    name = "memory",
    hdrs = ["memory.h"],
)

cc_test(
    name = "smoke_test",
    srcs = ["smoke_test.cc"],
    deps = ["@googletest//:gtest_main"],
)
