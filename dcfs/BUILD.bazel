# A fully statically linked copy of :main (same sources/deps), for the QEMU
# initramfs (test/qemu), which has no dynamic loader or shared libc. Under
# --config=asan/--config=ubsan this is linked dynamically instead (see
# qemu_cc_test.bzl's identical select(), whose own comment explains why:
# glibc cannot be fully statically linked with ASan, and in practice
# UBSan's runtime has the same problem); test/qemu/scripts/mkinitramfs.sh's
# copy_deps() then copies its ldd(1) closure into the e2e initramfs, same
# as it already does for any dynamically linked qemu_cc_test binary.
cc_binary(
    name = "main_static",
    srcs = ["main.cc"],
    features = select({
        "//test/qemu:asan_build": [],
        "//test/qemu:ubsan_build": [],
        "//conditions:default": ["fully_static_link"],
    }),
    linkstatic = True,
    # //tools:banned_symbols_test (step 26.8) scans this binary and its objects.
    visibility = [
        "//test/qemu:__pkg__",
        "//tools:__pkg__",
    ],
    deps = MAIN_DEPS + [":protocol_events_main"],
)

# The testonly recording build of :main_static, for trace validation
# (formal/README.md, "Trace validation"): the same code, linked with the
# recorder's MainProtocolEvents() (dcfs/testonly/main_recorder.cc), which
# writes every protocol event to the console. Only //test/qemu's traced
# initramfs uses it.
cc_binary(
    name = "main_static_traced",
    testonly = 1,
    srcs = ["main.cc"],
    features = select({
        "//test/qemu:asan_build": [],
        "//test/qemu:ubsan_build": [],
        "//conditions:default": ["fully_static_link"],
    }),
    linkstatic = True,
    visibility = ["//test/qemu:__pkg__"],
    deps = MAIN_DEPS + ["//dcfs/testonly:main_recorder"],
)

# Every target the shipped binaries (the dynamic :main and the static
# :main_static) depend on, one label per line: //tools/sbom:sbom_test checks
# that every external repository in it has an entry in the shipped SBOM
# (tools/sbom/README.md), so a new linked dependency cannot slip past the
# vulnerability scan.
genquery(
    name = "linked_deps",
    expression = "deps(//dcfs:main) + deps(//dcfs:main_static)",
    opts = [
        "--output=label",
        "--noimplicit_deps",
        "--consistent_labels",
    ],
    scope = [
        ":main",
        ":main_static",
    ],
    visibility = [
        "//tools:__pkg__",  # //tools:shipped_deps_test (step 26.9)
        "//tools/sbom:__pkg__",
    ],
)
