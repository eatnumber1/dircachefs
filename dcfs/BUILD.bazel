# DirCacheFS through forged FUSE requests on a real libfuse session (no
# kernel, no mount), with link-time --wraps of name_to_handle_at,
# open_by_handle_at and syncfs that let a test run another request, or
# begin a mutation, at a backing syscall of the request (or sync point)
# under test: the interleavings coroutines will produce (see
# dir_cache_fs_test.cc); and of statx, to report inode numbers no tested
# filesystem hands out. A target of its own, so the wraps affect nothing
# else.
DIR_CACHE_FS_TEST_DEPS = [
    ":backing",
    ":context",
    ":dir_cache_fs",
    ":fuse_ops",
    ":interrupts",
    ":session_loop",
    ":metadata_cache",
    ":migrate",
    ":mount_fds",
    ":protocol_events",
    ":sqlite",
    ":status",
    ":syscalls",
    ":syscalls_backing",
    "//dcfs/testonly:assert_ok_and_assign",
    "//dcfs/testonly:dir_cache_fs_peer",
    "//dcfs/testonly:files",
    "//dcfs/testonly:invariant_checker",
    "//dcfs/testonly:step_counter",
    "//dcfs/testonly:trace_recorder",
    "@absl//absl/base:log_severity",
    "@absl//absl/container:flat_hash_set",
    "@absl//absl/log",
    "@absl//absl/log:initialize",
    "@absl//absl/log:log_entry",
    "@absl//absl/log:log_sink",
    "@absl//absl/log:log_sink_registry",
    "@absl//absl/random",
    "@absl//absl/status",
    "@absl//absl/status:status_matchers",
    "@absl//absl/status:statusor",
    "@absl//absl/strings",
    "@absl//absl/time",
    "@absl//absl/time:simulated_clock",
    "@googletest//:gtest_main",
    "@libfuse//:libfuse",
    "@sqlite//:sqlite3",
]

DIR_CACHE_FS_TEST_WRAPS = [
    "-Wl,--wrap=name_to_handle_at",
    "-Wl,--wrap=open_by_handle_at",
    "-Wl,--wrap=statx",
    "-Wl,--wrap=syncfs",
] + [
    # Step 26.2: the backstop under the invariant checks' hooks (see
    # NoTransactionAt in dir_cache_fs_test.cc).
    "-Wl,--wrap=" + call
    for call in [
        "copy_file_range",
        "fallocate64",
        "fchmodat",
        "fchownat",
        "fgetxattr",
        "flistxattr",
        "fremovexattr",
        "fsetxattr",
        "fstatat64",
        "fstatfs64",
        "fstatvfs64",
        "futimens",
        "getxattr",
        "linkat",
        "listxattr",
        "mkdirat",
        "mknodat",
        "openat64",
        "readlinkat",
        "removexattr",
        "renameat2",
        "setxattr",
        "symlinkat",
        "unlinkat",
        "utimensat",
    ]
]

qemu_cc_test(
    name = "dir_cache_fs_test",
    size = "small",
    # Moderate: the 1000-entry readdir work tests under ASan, and the plain
    # build too, with step 26.2's invariant checks and death tests (114
    # tests: 57.7 and 87.4 s at load 15-20, 2026-10-08; run-qemu.sh gives a
    # unit guest TEST_TIMEOUT less 60 s when that is more than 60).
    timeout = "moderate",
    # Under ASan it peaks at 687 MiB in use (MEM peak_used=703940 KiB of
    # total=1251628 at -m 1280, 2026-10-08, with step 26.2's invariant
    # checker, whose death tests keep a forked child resident beside the
    # parent; 612 MiB before it, 383 without the 1000-entry ReaddirWorkTest,
    # whose allocation churn fills ASan's 256 MiB quarantine): with the
    # kernel's 18.5 MiB, 706 + 50% rounds up to 1088 (test/qemu/README.md,
    # "Guest memory").
    asan_mem = 1088,
    srcs = ["dir_cache_fs_test.cc"],
