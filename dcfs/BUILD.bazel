exports_files(["schema.sql"])

genrule(
    name = "schema_sql_cc",
    srcs = ["schema.sql"],
    outs = ["schema_sql.cc"],
    cmd = """
set -e
printf '%s' 'namespace dcfs {
extern const char kSchemaSql[];
const char kSchemaSql[] = R"dcfs_sql(
' > $@
cat $(location schema.sql) >> $@
printf '%s' '
)dcfs_sql";
}
' >> $@
""",
)

cc_library(
    name = "schema",
    srcs = [":schema_sql_cc"],
    hdrs = ["schema.h"],
