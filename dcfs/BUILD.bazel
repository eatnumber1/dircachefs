# Trace validation (formal/README.md): runs :dir_cache_fs_test's guest and
# checks the trace of every test that records one (StartTrace) against
# formal/Trace.tla. The harness runs requests inside other requests'
# syscalls, which the kernel's directory lock would forbid: lock = False.
tla_trace_test(
    name = "dir_cache_fs_trace_test",
    size = "medium",
    timeout = "long",
    disks = ["vdb:ext4:32M"],
    initramfs = ":dir_cache_fs_test.cpio.gz",
    lock = False,
    unit = True,
)

# Test first, for trace validation itself: the harness with a fault, each
# running only the scenario it breaks; validation must reject that
# scenario's trace at the event that shows the fault. Each fault is a
# link-time --wrap fake in dcfs/testonly/ (the mangled names below are the
# C++ functions it wraps):
#   skip_mark_unknown: phase 1 does not mark names unknown (create).
#   syscall_before_phase1: an unlink's unlinkat runs before its phase 1.
#   phase3_before_syscall: an unlink's phase 3 and End run before its
#       unlinkat.
#   snapshot_after_syncfs: a sync point takes its snapshot after its
#       syncfs calls.
#   create_syscall_before_phase1: a create's syscall starts before its
#       phase 1, inside a readdir's population of the same directory.
#   swallow_syscall_error: an unlink's syscall reports an error the model
#       does not have, which the request ignores, replying OK.
BEGIN_REMOVE = "_ZN4dcfs5cache11BeginRemoveERNS_7ContextElSt17basic_string_viewIcSt11char_traitsIcEElNS0_12FillSnapshotE"

BEGIN_SYNC = "_ZN4dcfs5cache9BeginSyncERNS_7ContextE"

BEGIN_CREATE = "_ZN4dcfs5cache11BeginCreateERNS_7ContextElSt17basic_string_viewIcSt11char_traitsIcEE"

UNLINK_AT = "_ZN4dcfs7backing8UnlinkAtERNS_7ContextERKNS_11CredentialsElSt17basic_string_viewIcSt11char_traitsIcEEi"

DIR_CACHE_FS_FAULTS = {
    "skip_mark_unknown": dict(
        wraps = ["sqlite3_step"],
        test = "CreateMarksItsNameUnknown",
        # The create's phase 1, whose state has no row for "new" (the
        # model's has it unknown).
        event = "\"ev\":\"phase1\".*\"req\":\\{\"k\":\"create\",\"n\":\"new\".*\"dent\":\\[\\[\"a\",\"k:[0-9.]*\"\\]\\],\"complete\":true",
    ),
    "syscall_before_phase1": dict(
        wraps = [BEGIN_REMOVE, UNLINK_AT],
        test = "TraceScenarioUnlink",
        # The unlinkat's start, while nothing is in flight (and "a" is
        # still present).
        event = "\"c\":\"MutationSyscallStarting\",\"ev\":\"unexplained\",\"why\":\"a mutation's syscall started before its phase 1\".*\"inflight\":0\\}",
    ),
    "phase3_before_syscall": dict(
        wraps = [BEGIN_REMOVE],
        test = "TraceScenarioUnlink",
        # The reply: OK, after the mutation ended before its syscall (with
        # "a" absent by then).
        event = "\"c\":\"RequestEnd\",\"ev\":\"unexplained\",\"why\":\"a mutation ended before its syscall, and its request replied OK\".*\\[\"a\",\"absent\"\\]",
    ),
    "snapshot_after_syncfs": dict(
        wraps = [BEGIN_SYNC],
        test = "TraceScenarioMkdirDuringSync",
        # The syncfs calls' start, with no snapshot right before it.
        event = "\"c\":\"SyncfsStarting\",\"ev\":\"unexplained\",\"why\":\"a sync point's syncfs started without its snapshot right before\"",
    ),
    "create_syscall_before_phase1": dict(
        wraps = [BEGIN_CREATE],
        test = "TraceScenarioMkdirDuringListing",
        dir = "2",  # d
        # The mkdir's syscall start, written although d's lines were held
        # for the listing's reads.
        event = "\"c\":\"MutationSyscallStarting\",\"ev\":\"unexplained\",\"why\":\"a mutation's syscall started before its phase 1\"",
    ),
    "swallow_syscall_error": dict(
        wraps = [UNLINK_AT],
        test = "TraceScenarioUnlink",
        # The reply: OK, after a syscall error the model does not have.
        event = "\"c\":\"RequestEnd\",\"ev\":\"unexplained\",\"why\":\"a syscall error the model does not have: .*EBUSY.*, and its request replied OK\"",
    ),
}

[
    qemu_cc_test(
        name = "dir_cache_fs_fault_%s_test" % fault,
        size = "small",
        timeout = "short",
        srcs = ["dir_cache_fs_test.cc"],
        args = ["--gtest_filter=DirCacheFSTest." + spec["test"]],
        disks = [("vdb", "ext4", "32M")],
        linkopts = DIR_CACHE_FS_TEST_WRAPS + ["-Wl,--wrap=" + w for w in spec["wraps"]],
        deps = DIR_CACHE_FS_TEST_DEPS + ["//dcfs/testonly:" + fault],
    )
    for fault, spec in DIR_CACHE_FS_FAULTS.items()
]

[
    tla_trace_test(
        name = "trace_fault_%s_test" % fault,
        size = "medium",
        timeout = "long",
        disks = ["vdb:ext4:32M"],
        expect_reject = "DirCacheFSTest.%s@%s" % (spec["test"], spec.get("dir", "1")),
        expect_reject_event = spec["event"],
        initramfs = ":dir_cache_fs_fault_%s_test.cpio.gz" % fault,
        lock = False,
        unit = True,
    )
    for fault, spec in DIR_CACHE_FS_FAULTS.items()
]

