# SPDX-License-Identifier: MIT
# Test-only code for dcfs (AGENTS.md: test-only code lives in *_test.cc or
# in a testonly/ directory whose targets set testonly = 1).

load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//test/qemu:qemu_cc_test.bzl", "qemu_cc_test")
load("//tools:style_checks.bzl", "style_findings_here")

package(default_testonly = 1)

# The one ASSERT_OK_AND_ASSIGN for every test (the pinned Abseil has none).
cc_library(
    name = "assert_ok_and_assign",
    hdrs = ["assert_ok_and_assign.h"],
    visibility = [
        "//dcfs:__pkg__",
        "//test/qemu:__pkg__",
    ],
    deps = [
        "@absl//absl/status:status_matchers",
        "@googletest//:gtest",
    ],
)

# A thread whose /proc shows no CAP_FSETID (step 17.2e).
cc_library(
    name = "thread_without_cap_fsetid",
    hdrs = ["thread_without_cap_fsetid.h"],
    visibility = ["//dcfs:__pkg__"],
    deps = [
        "//dcfs:syscalls",
        "@absl//absl/log:check",
        "@absl//absl/status:statusor",
        "@absl//absl/strings",
        "@absl//absl/synchronization",
    ],
)

# File helpers for tests, over the syscalls:: wrappers.
cc_library(
    name = "files",
    hdrs = ["files.h"],
    visibility = [
        "//bench:__pkg__",
        "//dcfs:__pkg__",
        "//test/qemu:__pkg__",
    ],
    deps = [
        "//dcfs:syscalls",
        "//dcfs:syscalls_backing",
        "@absl//absl/algorithm:container",
        "@absl//absl/status:status_macros",
        "@absl//absl/status:statusor",
    ],
)

# Running a command from a test, over the syscalls:: wrappers (no shell).
cc_library(
    name = "process",
