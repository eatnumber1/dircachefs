qemu_cc_test(
    name = "process_test",
    size = "small",
    timeout = "short",
    srcs = ["process_test.cc"],
    deps = [
        ":process",
        "@absl//absl/status",
        "@absl//absl/status:status_matchers",
        "@googletest//:gtest_main",
    ],
)

qemu_cc_test(
