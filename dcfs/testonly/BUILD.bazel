# Test-only code for dcfs (AGENTS.md: test-only code lives in *_test.cc or
# in a testonly/ directory whose targets set testonly = 1).

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//test/qemu:qemu_cc_test.bzl", "qemu_cc_test")

package(default_testonly = 1)

# The one ASSERT_OK_AND_ASSIGN for every test (the pinned Abseil has none).
cc_library(
    name = "assert_ok_and_assign",
    hdrs = ["assert_ok_and_assign.h"],
    visibility = ["//dcfs:__pkg__"],
    deps = [
        "@absl//absl/status:status_matchers",
        "@googletest//:gtest",
    ],
)

# Counts SQLite statement steps in-process (the harness's work-counting
# tests; the same VLOG(2) lines guest/syscall_traces.sh budgets).
cc_library(
    name = "step_counter",
    hdrs = ["step_counter.h"],
    visibility = ["//dcfs:__pkg__"],
    deps = [
        "@absl//absl/log:globals",
        "@absl//absl/log:initialize",
        "@absl//absl/log:log_entry",
        "@absl//absl/log:log_sink",
        "@absl//absl/log:log_sink_registry",
        "@absl//absl/strings",
    ],
)

# File helpers for tests, over the syscalls:: wrappers.
cc_library(
    name = "files",
    hdrs = ["files.h"],
    visibility = [
        "//bench:__pkg__",
        "//dcfs:__pkg__",
    ],
    deps = [
        "//dcfs:syscalls",
        "//dcfs:syscalls_backing",
        "@absl//absl/status:status_macros",
        "@absl//absl/status:statusor",
    ],
)

# The recording ProtocolEvents for trace validation (formal/README.md,
# "Trace validation").
cc_library(
    name = "trace_recorder",
    srcs = ["trace_recorder.cc"],
    hdrs = ["trace_recorder.h"],
    visibility = ["//dcfs:__pkg__"],
    deps = [
        "//dcfs:context",
        "//dcfs:escape",
        "//dcfs:metadata_cache",
        "//dcfs:migrate",
        "//dcfs:protocol_events",
        "//dcfs:sqlite",
        "//dcfs:status",
        "//dcfs:syscalls",
        "//dcfs:syscalls_backing",
        "@absl//absl/functional:function_ref",
        "@absl//absl/log:check",
        "@absl//absl/status",
        "@absl//absl/status:statusor",
        "@absl//absl/strings",
        "@libfuse//:libfuse",
        "@sqlite//:sqlite3",
    ],
)

# MainProtocolEvents() for //dcfs:main_static_traced: the recorder, instead
# of //dcfs:protocol_events_main's no-op (link-time selection).
cc_library(
    name = "main_recorder",
    srcs = ["main_recorder.cc"],
    visibility = ["//dcfs:__pkg__"],
    deps = [
        ":trace_recorder",
        "//dcfs:protocol_events",
        "//dcfs:syscalls",
        "//dcfs:syscalls_backing",
        "@absl//absl/log:check",
        "@absl//absl/status:statusor",
    ],
)

# The fault-injected build's fault (see skip_mark_unknown.cc): wraps
# sqlite3_step, so the binary must link with -Wl,--wrap=sqlite3_step.
cc_library(
    name = "skip_mark_unknown",
    srcs = ["skip_mark_unknown.cc"],
    alwayslink = True,
    visibility = ["//dcfs:__pkg__"],
    deps = ["@sqlite//:sqlite3"],
)

# More faults, each for one fault build of //dcfs:dir_cache_fs_test (see
# dcfs/BUILD.bazel's DIR_CACHE_FS_FAULTS, which also lists the wraps each
# needs).
cc_library(
    name = "syscall_before_phase1",
    srcs = ["fault_syscall_before_phase1.cc"],
    alwayslink = True,
    visibility = ["//dcfs:__pkg__"],
    deps = [
        "//dcfs:backing",
        "//dcfs:context",
        "//dcfs:credentials",
        "//dcfs:metadata_cache",
        "@absl//absl/status",
        "@absl//absl/status:statusor",
    ],
)

cc_library(
    name = "phase3_before_syscall",
    srcs = ["fault_phase3_before_syscall.cc"],
    alwayslink = True,
    visibility = ["//dcfs:__pkg__"],
    deps = [
        "//dcfs:context",
        "//dcfs:metadata_cache",
        "@absl//absl/status:statusor",
    ],
)

cc_library(
    name = "snapshot_after_syncfs",
    srcs = ["snapshot_after_syncfs.cc"],
    alwayslink = True,
    visibility = ["//dcfs:__pkg__"],
    deps = [
        "//dcfs:context",
        "//dcfs:metadata_cache",
        "//dcfs:syscalls",
        "//dcfs:syscalls_backing",
        "@absl//absl/status",
        "@absl//absl/status:statusor",
    ],
)

# The recorder's own decisions (what it explains, cuts or calls
# unexplained), on an in-memory cache.
qemu_cc_test(
    name = "trace_recorder_test",
    size = "small",
    timeout = "short",
    srcs = ["trace_recorder_test.cc"],
    deps = [
        ":assert_ok_and_assign",
        ":files",
        ":trace_recorder",
        "//dcfs:context",
        "//dcfs:device_id",
        "//dcfs:file_handle",
        "//dcfs:metadata_cache",
        "//dcfs:migrate",
        "//dcfs:mount_fds",
        "//dcfs:protocol_events",
        "//dcfs:sqlite",
        "//dcfs:status",
        "//dcfs:syscalls",
        "//dcfs:syscalls_backing",
        "@absl//absl/random",
        "@absl//absl/status",
        "@absl//absl/status:status_matchers",
        "@absl//absl/status:statusor",
        "@absl//absl/strings",
        "@googletest//:gtest_main",
        "@libfuse//:libfuse",
    ],
)

cc_library(
    name = "create_syscall_before_phase1",
    srcs = ["create_syscall_before_phase1.cc"],
    alwayslink = True,
    visibility = ["//dcfs:__pkg__"],
    deps = [
        "//dcfs:context",
        "//dcfs:metadata_cache",
        "@absl//absl/status:statusor",
    ],
)

cc_library(
    name = "swallow_syscall_error",
    srcs = ["swallow_syscall_error.cc"],
    alwayslink = True,
    visibility = ["//dcfs:__pkg__"],
    deps = [
        "//dcfs:context",
        "//dcfs:credentials",
        "//dcfs:metadata_cache",
        "//dcfs:status",
        "@absl//absl/status",
    ],
)

# The C++ sources, for //tools:raw_syscalls_test.
filegroup(
    name = "cxx_sources",
    srcs = glob(["*.cc", "*.h"]),
    visibility = ["//tools:__pkg__"],
)

# Every test of this package, for //dcfs:syscalls_backing_users's scope.
test_suite(
    name = "every_test",
    visibility = ["//dcfs:__pkg__"],
)
