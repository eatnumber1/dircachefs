# Test-only code for dcfs (AGENTS.md: test-only code lives in *_test.cc or
# in a testonly/ directory whose targets set testonly = 1).

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//test/qemu:qemu_cc_test.bzl", "qemu_cc_test")

package(default_testonly = 1)

# The one ASSERT_OK_AND_ASSIGN for every test (the pinned Abseil has none).
cc_library(
    name = "assert_ok_and_assign",
    hdrs = ["assert_ok_and_assign.h"],
    visibility = ["//dcfs:__pkg__"],
    deps = [
        "@absl//absl/status:status_matchers",
        "@googletest//:gtest",
    ],
)

# File helpers for tests, over the syscalls:: wrappers.
cc_library(
    name = "files",
    hdrs = ["files.h"],
    visibility = [
        "//bench:__pkg__",
        "//dcfs:__pkg__",
    ],
    deps = [
        "//dcfs:syscalls",
        "//dcfs:syscalls_backing",
        "@absl//absl/status:status_macros",
        "@absl//absl/status:statusor",
    ],
)

# The recording ProtocolEvents for trace validation (formal/README.md,
# "Trace validation").
cc_library(
    name = "trace_recorder",
    srcs = ["trace_recorder.cc"],
    hdrs = ["trace_recorder.h"],
    visibility = ["//dcfs:__pkg__"],
    deps = [
        "//dcfs:context",
        "//dcfs:escape",
        "//dcfs:metadata_cache",
        "//dcfs:migrate",
        "//dcfs:protocol_events",
        "//dcfs:sqlite",
        "//dcfs:status",
        "//dcfs:syscalls",
        "//dcfs:syscalls_backing",
        "@absl//absl/functional:function_ref",
        "@absl//absl/log:check",
        "@absl//absl/status",
        "@absl//absl/status:statusor",
        "@absl//absl/strings",
        "@libfuse//:libfuse",
        "@sqlite//:sqlite3",
    ],
)

# MainProtocolEvents() for //dcfs:main_static_traced: the recorder, instead
# of //dcfs:protocol_events_main's no-op (link-time selection).
cc_library(
    name = "main_recorder",
    srcs = ["main_recorder.cc"],
    visibility = ["//dcfs:__pkg__"],
    deps = [
        ":checking_observers",
        ":observers",
        ":trace_recorder",
        "//dcfs:protocol_events",
        "//dcfs:syscalls",
        "//dcfs:syscalls_backing",
        "@absl//absl/log:check",
        "@absl//absl/status:statusor",
    ],
)

# DirCacheFS's in-memory bookkeeping, for the invariant checker and its
# tests (DirCacheFS names the peer as a friend).
cc_library(
    name = "dir_cache_fs_peer",
    hdrs = ["dir_cache_fs_peer.h"],
    visibility = ["//dcfs:__pkg__"],
    deps = [
        "//dcfs:dir_cache_fs",
        "//dcfs:metadata_cache",
        "//dcfs:syscalls",
        "@absl//absl/container:flat_hash_map",
        "@absl//absl/container:flat_hash_set",
        "@absl//absl/functional:function_ref",
    ],
)

# The runtime invariant checks (step 26.2; docs/design.md, "Runtime
# invariant checks"): the checks of the testonly observer.
cc_library(
    name = "invariant_checker",
    srcs = ["invariant_checker.cc"],
    hdrs = ["invariant_checker.h"],
    visibility = ["//dcfs:__pkg__"],
    deps = [
        ":dir_cache_fs_peer",
        "//dcfs:context",
        "//dcfs:dir_cache_fs",
        "//dcfs:escape",
        "//dcfs:metadata_cache",
        "//dcfs:protocol_events",
        "//dcfs:sqlite",
        "//dcfs:status",
        "//dcfs:syscalls_backing",
        "@absl//absl/container:flat_hash_map",
        "@absl//absl/container:flat_hash_set",
        "@absl//absl/log",
        "@absl//absl/status",
        "@absl//absl/status:status_macros",
        "@absl//absl/status:statusor",
        "@absl//absl/strings",
        "@absl//absl/types:source_location",
        "@sqlite//:sqlite3",
    ],
)

# The testonly observer's other parts (step 26.4b): several observers as
# one, and the cost counters.
cc_library(
    name = "observers",
    hdrs = ["observers.h"],
    visibility = ["//dcfs:__pkg__"],
    deps = [
        "//dcfs:protocol_events",
        "@absl//absl/status",
        "@absl//absl/types:source_location",
    ],
)

cc_library(
    name = "cost_counter",
    srcs = ["cost_counter.cc"],
    hdrs = ["cost_counter.h"],
    visibility = ["//dcfs:__pkg__"],
    deps = [
        ":invariant_checker",
        "//dcfs:context",
        "//dcfs:protocol_events",
        "//dcfs:syscalls_backing",
        "@absl//absl/strings",
        "@absl//absl/types:source_location",
    ],
)

# The testonly daemon's checker and counter (checking_observers.h).
cc_library(
    name = "checking_observers",
    srcs = ["checking_observers.cc"],
    hdrs = ["checking_observers.h"],
    deps = [
        ":cost_counter",
        ":invariant_checker",
        ":observers",
        "//dcfs:syscalls_backing",
        "@absl//absl/log",
        "@absl//absl/log:check",
        "@absl//absl/status:statusor",
    ],
)

# MainProtocolEvents() for //dcfs:main_static_checked: the checker and the
# counter, instead of //dcfs:protocol_events_main's no-op (link-time
# selection).
cc_library(
    name = "main_invariant_checker",
    srcs = ["main_invariant_checker.cc"],
    visibility = ["//dcfs:__pkg__"],
    deps = [
        ":checking_observers",
        "//dcfs:protocol_events",
    ],
)

# The fault-injected build's fault (see skip_mark_unknown.cc): wraps
# sqlite3_step, so the binary must link with -Wl,--wrap=sqlite3_step.
cc_library(
    name = "skip_mark_unknown",
    srcs = ["skip_mark_unknown.cc"],
    alwayslink = True,
    visibility = ["//dcfs:__pkg__"],
    deps = ["@sqlite//:sqlite3"],
)

# More faults, each for one fault build of //dcfs:dir_cache_fs_test (see
# dcfs/BUILD.bazel's DIR_CACHE_FS_FAULTS, which also lists the wraps each
# needs).
cc_library(
    name = "syscall_before_phase1",
    srcs = ["fault_syscall_before_phase1.cc"],
    alwayslink = True,
    visibility = ["//dcfs:__pkg__"],
    deps = [
        "//dcfs:backing",
        "//dcfs:context",
        "//dcfs:credentials",
        "//dcfs:metadata_cache",
        "@absl//absl/status",
        "@absl//absl/status:statusor",
    ],
)

cc_library(
    name = "phase3_before_syscall",
    srcs = ["fault_phase3_before_syscall.cc"],
    alwayslink = True,
    visibility = ["//dcfs:__pkg__"],
    deps = [
        "//dcfs:context",
        "//dcfs:metadata_cache",
        "@absl//absl/status:statusor",
    ],
)

cc_library(
    name = "snapshot_after_syncfs",
    srcs = ["snapshot_after_syncfs.cc"],
    alwayslink = True,
    visibility = ["//dcfs:__pkg__"],
    deps = [
        "//dcfs:context",
        "//dcfs:metadata_cache",
        "//dcfs:syscalls",
        "//dcfs:syscalls_backing",
        "@absl//absl/status",
        "@absl//absl/status:statusor",
    ],
)

# The recorder's own decisions (what it explains, cuts or calls
# unexplained), on an in-memory cache.
qemu_cc_test(
    name = "trace_recorder_test",
    size = "small",
    timeout = "short",
    srcs = ["trace_recorder_test.cc"],
    deps = [
        ":assert_ok_and_assign",
        ":files",
        ":trace_recorder",
        "//dcfs:context",
        "//dcfs:device_id",
        "//dcfs:file_handle",
        "//dcfs:metadata_cache",
        "//dcfs:migrate",
        "//dcfs:mount_fds",
        "//dcfs:protocol_events",
        "//dcfs:sqlite",
        "//dcfs:status",
        "//dcfs:syscalls",
        "//dcfs:syscalls_backing",
        "@absl//absl/random",
        "@absl//absl/status",
        "@absl//absl/status:status_matchers",
        "@absl//absl/status:statusor",
        "@absl//absl/strings",
        "@googletest//:gtest_main",
        "@libfuse//:libfuse",
    ],
)

cc_library(
    name = "create_syscall_before_phase1",
    srcs = ["create_syscall_before_phase1.cc"],
    alwayslink = True,
    visibility = ["//dcfs:__pkg__"],
    deps = [
        "//dcfs:context",
        "//dcfs:metadata_cache",
        "@absl//absl/status:statusor",
    ],
)

cc_library(
    name = "swallow_syscall_error",
    srcs = ["swallow_syscall_error.cc"],
    alwayslink = True,
    visibility = ["//dcfs:__pkg__"],
    deps = [
        "//dcfs:context",
        "//dcfs:credentials",
        "//dcfs:metadata_cache",
        "//dcfs:status",
        "@absl//absl/status",
    ],
)

# The C++ sources, for //tools:raw_syscalls_test.
filegroup(
    name = "cxx_sources",
    srcs = glob(["*.cc", "*.h"]),
    visibility = ["//tools:__pkg__"],
)

# Every test of this package, for //dcfs:syscalls_backing_users's scope.
test_suite(
    name = "every_test",
    visibility = ["//dcfs:__pkg__"],
)
