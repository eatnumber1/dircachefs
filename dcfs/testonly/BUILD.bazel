    deps = [
        ":assert_ok_and_assign",
        ":files",
        "//dcfs:syscalls",
        "//dcfs:syscalls_backing",
        "@absl//absl/status",
        "@absl//absl/status:status_matchers",
        "@absl//absl/strings",
        "@googletest//:gtest_main",
    ],
)

proto_library(
    name = "status_wire_proto",
    srcs = ["status_wire.proto"],
)

cc_proto_library(
    name = "status_wire_cc_proto",
    deps = [":status_wire_proto"],
)

# The one place that serializes an absl::Status, payloads included (a child
