# The TLA+ model of dcfs's write-through protocol: see README.md.
#
# Every target runs TLC on the host (no root, no kernel control: the QEMU
# rule in AGENTS.md does not apply). The model's own configurations must
# find no error; each known-bug variant must produce exactly its expected
# counterexample.

load("//third_party/tlaplus:tlc.bzl", "tlc_test")

MODEL = [
    "MC.tla",
    "MClitmus.tla",
    "dcfs.tla",
]

# The real model. MC_small: every request kind and invariant, today's
# kernel locking. MC_liveness: RecoveryTerminates. Timeout of small_test:
# 1,479,307 distinct states since step 12.11's attribute change; at about
# 80 us per state on the CI runner that is about 120 s, but 12 min alone
# at load 13 on russ's machine, past "moderate"'s 300 s. The others stay
# "moderate": recovery 39,635 states (about 3 s on the runner, 19 s at
# load 13), liveness 146,504 (about 12 s; 104 s), interrupt 280,869 (about
# 22 s; 136 s).
tlc_test(
    name = "small_test",
    size = "medium",
    timeout = "long",
    config = "MC_small.cfg",
    spec = "MC.tla",
    srcs = ["dcfs.tla"],
)

tlc_test(
    name = "recovery_test",
    size = "medium",
    timeout = "moderate",
    config = "MC_recovery.cfg",
    spec = "MC.tla",
    srcs = ["dcfs.tla"],
)

tlc_test(
    name = "liveness_test",
    size = "medium",
    config = "MC_liveness.cfg",
    spec = "MC.tla",
    srcs = ["dcfs.tla"],
)

