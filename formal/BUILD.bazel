# The TLA+ model of dcfs's write-through protocol: see README.md.
#
# Every target runs TLC on the host (no root, no kernel control: the QEMU
# rule in AGENTS.md does not apply). The model's own configurations must
# find no error; each known-bug variant must produce exactly its expected
# counterexample.

load("//third_party/tlaplus:tlc.bzl", "tlc_test")

MODEL = [
    "MC.tla",
    "dcfs.tla",
]

# The real model. MC_small: every request kind and invariant, today's
# kernel locking (about a minute). MC_liveness: RecoveryTerminates.
tlc_test(
    name = "small_test",
    size = "medium",
    config = "MC_small.cfg",
    spec = "MC.tla",
    srcs = ["dcfs.tla"],
)

tlc_test(
    name = "liveness_test",
    size = "medium",
    config = "MC_liveness.cfg",
    spec = "MC.tla",
    srcs = ["dcfs.tla"],
)

# Larger bounds (about ten minutes on four cores).
tlc_test(
    name = "large_test",
    size = "large",
    timeout = "long",
    config = "MC_large.cfg",
    spec = "MC.tla",
    srcs = ["dcfs.tla"],
)

# Without the kernel's directory lock (the coroutine future); a few
# minutes.
tlc_test(
    name = "nolock_test",
    size = "large",
    timeout = "long",
    config = "MC_nolock.cfg",
    spec = "MC.tla",
    srcs = ["dcfs.tla"],
)

# Test first, for the model itself: each historical bug (from
# docs/plan/audits/, or found by this model), re-introduced, must be found.
KNOWN_BUGS = {
    "crash_f1_phase1_not_durable": "Invariant CacheNeverWrong is violated",
    "crash_f3_create_keeps_parent_attrs": "Invariant TriState is violated",
    "tristate_f1_unguarded_fills": "Invariant TriState is violated",
    "tristate_f4_restore_complete": "Invariant TriState is violated",
    # Found by this model (formerly findings/); fixed in plan step R4.
    "sync_during_mutation": "Invariant CrashSafe is violated",
    "readdirplus_unlocked": "Invariant ServedFromCacheIsCurrent is violated",
    "rename_stale_source": "Invariant CacheNeverWrong is violated",
}

[
    tlc_test(
        name = "known_bug_%s_test" % bug,
        size = "medium",
        config = "known_bugs/%s.cfg" % bug,
        expect_violation = violation,
        spec = "known_bugs/%s.tla" % bug,
        srcs = MODEL,
    )
    for bug, violation in KNOWN_BUGS.items()
]

# The revalidation model (reval.tla; README.md, "The revalidation model"):
# what dcfs reuses across a change of the backing state. MC_reval: every
# invariant, changes through dcfs only; MC_reval_oob: the flags part with
# changes behind dcfs's back; MC_reval_liveness: CachedDecisionsConverge.
REVAL = [
    "MCreval.tla",
    "reval.tla",
]

tlc_test(
    name = "reval_test",
    size = "medium",
    timeout = "moderate",
    config = "MC_reval.cfg",
    spec = "MCreval.tla",
    srcs = ["reval.tla"],
)

tlc_test(
    name = "reval_oob_test",
    size = "medium",
    timeout = "moderate",
    config = "MC_reval_oob.cfg",
    spec = "MCreval.tla",
    srcs = ["reval.tla"],
)

tlc_test(
    name = "reval_liveness_test",
    size = "medium",
    timeout = "moderate",
    config = "MC_reval_liveness.cfg",
    spec = "MCreval.tla",
    srcs = ["reval.tla"],
)

# Its known bugs (each a few seconds).
REVAL_KNOWN_BUGS = {
    # Phase 23 (found by copy_test, review L-b), fixed in 23.7.
    "reval_no_recheck": "Invariant OpenFlagsExact is violated",
    # The flags_changed-only re-check, with changes behind dcfs's back.
    "reval_recheck_if_changed": "Invariant OpenFlagsExact is violated",
    # Review M1 of Phase 23, fixed in 23.7.
    "reval_casefold_passed_through": "Invariant DirCacheNeverWrong is violated",
    # Review L1 and L-a of Phase 23, fixed in 23.7.
    "reval_no_write_fd": "Invariant WriteFdHeld is violated",
    "reval_write_fd_last_writer": "Invariant WriteFdKeepsOffsets is violated",
}

[
    tlc_test(
        name = "known_bug_%s_test" % bug,
        size = "small",
        timeout = "short",
        config = "known_bugs/%s.cfg" % bug,
        expect_violation = violation,
        spec = "known_bugs/%s.tla" % bug,
        srcs = REVAL,
    )
    for bug, violation in REVAL_KNOWN_BUGS.items()
]

# The flags_changed-only re-check under exclusive access: no violation (the
# trade the code declined, known_bugs/reval_recheck_if_changed.tla).
tlc_test(
    name = "reval_recheck_if_changed_exclusive_test",
    size = "medium",
    timeout = "moderate",
    config = "known_bugs/reval_recheck_if_changed_exclusive.cfg",
    spec = "known_bugs/reval_recheck_if_changed.tla",
    srcs = REVAL,
)

# What exclusive access buys: with changes behind dcfs's back, each of these
# must fail as limitations/reval_out_of_band.tla says.
REVAL_LIMITATIONS = {
    "out_of_band_mode": "Invariant OpenModeNeverGrantsMore is violated",
    "out_of_band_casefold": "Invariant DirCacheNeverWrong is violated",
    "out_of_band_stale": "Temporal properties were violated",
}

[
    tlc_test(
        name = "limitation_%s_test" % limitation,
        size = "small",
        timeout = "short",
        config = "limitations/%s.cfg" % limitation,
        expect_violation = violation,
        spec = "limitations/reval_out_of_band.tla",
        srcs = REVAL,
    )
    for limitation, violation in REVAL_LIMITATIONS.items()
]

# Trace validation (README.md, "Trace validation"): the spec, its
# configuration and the script the tla_trace_test targets run (in //dcfs and
# //test/qemu, next to the guests that record the traces).
exports_files(
    [
        "RevalTrace.cfg",
        "RevalTrace.tla",
        "Trace.cfg",
        "Trace.tla",
        "dcfs.tla",
        "reval.tla",
        "trace_validate.sh",
    ],
    visibility = ["//visibility:public"],
)

# Trace.tla's own tests: hand-written traces (trace_tests/*.log, lines as
# the recorder writes them) checked without a guest. Each states what it
# shows.
load(":trace.bzl", "tla_trace_log_test")

TRACE_TESTS = {
    # A directory created by a mkdir starts empty (its backing directory
    # is), and its cached state may say complete with no entries: valid.
    "origin_mkdir_fresh": None,
    # ... but not with a cached entry: no initial state matches.
    "origin_mkdir_with_entry": "\"ev\":\"begin\",\"origin\":\"mkdir\"",
    # A directory first seen in its parent's listing starts with an
    # incomplete listing of its own (EnsureDirectory): one that says
    # complete is rejected.
    "origin_listing_complete": "\"ev\":\"begin\",\"origin\":\"listing\"",
    # Recovery makes a clean directory's dentry unknown when the object it
    # points at was dirty (a, whose key is among the dirty inodes'): valid.
    "recover_forgets_dirty_child": None,
    # ... but not when that object was clean (only b's key was dirty).
    "recover_forgets_clean_child": "\"ev\":\"recover\"",
}

[
    tla_trace_log_test(
        name = "trace_%s_test" % test,
        size = "small",
        expect_reject = "t@2" if event else "",
        expect_reject_event = event or "",
        log = "trace_tests/%s.log" % test,
    )
    for test, event in TRACE_TESTS.items()
]

# The validator's root check (--root): the root trace must have events and
# reach the run's final event (clean or stop_clear, with nothing of the run
# after it), or end at a cut of a category in root_cuts.
ROOT_TESTS = {
    # Valid: begin, the shutdown's steps, clean.
    "root_reaches_clean": None,
    # A root with only its begin line.
    "root_without_events": "ROOT WITHOUT EVENTS",
    # A root that just stops (no cut, no end line) before the run ends.
    "root_stops": "ROOT CUT SHORT: t@2 ends before the run's final event",
    # The root ends at clean, but the run went on after it.
    "root_not_the_final_event": "ROOT CUT SHORT: t@2 ends before the run's final event",
    # With no root cuts allowed, a gone line or a cut whose category does
    # not parse still ends the root short.
    "root_gone": "ROOT CUT SHORT: t@2 ends before the end of the run",
    "root_cut_unparsable": "ROOT CUT SHORT: t@2 ends before the end of the run",
}

[
    tla_trace_log_test(
        name = "trace_%s_test" % test,
        size = "small",
        expect_validator_failure = failure or "",
        log = "trace_tests/%s.log" % test,
        root = "t@2",
    )
    for test, failure in ROOT_TESTS.items()
]

# A writable open sharing a read-write fd, refused (EPERM).
REFUSED_WRITABLE_OPEN = "\"ev\":\"open\",\"mode\":\"w\",\"shared\":true,\"errno\":1,"

# RevalTrace.tla's own tests: files' traces recorded by
# //dcfs:dir_cache_fs_trace_test (trace_tests/reval_*.log, the lines of one
# harness test each), checked against reval.tla and against its known-bug
# variants as the model (trace_tests/reval_<bug>.cfg). Each entry: the log,
# the variant (None: the real model), and the event the first rejection
# must be at (None: the trace must be valid).
REVAL_TRACE_TESTS = {
    # WritableOpenAfterChattrThroughDcfsIsRefused: open O_RDWR, chattr +i
    # through dcfs, open O_WRONLY refused (EPERM), ...: valid.
    "reval_chattr_through_dcfs": ("reval_chattr_through_dcfs", None, None),
    # ... and as the pre-23.7 model, which grants that open: rejected there.
    "reval_chattr_through_dcfs_no_recheck": (
        "reval_chattr_through_dcfs",
        "reval_no_recheck",
        REFUSED_WRITABLE_OPEN,
    ),
    # ... as the flags_changed-only re-check: the chattr went through dcfs,
    # so it re-checks too: valid.
    "reval_chattr_through_dcfs_recheck_if_changed": (
        "reval_chattr_through_dcfs",
        "reval_recheck_if_changed",
        None,
    ),
    # WritableOpenOfAnImmutableFileIsRefused: the same with chattr +i made
    # behind dcfs's back ("oob"): valid; rejected at the refused open by
    # both variants (the flags_changed-only re-check does not see it).
    "reval_chattr_out_of_band": ("reval_chattr_out_of_band", None, None),
    "reval_chattr_out_of_band_no_recheck": (
        "reval_chattr_out_of_band",
        "reval_no_recheck",
        REFUSED_WRITABLE_OPEN,
    ),
    "reval_chattr_out_of_band_recheck_if_changed": (
        "reval_chattr_out_of_band",
        "reval_recheck_if_changed",
        REFUSED_WRITABLE_OPEN,
    ),
    # AnAppendingWriterKeepsTheFirstWritersFd: a read-only shared fd, an
    # O_WRONLY open (write fd "plain"), an O_WRONLY|O_APPEND one (still
    # "plain"), writes: valid; the variant that hands the write fd to the
    # last writer is rejected at the O_APPEND open.
    # ChmodAndChattrOfAnOpenFileMatchTheRevalModel: chmod, chattr +a, a
    # chmod refused (EPERM), the opens the flag decides, chattr -a, chmod:
    # valid; with the refused chmod edited to succeed, rejected there (the
    # backing filesystem refuses a mode change of an append-only file).
    "reval_chmod_and_chattr": ("reval_chmod_and_chattr", None, None),
    "reval_chmod_of_append_only": (
        "reval_chmod_of_append_only",
        None,
        "\"i\":6,.*\"ev\":\"chmod\",\"errno\":0",
    ),
    "reval_appending_writer": ("reval_appending_writer", None, None),
    "reval_appending_writer_write_fd_last_writer": (
        "reval_appending_writer",
        "reval_write_fd_last_writer",
        "\"ev\":\"open\",\"mode\":\"wa\",.*\"wfd\":\"plain\"",
    ),
}

[
    tla_trace_log_test(
        name = "trace_%s_test" % test,
        size = "small",
        timeout = "short",
        expect_reject = "reval/t@2" if event else "",
        expect_reject_event = event or "",
        log = "trace_tests/%s.log" % log,
        reval_cfg = "trace_tests/%s.cfg" % cfg if cfg else None,
    )
    for test, (log, cfg, event) in REVAL_TRACE_TESTS.items()
]
