# Trace.tla's own tests: hand-written traces (trace_tests/*.log, lines as
# the recorder writes them) checked without a guest. Each states what it
# shows.
load(":trace.bzl", "tla_trace_log_test")

TRACE_TESTS = {
    # A directory created by a mkdir starts empty (its backing directory
    # is), and its cached state may say complete with no entries: valid.
    "origin_mkdir_fresh": None,
    # ... but not with a cached entry: no initial state matches.
    "origin_mkdir_with_entry": "\"ev\":\"begin\",\"origin\":\"mkdir\"",
    # A directory first seen in its parent's listing starts with an
    # incomplete listing of its own (EnsureDirectory): one that says
    # complete is rejected.
    "origin_listing_complete": "\"ev\":\"begin\",\"origin\":\"listing\"",
    # Recovery makes a clean directory's dentry unknown when the object it
    # points at was dirty (a, whose key is among the dirty inodes'): valid.
    "recover_forgets_dirty_child": None,
    # ... but not when that object was clean (only b's key was dirty).
    "recover_forgets_clean_child": "\"ev\":\"recover\"",
    # Step 12.7b, the reply's errno (T_Reply): a create whose syscall
    # failed with EEXIST replies EEXIST (17): valid.
    "reply_create_eexist": None,
    # ... but a reply that says success (errno 0) after that failed
    # syscall is rejected at the reply.
    "reply_create_eexist_replied_ok": "\"ev\":\"reply\",\"p\":\"p1\",\"errno\":0",
    # An unlink whose resolve found nothing replies ENOENT (2, the errno it
    # sent: RemoveChild replies it itself): valid.
    "reply_unlink_absent": None,
    # ... but a reply of success (errno 0) there is rejected at the reply.
    "reply_unlink_absent_replied_ok": "\"ev\":\"reply\",\"p\":\"p1\",\"errno\":0",
    # A lookup's reply carries LookupOrPopulate's answer ("ans"): the
    # object its resolve probed is valid ...
    "reply_lookup_answer": None,
    # ... a negative entry after that probe is rejected at the reply.
    "reply_lookup_answer_wrong": "\"ev\":\"reply\",\"p\":\"p1\",\"errno\":0,\"ans\":\"neg\"",
    # Step 12.11: an attribute change of the directory, its End a line of
    # its own: valid ...
    "attr_change": None,
    # ... and without its end line (a Mutation::End skipped) rejected at
    # the refresh's statx that follows.
    "attr_change_end_skipped": "\"ev\":\"stat\"",
}

[
    tla_trace_log_test(
        name = "trace_%s_test" % test,
        size = "small",
        expect_reject = "t@2" if event else "",
        expect_reject_event = event or "",
        log = "trace_tests/%s.log" % test,
    )
    for test, event in TRACE_TESTS.items()
]

# The validator's root check (--root): the root trace must have events and
# reach the run's final event (clean or stop_clear, with nothing of the run
# after it), or end at a cut of a category in root_cuts.
ROOT_TESTS = {
    # Valid: begin, the shutdown's steps, clean.
    "root_reaches_clean": None,
    # A root with only its begin line.
    "root_without_events": "ROOT WITHOUT EVENTS",
    # A root that just stops (no cut, no end line) before the run ends.
    "root_stops": "ROOT CUT SHORT: t@2 ends before the run's final event",
    # The root ends at clean, but the run went on after it.
    "root_not_the_final_event": "ROOT CUT SHORT: t@2 ends before the run's final event",
    # With no root cuts allowed, a gone line or a cut whose category does
