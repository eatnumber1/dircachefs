# The backing filesystem's crash consistency (step 12.8; README.md, "The
# backing filesystem's crash consistency"): the protocol under the two
# weaker regimes than the sequential one the configurations above use
# (DFSCQ's metadata-prefix, Ferrite's ext4 over-approximated), every
# invariant: 356,954 distinct states under ext4 (2.7 min alone on russ's
# machine), 292,044 under metaprefix (1.4 min).
[
    tlc_test(
        name = "crash_%s_test" % regime,
        size = "medium",
        timeout = "moderate",
        config = "MC_crash_%s.cfg" % regime,
        spec = "MC.tla",
        srcs = ["dcfs.tla"],
    )
    for regime in [
        "ext4",
        "metaprefix",
    ]
]

