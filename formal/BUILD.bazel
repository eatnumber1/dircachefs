        name = "litmus_%s_test" % litmus,
        size = "small",
        timeout = "short",
        config = "MC_litmus_%s.cfg" % litmus,
        spec = "MClitmus.tla",
        srcs = [
            "MC.tla",
            "dcfs.tla",
        ],
    )
    for litmus in [
        "replace_seq",
        "create_seq",
        "fsync_file_ext4",
        "fsync_dir_ext4",
        "fsync_file_direct_metaprefix",
        "fsync_dir_direct_files_ext4",
    ]
]

