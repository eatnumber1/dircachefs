# Step 11.2: the same five power cuts as fault_power_test with a real one: the
# host kills QEMU at the cut and a second boot over the same disk images runs
# the checks (run-qemu.sh --power-cut), which validates drop-writes as a model of
# a power loss. Two boots per scenario.
qemu_test_matrix(
    name = "fault_power_kill_test",
    disks = [
        ("vdb", "ext4", "320M"),
        ("vdc", "ext4", "64M"),
    ],
    guest_script = "guest/fault_power.sh",
    modules = ["dm_flakey"],
    power_cut = [
        "before",
        "phase1",
        "phase2",
        "ahead",
        "syncpoint",
        "frozen_unlink",
        "frozen_rename",
        "atime",
        "born",
    ],
    size = "medium",
    other_size = "large",
    timeout = "long",  # run-qemu.sh gives each of its 2n boots an equal share
)

# Step 12.14: the model's abstraction of the cache database's durability
# (formal/dcfs.tla's Commit and dbOpts) against what SQLite leaves on a disk
# that reorders writes: the cache filesystem on dm-log-writes, a scripted
# run of dcfs, and every FLUSH prefix and FLUSH/FUA-respecting write subsets
# of the log replayed, recovered and judged (guest/sqlite_durability.sh).
# The matrix is over the CACHE filesystem (vdc), where the database lives;
# the backing filesystem is ext4. The log, the replay disk and the
# snapshots' store are loop devices over sparse tmpfs files (a fifth virtio
# disk's interrupt is the RTC's). The checking build: the cost counter's
# synced transactions ($DCFS_COUNTERS_FILE) are the test's record of dcfs's
# intent. Measured 2026-10-09 (host load 8-10): ext4 83 s, xfs 103 s, btrfs
# 193 s (1486 states); peak guest memory used 106-127 MiB of 384, the log
# and the replay disk in tmpfs growing with the script.
[qemu_test(
    name = "sqlite_durability_test_" + fstype,
    checked_dcfs = True,
    disks = [
        ("vdb", "ext4", "64M"),
        ("vdc", fstype, "320M"),
    ],
    guest_script = "guest/sqlite_durability.sh",
    mem = 384,
    modules = [
        "dm_log_writes",
        "dm_snapshot",
        "loop",
    ],
    size = "large",
    timeout = "long",
) for fstype in [
    "ext4",
    "xfs",
    "btrfs",
]]

alias(
    name = "sqlite_durability_test",
    actual = ":sqlite_durability_test_ext4",
)

# The same on ext4 with a short script (eight operations) and a budget of 500
# write subsets, for the presubmit tier: 52 s, 104 MiB used (2026-10-09).
qemu_test(
    name = "sqlite_durability_short_test",
    checked_dcfs = True,
    cmdline = "dcfs_sd_script=short dcfs_sd_budget=500",
    disks = [
        ("vdb", "ext4", "64M"),
        ("vdc", "ext4", "320M"),
    ],
    guest_script = "guest/sqlite_durability.sh",
    mem = 384,
    modules = [
        "dm_log_writes",
        "dm_snapshot",
        "loop",
    ],
    size = "medium",
    timeout = "moderate",
)

# Step 11.2: bounded sequences of operations with a power cut after them
# (guest/fault_ace.sh, in the manner of ACE): served == backing after every
# cut, and what an fsync through dcfs made durable is.
# The persistence points through dcfs (a) and directly on the backing
# filesystem (b), in two targets so that each fits its time limit. They boot
# the checking build although they are large: recovery is what they exercise,
# and an invariant broken on the way aborts the daemon.
qemu_test(
    name = "fault_ace_a_test",
    cmdline = "dcfs_ace_kinds=one,pair,persist,split,fixtures",
    checked_dcfs = True,
    disks = [
        ("vdb", "ext4", "128M"),
        ("vdc", "ext4", "64M"),
    ],
    guest_script = "guest/fault_ace.sh",
    asan_mem = 576,  # ASan with RAM disks: peak 338 MiB
    mem = 384,  # RAM disks (step 26.17): peak 177 MiB
    modules = ["dm_flakey"],
    ram_disks = True,
    size = "large",
    timeout = "eternal",  # 182 sequences, 3-4 s each
)

qemu_test(
    name = "fault_ace_b_test",
    cmdline = "dcfs_ace_kinds=direct,dsplit",
    checked_dcfs = True,
    disks = [
        ("vdb", "ext4", "128M"),
        ("vdc", "ext4", "64M"),
    ],
    guest_script = "guest/fault_ace.sh",
    asan_mem = 576,  # ASan with RAM disks: peak 339 MiB
    mem = 384,  # RAM disks (step 26.17): peak 179 MiB
    modules = ["dm_flakey"],
    ram_disks = True,
    size = "large",
    timeout = "long",  # 90 sequences
)

# The same, all kinds, on xfs and btrfs over four of the operations (62
# sequences each). `long` fits the asan job too: fault_ace_fs_test_xfs took 227 s
# under --config=asan (199-247 s plain; the time is VM boots and mounts).
qemu_test_matrix(
    name = "fault_ace_fs_test",
    checked_dcfs = True,
    cmdline = "dcfs_ace_ops=create,unlink,rename,replace",
    disks = [
        ("vdb", "ext4", "320M"),
        ("vdc", "ext4", "64M"),
    ],
    fstypes = [
        "xfs",
        "btrfs",
    ],
    guest_script = "guest/fault_ace.sh",
    asan_mem = 640,  # ASan with RAM disks: peak 384 MiB (xfs)
    mem = 448,  # RAM disks (step 26.17): peak 194-246 MiB (xfs the most)
    modules = ["dm_flakey"],
    ram_disks = True,
    size = "large",
    other_size = "large",
    timeout = "long",
)

# Step 26.14e: mixed-fault sequences (guest/fault_ace.sh, kind mixed): one
# operation and three events drawn from {daemon crash, a kill held in phase 3,
# power loss ahead, power loss behind, a failed phase 3, lookup, listing, sync,
# handle taken, writes dropped from here on}, judged by the path oracle and the
# identity oracle (fault_lib.sh). The large tier runs an explicit list of 22
# sequences (the first two are 23.11's: a create whose phase 3 never completed,
# a lookup that records its row, a power loss that loses the create while the
# cache keeps the row), not a seeded draw: busybox awk's rand() is not stable
# across pins, so a draw would change with the busybox pin. The list was drawn
# once, from seed 2610, with the first two added. The oracles' negative
# fixtures run first. The long tail, a seeded sample of 120 with the seed the
# noisy job passes ($DCFS_SEED), is the manual fault_ace_mixed_long_test
# targets (each sequence takes 5-8 s). Replay a sequence by naming it in
# dcfs_ace_sequences (op:event:event:event, comma-separated).
qemu_test_matrix(
    name = "fault_ace_mixed_test",
    checked_dcfs = True,
    cmdline = "dcfs_ace_kinds=mixedfixtures,mixed dcfs_ace_sequences=create:dropahead:crash3:lookup,create:dropahead:fail3:lookup,replace:listing:crash3:listing,create:handle:lookup:crash,unlink:crash3:cutahead:crash3,unlink:cutahead:crash:cutbehind,unlink:sync:sync:lookup,create:cutahead:crash:cutbehind,unlink:listing:fail3:crash3,replace:dropahead:cutahead:crash3,unlink:dropahead:dropahead:crash3,unlink:listing:crash3:listing,rename:sync:lookup:listing,replace:sync:cutbehind:crash3,create:handle:crash3:sync,create:cutahead:crash3:listing,unlink:cutbehind:sync:listing,create:lookup:listing:sync,create:sync:crash3:dropahead,rename:dropahead:crash3:dropahead,create:crash3:dropahead:handle,unlink:cutahead:lookup:dropahead",
    disks = [
        ("vdb", "ext4", "320M"),
        ("vdc", "ext4", "64M"),
    ],
    guest_script = "guest/fault_ace.sh",
    asan_mem = 640,  # ASan with RAM disks: peak 389 MiB (xfs; ext4 and btrfs not run)
    mem = 448,  # RAM disks (step 26.17): peak 194-252 MiB (xfs the most)
    modules = ["dm_flakey"],
    ram_disks = True,
    size = "large",
    other_size = "large",
    timeout = "long",
)

qemu_test_matrix(
    name = "fault_ace_mixed_long_test",
    checked_dcfs = True,
    cmdline = "dcfs_ace_kinds=mixed dcfs_ace_seed=1 dcfs_ace_count=120",
    disks = [
        ("vdb", "ext4", "320M"),
        ("vdc", "ext4", "64M"),
    ],
    guest_script = "guest/fault_ace.sh",
    asan_mem = 704,  # not measured (manual): the mixed test's 640 plus a step
    mem = 512,  # RAM disks (step 26.17): not measured (manual); the mixed test's 448 plus a step for the longer run
    modules = ["dm_flakey"],
    ram_disks = True,
    size = "large",
    other_size = "large",
    tags = ["manual"],
    timeout = "eternal",  # 120 sequences, 5-8 s each: the noisy job's long tail
)

# Step 11.6: the backing filesystem frozen (guest/fault_freeze.sh): what blocks
# (a held mutation holds the single-threaded daemon, so every request behind it,
# cached reads too), what does not, a sync point and SIGTERM during a freeze.
qemu_test_matrix(
    name = "fault_freeze_test",
    disks = [
        ("vdb", "ext4", "320M"),
        ("vdc", "ext4", "64M"),
    ],
    guest_script = "guest/fault_freeze.sh",
    asan_mem = 704,  # ASan with RAM disks: peak 410 MiB (xfs; ext4 and btrfs not run)
    mem = 448,  # RAM disks (step 26.17): peak 191-248 MiB (xfs the most)
    modules = ["dm_flakey"],
    ram_disks = True,
    size = "medium",  # about 40 s: more than the fast tier should carry
    other_size = "large",
    timeout = "moderate",
)

# Step 11.3: a failed backing operation (each failure mode of guest/fault_lib.sh
# and a flakey window that ends by itself, each over every operation class)
# leaves the record unknown, returns the error, and after the device recovers the
# same operations work and the served tree is the backing filesystem's.
qemu_test_matrix(
    name = "fault_recover_test",
    disks = [
        ("vdb", "ext4", "320M"),
        ("vdc", "ext4", "64M"),
    ],
    guest_script = "guest/fault_recover.sh",
    asan_mem = 832,  # ASan with RAM disks: peak 423 (ext4) to 507 (xfs) MiB; btrfs not run
    mem = 576,  # RAM disks (step 26.17): peak 225-333 MiB (xfs the most)
    modules = ["dm_flakey"],
    ram_disks = True,
    size = "medium",
    other_size = "large",
    timeout = "moderate",
)

# Step 11.3: guest/fault_recover.sh on btrfs WITHOUT pinning the inodes of its
# trees (dcfs_pin=0): a cold inode the device cannot read. The kernel's
# btrfs_destroy_inode warning is on record in a DISABLED_ check the script runs
# then, and run-qemu.sh expects it (only that warning, only if the guest
# reports it); dcfs's ESTALE and ENOENT replies are the SKIP lines of the log.
qemu_test(
    name = "fault_recover_btrfs_unpinned_test",
    cmdline = "dcfs_pin=0",
    disks = [
        ("vdb", "btrfs", "320M"),
        ("vdc", "ext4", "64M"),
    ],
    guest_script = "guest/fault_recover.sh",
    kernel_failure = "expected",
    asan_mem = 640,  # ASan with RAM disks: peak 381 MiB
    mem = 384,  # RAM disks (step 26.17): peak 225 MiB
    modules = ["dm_flakey"],
    ram_disks = True,
    size = "large",
    timeout = "moderate",
)

# Step 11.5: an instant crash of the backing filesystem (FS_IOC_SHUTDOWN, in
# each flavour the filesystem has; on btrfs without it, the disk turned into
# dm-error) under a running dcfs, then a remount and a restart. vdb is 320M
# for mkfs.xfs (qemu_test_matrix).
qemu_test_matrix(
    name = "fault_shutdown_test",
    disks = [
        ("vdb", "ext4", "320M"),
        ("vdc", "ext4", "64M"),
