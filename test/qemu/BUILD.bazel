# --- Trace validation (formal/README.md, "Trace validation") ---------------
#
# The e2e initramfs with the testonly recording build of dcfs
# (//dcfs:main_static_traced), which writes its protocol events to the
# serial console, and the guest scripts whose runs are checked against the
# model (formal/Trace.tla) by //formal:trace.bzl's tla_trace_test. The guest
# scripts run unchanged: the traced binary records without being asked.
genrule(
    name = "initramfs_traced",
    srcs = [
        "//dcfs:main_static_traced",
        "//tools:fhtest",
        "//tools:testutil",
        "//third_party/busybox:busybox_build",
        "guest/init",
    ] + glob(["guest/*.sh"]),
    outs = ["initramfs_traced.cpio.gz"],
    testonly = 1,
    cmd = "$(location scripts/mkinitramfs.sh) $@ " +
          "$(location //third_party/busybox:busybox_build) " +
          "$(location //dcfs:main_static_traced) " +
          "$(location //tools:fhtest) " +
          "$(location //tools:testutil) " +
          "$(location guest/init) " +
          "$(SRCS)",
    tools = ["scripts/mkinitramfs.sh"],
)

# Each run's traces may end only at the cuts listed (steps the model does
# not have; see dcfs/testonly/trace_recorder.h), and the root directory's
# trace (e2e@1) must reach the run's final event or one of root_cuts: the
# first step in that script's root the model cannot follow.
TRACED_GUEST_SCRIPTS = {
    "crash": dict(
        disks = ["vdb:ext4:320M"],
        cuts = ["cross-directory-rename", "link", "dir-attrs", "dir-itself", "failed"],
        root_cuts = ["cross-directory-rename"],
    ),
    "power": dict(
        disks = ["vdb:ext4:320M"],
        cuts = ["failed"],
        root_cuts = [],
    ),
    "rename": dict(
        disks = ["vdb:ext4:320M", "vdc:ext4:64M"],
        cuts = ["cross-directory-rename", "rename-flags", "link", "dir-itself", "boundary", "failed"],
        root_cuts = ["link"],
    ),
    "create": dict(
        disks = ["vdb:ext4:320M", "vdc:ext4:64M"],
        cuts = ["link", "out-of-band", "boundary", "dir-itself", "failed"],
        root_cuts = ["link"],
    ),
}

[
    tla_trace_test(
        name = "trace_%s_test" % script,
        size = "large",
        timeout = "long",
        allow_cuts = spec["cuts"],
        disks = spec["disks"],
        guest_script = "%s.sh" % script,
        initramfs = ":initramfs_traced",
        lock = True,
        root = "e2e@1",
        root_cuts = spec["root_cuts"],
    )
    for script, spec in TRACED_GUEST_SCRIPTS.items()
]
