    # 161 MiB to spare; asan_mem is the rule's 1.5 times the peak, 64 MiB steps.
    mem = 384,
    asan_mem = 1344,
    guest_script = "guest/destroy.sh",
    size = "large",
    # Writing 20000 files through dcfs took 328-345 s of a 356-363 s run on a
    # busy machine (about 17 ms per create, plain and ASan), 100 s on the
    # CI runner's 5 ms; headroom for a sanitizer build and a loaded host.
    timeout = "long",
)

