# Guest memory classes (step 6.2), in MiB; the measurements behind each are in
# README.md "Guest memory" (a test with neither mem= nor asan_mem= gets
# qemu_test.bzl's E2E_MEM/E2E_ASAN_MEM). Plain-build allowances are peak +
# max(50%, 128 MiB), the peak counting the kernel's 30 MiB reservation; most
# tests need only the default. Under ASan the ones that make dcfs hold
# thousands of objects grow to 430-520 MiB.
ASAN_BIG_DCFS_MEM = 832  # names, names_random, readdir_boundary, idle, pjdfstest

# The two cancellation tests list a cold 20,000-entry directory (step 22.1,
# 22.2): under ASan their dcfs holds 480-490 MiB of anonymous memory, peak_used
# 733 and 766 MiB at 1536 MiB with reclaim_scans=0, +62 MiB for the kernel's
# reservation, times 1.5, rounded up to 64 MiB. The default 384 let the OOM
# killer take dcfs (2026-10-08, CI run 37799862872).
ASAN_CANCEL_MEM = 1216

# Referenced cross-package by qemu_cc_test.bzl (loaded from dcfs/BUILD.bazel
# and any other package with unit tests) to build each test's own initramfs.
exports_files([
    "guest/init",
    "scripts/mkinitramfs.sh",
    "scripts/run-qemu.sh",
    "scripts/cov-lcov.sh",
    "scripts/check-lcov.sh",
])

# Set by --define=dcfs_sanitizer=asan/ubsan (see .bazelrc's build:asan /
# build:ubsan). qemu_cc_test uses these to skip the fully_static_link
# feature under a sanitizer: glibc cannot be fully statically linked with
# ASan (and in practice UBSan's runtime has the same problem), so those
# builds link dynamically and mkinitramfs.sh copies the libraries and the
# loader from the toolchain's glibc sysroot into the initramfs instead.
config_setting(
    name = "asan_build",
    values = {"define": "dcfs_sanitizer=asan"},
)

# `bazel coverage` (step 7.2): the QEMU test macros then
# ship the LLVM tools and the instrumented binaries to run-qemu.sh
# (coverage.bzl).
config_setting(
    name = "coverage_build",
    values = {"collect_code_coverage": "true"},
)

config_setting(
    name = "ubsan_build",
    values = {"define": "dcfs_sanitizer=ubsan"},
)

# Guest initramfs shared by every qemu_test in this package: busybox,
# dcfs (statically linked, see //dcfs:main_static), fhtest, testutil,
# guest/init, every guest/*.sh test script (installed as /tests/<basename>;
# see guest/init and scripts/mkinitramfs.sh), and (step 4.5) the pjdfstest
# binary plus its tests/ tree, installed under /pjdfstest/ (see
# //third_party/pjdfstest:BUILD.pjdfstest and guest/pjdfstest.sh).
#
# Step 26.2: two of them, alike but for dcfs. :initramfs has the plain build
# that ships (//dcfs:main_static); :initramfs_checked the testonly checking
# build (//dcfs:main_static_checked), which aborts naming the invariant when
# one fails (docs/design.md, "Runtime invariant checks"). qemu_test boots
# the checked one for the small and medium tiers (fast, presubmit) and the
# plain one for large and enormous (qemu_test.bzl, initramfs_for).
[genrule(
    name = name,
    srcs = [
        dcfs,
        "//tools:fhtest",
        "//tools:testutil",
        "//bench:dcfs_bench",
        "@pjdfstest//:pjdfstest",
        "@pjdfstest//:tests",
        "@xfstests//:fsstress",  # step 11.2b
        "@xfstests//:fsx",
        "@xfstests//:replay-log",  # step 12.14
        ":crash_states",  # step 12.14
        "@alpine_busybox//:root/bin/busybox.static",
        "@alpine_strace//:root",  # step 26.3: /usr/bin/strace and musl
        "@alpine_dmsetup//:root",  # step 11.1: /sbin/dmsetup and libdevmapper
        "//tools/kernel_bugs:guest_files",  # step 26.15: /kernel_bugs/
        "guest/init",
    ] + glob(["guest/*.sh"]) + glob(["guest/pjdfstest.*_failures"]) + [
        "guest/fault_ace_mixed.expected_failures",  # step 26.14e
        "guest/request_budgets.txt",
        "guest/syscall_budgets.txt",
    ],
    outs = [name + ".cpio.gz"],
    testonly = 1,
    cmd = GUEST_LIBS_ENV + " $(location scripts/mkinitramfs.sh) $@ " +
          "$(location @alpine_busybox//:root/bin/busybox.static) " +
          "$(location " + dcfs + ") " +
          "$(location //tools:fhtest) " +
          "$(location //tools:testutil) " +
          "$(location guest/init) " +
          "$(SRCS)",
    tools = ["scripts/mkinitramfs.sh"] + GUEST_LIBS_TOOLS,
) for name, dcfs in [
    ("initramfs", "//dcfs:main_static"),
    ("initramfs_checked", "//dcfs:main_static_checked"),
]]

# Step 12.14: reads dm-log-writes logs, writes a chosen subset of a log's
# entries to a device, cuts and forges SQLite WAL files and fingerprints the
# database a WAL recovers to (guest/sqlite_durability.sh). Statically linked
# like //tools:testutil, and for the same reason.
cc_binary(
    name = "crash_states",
    testonly = 1,
    srcs = ["crash_states.c"],
    features = select({
        ":asan_build": [],
        ":ubsan_build": [],
        "//conditions:default": ["fully_static_link"],
    }),
    linkstatic = True,
    deps = ["@sqlite//:sqlite3"],
)

qemu_test(
    name = "boot_test",
    disks = [("vdb", "ext4", "64M")],
    guest_script = "guest/boot.sh",
    size = "small",
    timeout = "moderate",
)

# Step 26.17: the check that a test's disks are in the guest's RAM when it asks
# for it (guest/ram_disks.sh): loop devices over tmpfs, formatted in the guest,
# no virtio disk, and dm-flakey dropping writes over them.
qemu_test(
    name = "ram_disks_test",
    disks = [
        ("vdb", "ext4", "64M"),
        ("vdc", "xfs", "320M"),
    ],
    guest_script = "guest/ram_disks.sh",
    asan_mem = 576,  # ASan: peak 322 MiB at 1024; at 384 the guest could not make its disks
    mem = 384,  # RAM disks (step 26.17): peak 165 MiB at 256 (min available 51)
    modules = ["dm_flakey"],
    ram_disks = True,
    size = "small",
    timeout = "moderate",
)

# Step 26.14: the quiet kernel: guest/init's sysctls (no periodic writeback,
# no cache pressure), one vCPU by default, and that a dirty page waits for a
# sync -- see guest/quiet_kernel.sh and README.md, "A quiet kernel".
# Tagged quiet-only: under DCFS_NOISY=1 (step 26.14e) it fails by design, so
# the noisy job runs with --test_tag_filters=-quiet-only and noisy_kernel_test
# is its inverse.
qemu_test(
    name = "quiet_kernel_test",
    disks = [("vdb", "ext4", "64M")],
    guest_script = "guest/quiet_kernel.sh",
    size = "small",
    tags = ["quiet-only"],
    timeout = "moderate",
)

# Step 26.14e: the inverse, the noisy run's self-check (guest/noisy_kernel.sh):
# passes only under `bazel test --test_env=DCFS_NOISY=1`, fails without it.
# manual: the push gate (the quiet default) must not run it; the noisy job
# names it, and the failing direction is exercised by kernel_mode_test (canned
# trees) and by running this target without the knob (README.md, "A noisy
# run").
qemu_test(
    name = "noisy_kernel_test",
    guest_script = "guest/noisy_kernel.sh",
    size = "small",
    tags = ["manual"],
    timeout = "short",
)

# Step 26.14e: the check that tells a quiet guest from a noisy one
# (guest/kernel_mode_lib.sh), over canned /proc trees in both directions.
sh_test(
    name = "kernel_mode_test",
    size = "small",
    timeout = "short",
    srcs = ["kernel_mode_test.sh"],
    args = ["$(location guest/kernel_mode_lib.sh)"],
    data = ["guest/kernel_mode_lib.sh"],
    target_compatible_with = HOST_ONLY_COMPATIBLE,
)

# Step 26.14e: the identity oracle (guest/fault_lib.sh identity_take and
# identity_check) over a fake fhtest, one injected violation at a time.
sh_test(
    name = "identity_oracle_test",
    size = "small",
    timeout = "short",
    srcs = ["identity_oracle_test.sh"],
    args = ["$(location guest/fault_lib.sh)"],
    data = ["guest/fault_lib.sh"],
    target_compatible_with = HOST_ONLY_COMPATIBLE,
)

# Step 23: `dcfs --help` lists every flag and `dcfs --version` works under
# the installed name -- see guest/help.sh.
qemu_test(
    name = "help_test",
    disks = [("vdb", "ext4", "64M")],
    guest_script = "guest/help.sh",
    size = "small",
    timeout = "moderate",
)

# Step 11.1: the fault-injection helper (guest/fault_lib.sh) over a disk: each
# of its modes does what it says to a filesystem on the wrapped device (the
# self-check of every Phase 11 failure test). dm-flakey is a module; dm-error is
