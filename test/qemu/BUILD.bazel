# Step 11.1: power cuts on real disks: both disks drop writes at one instant,
# placed in a mutation's phases or a sync point with fsfreeze.
qemu_test_matrix(
    name = "fault_power_test",
    disks = [
        ("vdb", "ext4", "320M"),
        ("vdc", "ext4", "64M"),
    ],
    guest_script = "guest/fault_power.sh",
    asan_mem = 704,  # ASan with RAM disks: peak 397 MiB (xfs; ext4 and btrfs not run)
    mem = 448,  # RAM disks (step 26.17): peak 198-254 MiB (xfs the most)
    modules = ["dm_flakey"],
    ram_disks = True,
    size = "small",
    other_size = "medium",
    timeout = "moderate",
