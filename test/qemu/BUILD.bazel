    disks = [
        ("vdb", "ext4", "320M"),
        ("vdc", "ext4", "64M"),
    ],
    guest_script = "guest/fault_cache.sh",
    asan_mem = 640,  # ASan with RAM disks: peak 380 MiB (xfs; ext4 and btrfs not run)
