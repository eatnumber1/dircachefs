qemu_test(
    name = "destroy_test",
    disks = [("vdb", "ext4", "2G")],
    # The written files' dentries and inodes stay pinned (dcfs's held
    # descriptors, then the test's holder), and the guest must not reclaim
    # them (destroy.sh fails, saying so, if the kernel does: kswapd would
    # evict the unpinned inodes, the kernel would send their FORGETs and dcfs
