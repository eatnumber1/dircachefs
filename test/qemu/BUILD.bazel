qemu_test_matrix(
    name = "crash_test",
    disks = [("vdb", "ext4", "320M")],
    guest_script = "guest/crash.sh",
)

# Step 4.10: the durable dirty set -- recovery after an unclean shutdown in
# which the backing filesystem lost the last mutations, sync points, and
# clean-shutdown detection.
qemu_test_matrix(
    name = "power_test",
    disks = [("vdb", "ext4", "320M")],
    guest_script = "guest/power.sh",
)

# Step 4.14: regression test for 2a4f672 (Release() leaking the backing fd
# and passthrough registration when its attribute refresh fails) -- see
# guest/release_leak.sh for how the failure is forced (a real SQLITE_BUSY
# from //tools:testutil's "sqlite-lock" subcommand).
qemu_test(
    name = "release_leak_test",
    disks = [("vdb", "ext4", "64M")],
    guest_script = "guest/release_leak.sh",
)

# Step 4.14: regression test for 49a9b9c (Readdir/Readdirplus bounded to
# the reply buffer instead of pulling every remaining directory entry from
# the cache on every call) -- see guest/readdir_boundary.sh.
qemu_test(
    name = "readdir_boundary_test",
    disks = [("vdb", "ext4", "128M")],
    guest_script = "guest/readdir_boundary.sh",
)

# Step 4.7: backing operations run with the FUSE caller's filesystem
# credentials (ownership of new objects, setgid inheritance, chown/sticky/
# truncate/utimes/xattr rules) -- see guest/credentials.sh.
qemu_test_matrix(
    name = "credentials_test",
    disks = [("vdb", "ext4", "320M")],
    guest_script = "guest/credentials.sh",
)

# Step 5.3: dcfs exported over real NFSv4 (rpc.nfsd/rpc.mountd/exportfs from
# a small Debian chroot -- see //third_party/debian:rootfs and
# guest/init's dcfs_rootfs= branch, since none of that fits in the
# busybox-only initramfs every other test here runs from). Phase 4, part c:
# this image is now resolved, fetched and assembled by Bazel from a pinned
# snapshot.debian.org timestamp (see third_party/debian/README.md) instead
# of test/qemu/scripts/mkrootfs-debian.sh's mmdebstrap run.
qemu_test(
    name = "nfs_test",
    disks = [
        ("vdb", "ext4", "256M"),
        ("vdc", "ext4", "64M"),
    ],
    guest_script = "guest/nfs.sh",
    rootfs = "//third_party/debian:rootfs",
)

# pjdfstest_test (step 4.5): POSIX conformance, ~8800 checks
# (github.com/pjd/pjdfstest) run twice -- through the dcfs mount and
# directly against the backing filesystem -- and diffed; see
# guest/pjdfstest.sh and docs/conformance.md. Step 5.2: run against ext4,
# xfs and btrfs (qemu_test_matrix below); guest/pjdfstest.sh picks the
# right per-filesystem baseline (guest/pjdfstest.<fstype>.expected_failures)
# at runtime from the detected backing filesystem. Two ~8800-check suites
# serially, each check a full FUSE round trip, comfortably exceeds
# qemu_test's default size/timeout (large/long, 900s), hence the larger
# explicit size/timeout below.
qemu_test_matrix(
    name = "pjdfstest_test",
    disks = [("vdb", "ext4", "512M")],
    guest_script = "guest/pjdfstest.sh",
    size = "enormous",
    timeout = "eternal",
)

# Step 6.3 (audit F10): objects removed while still referenced (a removed
# working directory, an O_PATH descriptor on an unlinked file) behave as on
# the backing filesystem instead of failing with ESTALE -- see
# guest/removed.sh.
qemu_test_matrix(
    name = "removed_test",
    disks = [("vdb", "ext4", "320M")],
    guest_script = "guest/removed.sh",
)
