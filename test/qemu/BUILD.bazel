load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load(":qemu_test.bzl", "qemu_test", "qemu_test_matrix")

# Referenced cross-package by qemu_cc_test.bzl (loaded from dcfs/BUILD.bazel
# and any other package with unit tests) to build each test's own initramfs.
exports_files([
    "guest/init",
    "scripts/mkinitramfs.sh",
    "scripts/run-qemu.sh",
])

# Step 3.1a: which kernel qemu_test/qemu_test_matrix boot. "patched" (the
# default) is @kernel_image//:bzImage, the out-of-tree, not-Bazel-tracked
# build of test/qemu/scripts/build-kernel.sh's patched kernel (still needed
# by everything except boot_test until Phase 3b drops the kernel patch).
# "stock" is //third_party/linux:bzImage, the pinned upstream kernel Bazel
# fetches and builds (see third_party/linux/README.md). Select with
# `--//test/qemu:kernel=stock`.
string_flag(
    name = "kernel",
    build_setting_default = "patched",
    values = [
        "patched",
        "stock",
    ],
)

config_setting(
    name = "kernel_stock",
    flag_values = {":kernel": "stock"},
)

# Set by --define=dcfs_sanitizer=asan/ubsan (see .bazelrc's build:asan /
# build:ubsan). qemu_cc_test uses these to skip the fully_static_link
# feature under a sanitizer: glibc cannot be fully statically linked with
# ASan (and in practice UBSan's runtime has the same problem), so those
# builds link dynamically and mkinitramfs.sh copies the ldd(1) closure
# into the initramfs instead.
config_setting(
    name = "asan_build",
    values = {"define": "dcfs_sanitizer=asan"},
)

config_setting(
    name = "ubsan_build",
    values = {"define": "dcfs_sanitizer=ubsan"},
)

# Guest initramfs shared by every qemu_test in this package: busybox,
# dcfs (statically linked, see //dcfs:main_static), fhtest, testutil,
# guest/init, every guest/*.sh test script (installed as /tests/<basename>;
# see guest/init and scripts/mkinitramfs.sh), and (step 4.5) the pjdfstest
# binary plus its tests/ tree, installed under /pjdfstest/ (see
# //third_party/pjdfstest:BUILD.pjdfstest and guest/pjdfstest.sh).
genrule(
    name = "initramfs",
    srcs = [
        "//dcfs:main_static",
        "//tools:fhtest",
        "//tools:testutil",
        "@pjdfstest//:pjdfstest",
        "@pjdfstest//:tests",
        "@kernel_image//:busybox",
        "guest/init",
    ] + glob(["guest/*.sh"]) + glob(["guest/pjdfstest.*_failures"]),
    outs = ["initramfs.cpio.gz"],
    cmd = "$(location scripts/mkinitramfs.sh) $@ " +
          "$(location @kernel_image//:busybox) " +
          "$(location //dcfs:main_static) " +
          "$(location //tools:fhtest) " +
          "$(location //tools:testutil) " +
          "$(location guest/init) " +
          "$(SRCS)",
    tools = ["scripts/mkinitramfs.sh"],
)

qemu_test(
    name = "boot_test",
    disks = [("vdb", "ext4", "64M")],
    guest_script = "guest/boot.sh",
)

# Step 2: the cache database (and its -wal/-shm files) is mode 0600, not
# world-readable; a missing cache-database directory is created 0700, and
# an existing group-/world-accessible one gets a WARNING -- see
# guest/cache_permissions.sh.
qemu_test(
    name = "cache_permissions_test",
    disks = [("vdb", "ext4", "64M")],
    guest_script = "guest/cache_permissions.sh",
)

# Step 5.2: readonly_test runs on ext4, xfs and btrfs (qemu_test_matrix
# below generates readonly_test_ext4/_xfs/_btrfs plus a plain
# "readonly_test" alias to the ext4 variant) -- see guest/readonly.sh's own
# fstype branches and README.md's "tested on" line. vdb is 320M (not the
# smaller size pre-5.2 ext4-only test used): mkfs.xfs refuses to format
# anything under 300MB ("Filesystem must be larger than 300MB"), and
# qemu_test_matrix varies vdb's fstype across every generated variant, so
# every matrix test's vdb needs to already clear that floor even for its
# ext4/btrfs variants.
qemu_test_matrix(
    name = "readonly_test",
    disks = [
        ("vdb", "ext4", "320M"),
        ("vdc", "ext4", "64M"),
    ],
    guest_script = "guest/readonly.sh",
)

qemu_test_matrix(
    name = "passthrough_test",
    disks = [("vdb", "ext4", "320M")],
    guest_script = "guest/passthrough.sh",
)

qemu_test(
    name = "lifecycle_test",
    disks = [("vdb", "ext4", "128M")],
    guest_script = "guest/lifecycle.sh",
)

qemu_test_matrix(
    name = "setattr_test",
    disks = [("vdb", "ext4", "320M")],
    guest_script = "guest/setattr.sh",
)

qemu_test_matrix(
    name = "handles_test",
    disks = [
        ("vdb", "ext4", "320M"),
        ("vdc", "ext4", "64M"),
    ],
    guest_script = "guest/handles.sh",
)

qemu_test_matrix(
    name = "create_test",
    disks = [
        ("vdb", "ext4", "320M"),
        ("vdc", "ext4", "64M"),
    ],
    guest_script = "guest/create.sh",
)

qemu_test_matrix(
    name = "rename_test",
    disks = [
        ("vdb", "ext4", "320M"),
        ("vdc", "ext4", "64M"),
    ],
    guest_script = "guest/rename.sh",
