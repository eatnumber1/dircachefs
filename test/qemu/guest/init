#!/bin/sh
# Adapted from fuse-generation-qemu; that repo stays the LKML patch's test
# suite.
#
# PID 1 inside the dcfs QEMU guest, for both kinds of dcfs QEMU test:
#
#   - Unit tests (test/qemu/qemu_cc_test.bzl): the initramfs has /test/run
#     (the test binary), /test/args (its arguments, space-joined), an
#     optional /test/data/ (TEST_SRCDIR) and an optional /test/disk0 (the
#     device name of the first `disks=` entry, if any). Runs the test with
#     TEST_TMPDIR on that disk if given, tmpfs otherwise, then prints
#     DCFS-TEST-EXIT=<rc>.
#
#   - e2e tests (test/qemu/qemu_test.bzl): picks the guest/<name>.sh script
#     to run from the dcfs_test= kernel command-line parameter, then prints
#     ALL-TESTS-PASSED or TEST-FAILED.
#
# All interesting output goes to the serial console; run-qemu.sh greps it
# for the final verdict. reboot=t on the kernel command line (see
# run-qemu.sh) plus -no-reboot makes the final `reboot -f` below a clean
# way to end the VM: the kernel forces a reboot via triple fault, and
# -no-reboot makes QEMU quit instead of actually rebooting. This is used
# instead of poweroff because the microvm machine (acpi=off, see
# run-qemu.sh) gives the guest no platform shutdown mechanism for the
# poweroff syscall to use.

/bin/busybox mkdir -p /proc /sys /dev /tmp /src /cache /mnt
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox mount -t devtmpfs devtmpfs /dev 2>/dev/null
/bin/busybox mount -t tmpfs tmpfs /tmp

/bin/busybox --install -s /bin

# Kernel modules (step 24.2). The kernel is Alpine's linux-virt, whose
# drivers are mostly modules: run-qemu.sh appended an archive holding the
# modules this test declared (test/qemu/qemu_test.bzl `modules`, with their
# dependencies, decompressed) and /etc/dcfs-modules, which lists them in load
# order (test/qemu/scripts/mkmodules.py). A module that fails to load is
# reported; the test then fails by itself where it needs the driver.
# The guest has no modprobe, so a kernel request_module() (mount -t of a
# filesystem not declared, a crypto algorithm, a device-mapper target, the
# unicode tables of a casefolded directory, loop) would fail without a word
# and the test would fail later with ENODEV or EINVAL. The kernel runs the
# helper named by /proc/sys/kernel/modprobe instead: it says which module
# was asked for, on the console and in /tmp/undeclared-modules, and fails.
mkdir -p /sbin
cat >/sbin/dcfs-modprobe <<'EOF_MODPROBE'
#!/bin/sh
# Called by the kernel as: modprobe -q -- MODULE (or MODULE ARGS...).
for last in "$@"; do :; done
msg="init: kernel requested module $last, which this test did not declare (modules = [...] in test/qemu/BUILD.bazel)"
echo "$msg" >/dev/console
echo "$msg" >>/tmp/undeclared-modules
exit 1
EOF_MODPROBE
chmod +x /sbin/dcfs-modprobe
echo /sbin/dcfs-modprobe >/proc/sys/kernel/modprobe

if [ -f /etc/dcfs-modules ]; then
	for module in $(cat /etc/dcfs-modules); do
		insmod "$module" || echo "init: insmod $module failed"
	done
fi

# Populate any device nodes devtmpfs didn't create on its own.
mdev -s

echo "boot: kernel $(uname -r)"

# run-qemu.sh's accelerator (kvm or tcg) as DCFS_ACCEL, for the rare check
# whose wall-clock or CPU-time budget has to scale with emulation speed
# (e.g. guest/write.sh's daemon CPU ticks under TCG).
DCFS_ACCEL=$(sed -n 's/.*\bdcfs_accel=\([^ ]*\).*/\1/p' /proc/cmdline)
export DCFS_ACCEL

# Guest memory sampler (step 6.2): one awk process, started below and killed
# by mem_report, that every 0.1 s reads /proc/meminfo and every process's
# /proc/<pid>/status and keeps the extremes, rewriting them to /dev/memstat
# each time (devtmpfs, so no file system the test uses and nothing the OOM
# killer can take away). mem_report prints them as one `MEM ...` line just
# before the verdict, so every test's serial log says how much of its RAM it
# used, and the `mem=` allowances in test/qemu/*.bzl can be checked against
# it. Fields (KiB except samples):
#   total        MemTotal (the -m size less the kernel's own reservations)
#   min_avail    lowest MemAvailable seen
#   peak_used    highest MemTotal - MemAvailable: what cannot be reclaimed
#   peak_cached/peak_anon/peak_shmem/peak_slab
#                the highest Cached, AnonPages, Shmem (tmpfs: /tmp and the
#                like) and Slab, each on its own (they peak at different times)
#   dcfs_hwm     highest VmHWM of any process named dcfs* (the kernel's own
#                peak, so exact), 0 when none ran
#   top          the process (name:pid) with the highest VmHWM, and that VmHWM
#   samples      how many times the loop ran
# mem_report appends two counters of the kernel's reclaim since the sampler
# started (cumulative, so nothing samples them): reclaim_scans (pages kswapd
# and direct reclaim scanned) and slabs_scanned (objects the slab shrinkers
# scanned; also counted by drop_caches, so a test that drops caches has some).
# Any reclaim_scans means the guest ran short of memory and evicted cached
# inodes and pages, which MemAvailable does not show (it counts them as
# available): run-qemu.sh warns, and lib.sh's require_no_reclaim fails a test
# whose meaning depends on nothing being evicted.
# The processes' status files are read through `cat ... 2>/dev/null` so one
# that exits between the glob and the read cannot abort the loop.
start_mem_sampler() {
	RECLAIM_BASE=$(reclaim_counters)
	export RECLAIM_BASE
	awk -v out=/dev/memstat 'BEGIN {
		minav = -1
		for (;;) {
			while ((getline l < "/proc/meminfo") > 0) {
				split(l, a, " ")
				m[a[1]] = a[2]
			}
			close("/proc/meminfo")
			getline up < "/proc/uptime"
			close("/proc/uptime")
			split(up, u, " ")
			total = m["MemTotal:"]
			avail = m["MemAvailable:"]
			if (minav < 0 || avail < minav) minav = avail
			if (total - avail > pused) pused = total - avail
			if (m["Cached:"] > pcached) pcached = m["Cached:"]
			if (m["AnonPages:"] > panon) panon = m["AnonPages:"]
			if (m["Shmem:"] > pshmem) pshmem = m["Shmem:"]
			if (m["Slab:"] > pslab) pslab = m["Slab:"]
			cmd = "cat /proc/[0-9]*/status 2>/dev/null"
			while ((cmd | getline l) > 0) {
				split(l, f, " ")
				if (f[1] == "Name:") name = f[2]
				else if (f[1] == "Pid:") pid = f[2]
				else if (f[1] == "VmHWM:") {
					if (name ~ /^dcfs/ && f[2] > dcfs) dcfs = f[2]
					if (f[2] > top) { top = f[2]; topname = name ":" pid }
				}
			}
			close(cmd)
			n++
			printf "MEM total=%d min_avail=%d peak_used=%d peak_cached=%d peak_anon=%d peak_shmem=%d peak_slab=%d dcfs_hwm=%d top=%s:%d samples=%d up=%s\n", total, minav, pused, pcached, panon, pshmem, pslab, dcfs, topname, top, n, u[1] > out
			close(out)
			# Not system("sleep 0.1"): in busybox awk system() returns
			# at once without waiting, which made this a busy loop.
			nap = "sleep 0.1"
			nap | getline
			close(nap)
		}
	}' &
	MEM_SAMPLER_PID=$!
}

# reclaim_counters: "<pgscan_kswapd + pgscan_direct> <slabs_scanned>" now.
reclaim_counters() {
	awk '/^pgscan_(kswapd|direct) / { p += $2 } /^slabs_scanned / { s += $2 } END { print p + 0, s + 0 }' /proc/vmstat
}

# Stop the sampler and print its last line (nothing if it never completed a
# sample), then any OOM-killer lines as MEM-OOM: lines and the kernel's oopses
# and warnings as KERNEL-OOPS: lines.
mem_report() {
	# A test that ends within the first sample's time (a unit test of a
	# few milliseconds on a slow-starting sampler) still gets its line:
	# wait for the first sample, for up to two seconds.
	waited=0
	while [ ! -s /dev/memstat ] && [ "$waited" -lt 20 ]; do
		sleep 0.1
		waited=$((waited + 1))
	done
	[ -n "${MEM_SAMPLER_PID:-}" ] && kill "$MEM_SAMPLER_PID" 2>/dev/null
	MEM_SAMPLER_PID=
	if [ -s /dev/memstat ]; then
		echo "$(cat /dev/memstat) $(awk -v now="$(reclaim_counters)" -v base="$RECLAIM_BASE" 'BEGIN {
			split(now, n, " ")
			split(base, b, " ")
			printf "reclaim_scans=%d slabs_scanned=%d", n[1] - b[1], n[2] - b[2]
		}')"
	fi
	# The console runs at loglevel=3, which hides the OOM killer's own lines
	# (they are KERN_ERR): fetch them from the kernel log so a run that lost a
	# process to memory pressure says so in the serial log (run-qemu.sh
	# reports it on a FAIL), instead of failing on some unrelated-looking
	# check.
	dmesg 2>/dev/null | grep -i -E 'out of memory|oom-kill|killed process' |
		head -n 10 | sed 's/^/MEM-OOM: /'
	# The same for the kernel's own failures: the console shows only an oops
	# or a BUG, not a WARNING or the call trace (run-qemu.sh fails a run
	# that has a KERNEL-OOPS: line). Only real kernel warnings match
	# ("WARNING: CPU:", older "WARNING: at ", or the "cut here" marker):
	# the hardware-vulnerability advisories printed at boot on some CPUs
	# (AMD: "SRSO: WARNING: See ...") are not failures.
	dmesg 2>/dev/null | grep -E 'BUG:|Oops|kernel BUG at|WARNING: CPU:|WARNING: at |------------\[ cut here \]------------|Call Trace:|Kernel panic|general protection fault' |
		head -n 20 | sed 's/^/KERNEL-OOPS: /'
}

start_mem_sampler

finish() {
	sync
	# `sync` flushes the block devices, not the serial console: the line
	# just echoed (DCFS-TEST-EXIT=.../ALL-TESTS-PASSED/TEST-FAILED, or even
	# the TEST ...PASS/FAIL line right before it) is still working its way
	# from the tty layer through QEMU's emulated UART to the host-side
	# chardev when reboot -f below forces an immediate triple fault --
	# observed in practice as run-qemu.sh's grep missing the verdict, or a
	# PASS line arriving with a kernel "reboot: Restarting system" message
	# spliced into the middle of it. A short sleep gives that last bit of
	# output time to actually drain before the reboot yanks the console
	# out from under it.
	sleep 0.2
	reboot -f
}

if [ -f /test/run ]; then
	# --- unit-test mode -------------------------------------------------
	mkdir -p /tmp/test_tmpdir

	if [ -s /test/disk0 ]; then
		disk_dev="/dev/$(cat /test/disk0)"
		if ! mount -t ext4 "$disk_dev" /tmp/test_tmpdir; then
			echo "init: failed to mount $disk_dev on /tmp/test_tmpdir"
			echo "DCFS-TEST-EXIT=1"
			finish
			exit 1
		fi
	fi

	export TEST_TMPDIR=/tmp/test_tmpdir
	export TEST_SRCDIR=/test/data
	export HOME=/tmp
	mkdir -p /tmp/test_undeclared_outputs
	export TEST_UNDECLARED_OUTPUTS_DIR=/tmp/test_undeclared_outputs
	# ASan needs ptrace (CAP_SYS_PTRACE / a non-restrictive
	# yama.ptrace_scope) to unwind and symbolize leak reports; the guest
	# has neither configured, so leak detection is disabled rather than
	# have every ASan build fail on an unrelated guest limitation.
	export ASAN_OPTIONS="${ASAN_OPTIONS:-detect_leaks=0}"
	# UBSan (--config=ubsan, fatal at compile time already): the stack of a
	# report, and an exit status that cannot be mistaken for the test's own.
	export UBSAN_OPTIONS="${UBSAN_OPTIONS:-print_stacktrace=1:halt_on_error=1}"

	[ -d /test/data ] && cd /test/data

	# No -e here or below: the test binary reports failures itself via its
	# exit status, and word-splitting $(cat /test/args) is deliberate.
	/test/run $(cat /test/args 2>/dev/null)
	rc=$?
	mem_report
	echo "DCFS-TEST-EXIT=$rc"
	finish
	exit 0
fi

# --- e2e mode -----------------------------------------------------------
TEST=$(sed -n 's/.*\bdcfs_test=\([^ ]*\).*/\1/p' /proc/cmdline)
if [ -z "$TEST" ]; then
	echo "init: no dcfs_test= on the kernel command line"
	echo "TEST-FAILED"
	finish
	exit 1
fi

SCRIPT="/tests/$TEST"
if [ ! -f "$SCRIPT" ]; then
	echo "init: $SCRIPT not found"
	echo "TEST-FAILED"
	finish
	exit 1
fi

# Same as the unit-test branch above: under --config=asan/--config=ubsan,
# //dcfs:main_static (started by guest/<name>.sh's start_daemon) is the
# ASan/UBSan build too (see dcfs/BUILD.bazel's main_static select()), and
# needs the same leak-detection workaround for the same reason (no ptrace
# in this guest).
export ASAN_OPTIONS="${ASAN_OPTIONS:-detect_leaks=0}"
export UBSAN_OPTIONS="${UBSAN_OPTIONS:-print_stacktrace=1:halt_on_error=1}"

# qemu_test's optional rootfs= attribute (test/qemu/qemu_test.bzl) attaches
# a Debian rootfs image (test/qemu/scripts/mkrootfs-debian.sh) as an extra
# virtio-blk disk and names it here. When present, run guest_script chrooted
# into that Debian tree instead of directly from the initramfs, so it has
# GNU userspace and nfs-utils (rpc.nfsd/rpc.mountd/exportfs/mount.nfs4)
# available -- none of which fit in the busybox-only initramfs. Networking
# (loopback) is brought up in the initramfs's own network namespace before
# the chroot, since it's process/namespace, not filesystem, state, and
# chroot(2) doesn't touch it.
ROOTFS=$(sed -n 's/.*\bdcfs_rootfs=\([^ ]*\).*/\1/p' /proc/cmdline)
if [ -n "$ROOTFS" ]; then
	mkdir -p /newroot
	if ! mount -t ext4 "$ROOTFS" /newroot; then
		echo "init: failed to mount $ROOTFS on /newroot"
		echo "TEST-FAILED"
		finish
		exit 1
	fi
	mkdir -p /newroot/proc /newroot/sys /newroot/dev /newroot/tests
	mount -o bind /proc /newroot/proc
	mount -o bind /sys /newroot/sys
	mount -o bind /dev /newroot/dev
	cp /bin/dcfs /bin/fhtest /bin/testutil /newroot/usr/local/bin/
	cp -a /tests/. /newroot/tests/

	# Under --config=asan/--config=ubsan, dcfs/fhtest/testutil above are
	# dynamically linked (see dcfs/BUILD.bazel's main_static select()),
	# and need their shared-library closure -- already copied into this
	# initramfs's own /lib, /lib64 by mkinitramfs.sh's copy_deps() -- to
	# run inside the chroot too. Two things that don't work, tried in
	# this order, before landing on "run each binary through its own
	# copied loader explicitly" below:
	#
	#   - Do nothing (just the plain binary copy above): the Debian
	#     rootfs predates this build toolchain's glibc, so the dynamic
	#     linker can't find what dcfs needs in the rootfs's own libc:
	#       /usr/local/bin/dcfs: /lib/x86_64-linux-gnu/libc.so.6: version
	#       `GLIBC_2.38' not found (required by /usr/local/bin/dcfs)
	#   - Overwrite the rootfs's /lib, /lib64 with this build's copies
	#     (relying on glibc's backward-compatibility guarantee -- a
	#     newer glibc runs binaries built against an older one, the same
	#     guarantee an in-place distro glibc upgrade depends on): this
	#     breaks every *other* dynamically linked binary in the chroot
	#     instead (/bin/sh itself, here), because the loader
	#     (ld-linux-x86-64.so.2) and the libc.so.6 it loads share
	#     GLIBC_PRIVATE-tagged symbols that carry no compatibility
	#     guarantee at all, even across minor versions:
	#       /bin/sh: symbol lookup error: /lib/x86_64-linux-gnu/libc.so.6:
	#       undefined symbol: __tunable_is_initialized, version
	#       GLIBC_PRIVATE
	#
	# Fix: leave the rootfs's own /lib, /lib64 (and so every other
	# binary in it) completely untouched, and instead give
	# dcfs/fhtest/testutil their own isolated copy of their loader and
	# library closure under /opt/dcfs-libs, invoked explicitly (`ld.so
	# --library-path`) instead of through the normal, rootfs-wide
	# dynamic-linking resolution a bare exec would use. A no-op for a
	# normal (non-sanitizer) build: mkinitramfs.sh creates no /lib or
	# /lib64 at all when every binary is fully static, so $interp stays
	# empty and this block never runs.
	interp=$(find /lib64 /lib -name 'ld-linux*.so*' 2>/dev/null | head -1)
	if [ -n "$interp" ]; then
		mkdir -p /newroot/opt/dcfs-libs
		for f in $(find /lib /lib64 -type f 2>/dev/null); do
			cp "$f" "/newroot/opt/dcfs-libs/$(basename "$f")"
		done
		loader="/opt/dcfs-libs/$(basename "$interp")"
		for bin in dcfs fhtest testutil; do
			mv "/newroot/usr/local/bin/$bin" \
				"/newroot/usr/local/bin/$bin.real"
			cat >"/newroot/usr/local/bin/$bin" <<EOF
#!/bin/sh
exec $loader --library-path /opt/dcfs-libs /usr/local/bin/$bin.real "\$@"
EOF
			chmod +x "/newroot/usr/local/bin/$bin"
		done
	fi

	ip link set lo up

	chroot /newroot /bin/sh "/tests/$TEST"
	rc=$?
else
	# No -e: the test scripts report every check with their own PASS/FAIL
	# lines and exit status; -e would abort them silently on the first
	# nonzero command (e.g. a $(...) capture of a tool that exits 1 after
	# printing usage).
	sh "$SCRIPT"
	rc=$?
fi

mem_report
if [ "$rc" -eq 0 ]; then
	echo "ALL-TESTS-PASSED"
else
	echo "TEST-FAILED"
fi
finish
