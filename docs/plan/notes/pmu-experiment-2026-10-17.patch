/* ---- EXPERIMENT (step 26.36, not to be committed as is): PMU ---- */
/* testutil pmu-hold <cgroup>: counts instructions (user, kernel) and cycles
 * of every task in the cgroup, all CPUs, until SIGUSR1; prints one line. */
static int cmd_pmu_hold(const char *cgroup) {
  int ncpu = (int)sysconf(_SC_NPROCESSORS_ONLN);
  int cg = open(cgroup, O_RDONLY | O_DIRECTORY);
  int fds[3][64], k, c;
  uint64_t tot[3] = {0, 0, 0};

  if (cg == -1) {
    print_err(errno);
    return 1;
  }
  for (c = 0; c < ncpu; c++) {
    fds[0][c] = perf_open(PERF_TYPE_HARDWARE, PERF_COUNT_HW_INSTRUCTIONS, 1, 0,
                          cg, c, PERF_FLAG_PID_CGROUP);
    fds[1][c] = perf_open(PERF_TYPE_HARDWARE, PERF_COUNT_HW_INSTRUCTIONS, 0, 1,
                          cg, c, PERF_FLAG_PID_CGROUP);
    fds[2][c] = perf_open(PERF_TYPE_HARDWARE, PERF_COUNT_HW_CPU_CYCLES, 1, 1,
                          cg, c, PERF_FLAG_PID_CGROUP);
    for (k = 0; k < 3; k++)
      if (fds[k][c] == -1) {
        printf("PMU-ERR open %d cpu %d: %s\n", k, c, strerror(errno));
        return 1;
      }
  }
  {
    sigset_t set;
    int sig;

    sigemptyset(&set);
    sigaddset(&set, SIGUSR1);
    sigprocmask(SIG_BLOCK, &set, NULL);
    printf("PMU-READY\n");
    fflush(stdout);
    sigwait(&set, &sig);
  }
  for (c = 0; c < ncpu; c++)
    for (k = 0; k < 3; k++) {
      uint64_t v = 0;

      if (read(fds[k][c], &v, sizeof(v)) == sizeof(v)) tot[k] += v;
    }
  printf("PMU instr_user=%llu instr_kernel=%llu cycles=%llu\n",
         (unsigned long long)tot[0], (unsigned long long)tot[1],
         (unsigned long long)tot[2]);
  return 0;
}


